module(name = "transformer")

bazel_dep(name = "rules_java", version = "8.14.0")
bazel_dep(name = "rules_jvm_external", version = "6.6")
bazel_dep(name = "rules_scala", version = "7.0.0")

maven = use_extension("@rules_jvm_external//:extensions.bzl", "maven")
maven.install(
    artifacts = [
        # SQL parser. 5.2 reads four parentheses deep inside a call,
        # `COALESCE((((a > 1))), FALSE)`, which 5.0 could not parse; 5.3
        # refuses seventeen nested parentheses, which 5.2 reads at any depth.
        "com.github.jsqlparser:jsqlparser:5.2",

        # Parquet (local FS only; Hadoop libs are minimal, no daemons)
        "org.apache.parquet:parquet-hadoop:1.14.3",
        "org.apache.parquet:parquet-column:1.14.3",
        "org.apache.parquet:parquet-common:1.14.3",
        "org.apache.parquet:parquet-encoding:1.14.3",
        "org.apache.parquet:parquet-format-structures:1.14.3",
        # 3.4.3 swaps `Subject.getSubject(AccessControlContext)` for
        # `SubjectUtil.current()` in UserGroupInformation. The old call throws
        # UnsupportedOperationException once JEP 486 (Security Manager
        # permanently disabled) lands — default in JDK 24+, so jaffle-shop
        # blows up on JDK 25 on any earlier Hadoop. 3.4.0/.1/.2 still call
        # the broken API.
        "org.apache.hadoop:hadoop-common:3.4.3",
        "org.apache.hadoop:hadoop-mapreduce-client-core:3.4.3",
        "commons-collections:commons-collections:3.2.2",
        "org.slf4j:slf4j-api:2.0.13",
        "org.slf4j:slf4j-nop:2.0.13",

        # JavaFX — used only by the //src/main/scala/com/transformer/gui module
        # and the //examples/gui_app launcher. Other modules don't pull this in.
        "org.openjfx:javafx-base:21.0.1",
        "org.openjfx:javafx-controls:21.0.1",
        "org.openjfx:javafx-graphics:21.0.1",
        # Platform-specific native libraries.
        "org.openjfx:javafx-base:jar:mac-aarch64:21.0.1",
        "org.openjfx:javafx-controls:jar:mac-aarch64:21.0.1",
        "org.openjfx:javafx-graphics:jar:mac-aarch64:21.0.1",
        "org.openjfx:javafx-base:jar:win:21.0.1",
        "org.openjfx:javafx-controls:jar:win:21.0.1",
        "org.openjfx:javafx-graphics:jar:win:21.0.1",
        # The GUI's SQL editor: a styled, virtualized text area (syntax
        # highlighting, line numbers) that the GUI's vim mode drives. Pure
        # Java; it expects the JavaFX above on the classpath.
        "org.fxmisc.richtext:richtextfx:0.11.7",
        # The GUI's theme for every standard control, dialogs and popups
        # included. 2.0.1 is the last release built for JavaFX 21 and Java 21:
        # 2.1.0 declares javafx-controls 23, which would lift the JavaFX pinned
        # above, and 3.0.0 is Java 25 bytecode.
        "io.github.mkpaz:atlantafx-base:2.0.1",

        # The `transformer query` shell: line editing, history and Ctrl-C on a
        # terminal. The bundle jar holds the reader and every terminal
        # provider, and its dependencies are all optional.
        "org.jline:jline:4.4.8",

        # Testing
        "junit:junit:4.13.2",

        # JMH — microbenchmarks under //benchmarks/micro. Pattern B
        # (programmatic Runner) so we don't need the annotation-processor
        # generator on the build path; jmh-core's runtime API still wants
        # its bytecode classes available, which jmh-generator-bytecode
        # supplies. Both artifacts are scoped to //benchmarks/micro:* —
        # production targets and examples never depend on them, asserted
        # by `bazel query "kind('java_library', deps(//examples/...))" |
        # grep jmh` returning empty in the Sub-plan 3 verification gate.
        "org.openjdk.jmh:jmh-core:1.37",
        "org.openjdk.jmh:jmh-generator-bytecode:1.37",
    ],
    repositories = [
        "https://repo1.maven.org/maven2",
    ],
    fetch_sources = False,
    duplicate_version_warning = "none",
)
use_repo(maven, "maven")

# Scala toolchain configuration
scala_config = use_extension(
    "@rules_scala//scala/extensions:config.bzl",
    "scala_config",
)
scala_config.settings(scala_version = "2.13.16")

scala_deps = use_extension(
    "@rules_scala//scala/extensions:deps.bzl",
    "scala_deps",
)
scala_deps.scala()
scala_deps.junit()

# The Scala toolchain is the root BUILD.bazel's: rules_scala's Scala jars,
# from its rules_scala_toolchains repository, with the compiler's warnings as
# errors. A root module's toolchains are tried before those rules_scala
# registers.
use_repo(scala_deps, "rules_scala_toolchains")

register_toolchains("//:scala_toolchain")
