# Window frames. ROWS counts rows; RANGE measures the ORDER BY value and
# takes peers (plans/robustness/20): the default frame with an ORDER BY is
# RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW, so tied rows share it.

statement ok
CREATE TABLE w (id INT, g STRING, k INT, v INT)

statement ok
INSERT INTO w VALUES (1, 'a', 1, 10), (2, 'a', 1, 20), (3, 'a', 2, 30), (4, 'a', 4, 40), (5, 'b', 1, 5), (6, 'b', 3, NULL)

# Tied k share the default frame: ids 1 and 2 both see 10 + 20.
query INT,BIGINT nosort
SELECT id, SUM(v) OVER (PARTITION BY g ORDER BY k) FROM w ORDER BY id
----
1	30
2	30
3	60
4	100
5	5
6	5

query INT,BIGINT nosort
SELECT id, SUM(v) OVER (PARTITION BY g ORDER BY k, id ROWS BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) FROM w ORDER BY id
----
1	10
2	30
3	60
4	100
5	5
6	5

# RANGE 1 PRECEDING takes every row whose k is within 1 below the current k.
query INT,BIGINT nosort
SELECT id, SUM(v) OVER (PARTITION BY g ORDER BY k RANGE BETWEEN 1 PRECEDING AND CURRENT ROW) FROM w ORDER BY id
----
1	30
2	30
3	60
4	40
5	5
6	NULL

query INT,BIGINT nosort
SELECT id, SUM(v) OVER (PARTITION BY g ORDER BY k, id ROWS BETWEEN 1 PRECEDING AND 1 FOLLOWING) FROM w ORDER BY id
----
1	30
2	60
3	90
4	70
5	5
6	5

query INT,BIGINT,BIGINT,BIGINT nosort
SELECT id, ROW_NUMBER() OVER (PARTITION BY g ORDER BY k, id), RANK() OVER (PARTITION BY g ORDER BY k), DENSE_RANK() OVER (PARTITION BY g ORDER BY k) FROM w ORDER BY id
----
1	1	1	1
2	2	1	1
3	3	3	2
4	4	4	3
5	1	1	1
6	2	2	2

query INT,INT,INT nosort
SELECT id, LAG(v) OVER (PARTITION BY g ORDER BY id), LEAD(v, 1, 0) OVER (PARTITION BY g ORDER BY id) FROM w ORDER BY id
----
1	NULL	20
2	10	30
3	20	40
4	30	0
5	NULL	NULL
6	5	0

# A frame that selects nothing by construction is refused.
statement error
SELECT SUM(v) OVER (ORDER BY k ROWS BETWEEN 1 FOLLOWING AND 1 PRECEDING) FROM w
----

# A whole-partition aggregate.
query INT,BIGINT,BIGINT nosort
SELECT id, COUNT(*) OVER (PARTITION BY g), COUNT(v) OVER (PARTITION BY g) FROM w ORDER BY id
----
1	4	4
2	4	4
3	4	4
4	4	4
5	2	1
6	2	1
