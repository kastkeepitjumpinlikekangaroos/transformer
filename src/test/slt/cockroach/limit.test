onlyif cockroachdb # needs OFFSET must be a non-negative integer literal
query I
SELECT a FROM probe ORDER BY a LIMIT (SELECT v FROM vals WHERE k = 'zero') OFFSET (SELECT v FROM vals WHERE k = 'one');
----

onlyif cockroachdb # needs OFFSET must be a non-negative integer literal
query I
