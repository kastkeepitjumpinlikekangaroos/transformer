# From CockroachDB's logic tests (https://github.com/cockroachdb/cockroach):
# pkg/sql/logictest/testdata/logic_test/typing at tag v23.2.0, commit
# 8f14432835d667982828b5319cfd130991fbf80c, as it is there but for this header
# and the condition lines added before records. CockroachDB 23.2's files were
# under the Business Source License 1.1, whose Change Date, 2026-10-01, put
# them under the Apache License 2.0: its text is LICENSE beside this file, and
# NOTICE says whose they are.
# transformer: an unconstrained DECIMAL is DECIMAL(38,10)
#
# 68 records: 25 run as CockroachDB answers them; 8 skipped by a rule of the
# ledger in docs/gotchas.md (division-keeps-type 3, refused-subquery 3,
# branch-double 1, no-interval 1), each skip whose rule is no refusal followed
# by its twin, the engine's own answer (5); 35 held for CockroachDB, `onlyif
# cockroachdb # needs ...`, by what they need: a clause or construct the engine
# refuses 11, a type the engine has not 10, a function the engine has not 4, a
# value or type the dialect reads otherwise 3, what a held statement makes 3,
# an error the runner does not raise 2, a statement the runner does not carry
# out 1, syntax the parser does not read 1.

statement ok
CREATE TABLE f (x FLOAT)

statement ok
INSERT INTO f(x) VALUES (3/2), (1)

skipif transformer division-keeps-type
query R rowsort
SELECT * FROM f
----
1.5
1

onlyif transformer division-keeps-type
query F rowsort
SELECT * FROM f
----
1
1

statement ok
CREATE TABLE i (x INT)

onlyif cockroachdb # needs a CAST to TIMESTAMPTZ
statement error value type timestamptz doesn't match type int of column "x"
INSERT INTO i(x) VALUES ('1970-01-01'::timestamptz)

statement ok
INSERT INTO i(x) VALUES (2.0)

onlyif cockroachdb # needs a BIGINT value 9223372036854775809 cannot be stored in a BIGINT column
statement error numeric constant out of int64 range
INSERT INTO i(x) VALUES (9223372036854775809)

query I rowsort
SELECT * FROM i
----
2

statement ok
CREATE TABLE d (x DECIMAL)

statement ok
INSERT INTO d(x) VALUES (((9 / 3) * (1 / 3))), (2.0), (2.4 + 4.6)

skipif transformer division-keeps-type
query R rowsort
SELECT * FROM d
----
0.999999999999999999990000000000000000000
2.0
7.0

onlyif transformer division-keeps-type
query R rowsort
SELECT * FROM d
----
0.0000000000
2.0000000000
7.0000000000

onlyif cockroachdb # needs Arithmetic on DECIMAL(38,10) and DOUBLE
statement ok
UPDATE d SET x = x + 1 WHERE x + sqrt(x) >= 2 + .1

skipif transformer division-keeps-type
query R rowsort
SELECT * FROM d
----
0.999999999999999999990000000000000000000
3.0
8.0

onlyif transformer division-keeps-type
query R rowsort
SELECT * FROM d
----
0.0000000000
2.0000000000
7.0000000000

statement ok
CREATE TABLE s (x STRING)

onlyif cockroachdb # needs B'...'
query T
SELECT * FROM s WHERE x > b'\x00'
----

onlyif cockroachdb # needs B'...'
statement ok
INSERT INTO s(x) VALUES (b'qwe'), ('start' || b'end')

onlyif cockroachdb # needs B'...'
statement ok
INSERT INTO s(x) VALUES (b'\xfffefd')

onlyif cockroachdb # needs a CAST to BYTES
query IT rowsort
SELECT length(x), encode(x::bytes, 'escape') from s
----
3 qwe
8 startend
5 \377fefd

statement error incompatible COALESCE expressions: could not parse "foo" as type int
INSERT INTO s VALUES (COALESCE(1, 'foo'))

statement error incompatible COALESCE expressions: could not parse "foo" as type int
INSERT INTO i VALUES (COALESCE(1, 'foo'))

query error incompatible COALESCE expressions: could not parse "foo" as type int
SELECT COALESCE(1, 'foo')

query error incompatible COALESCE expressions: could not parse "foo" as type int
SELECT COALESCE(1::INT, 'foo')

skipif transformer branch-double
query error expected 2.3 to be of type int, found type decimal
SELECT greatest(-1, 1, 2.3, 123456789, 3 + 5, -(-4))

onlyif transformer branch-double
query F
SELECT greatest(-1, 1, 2.3, 123456789, 3 + 5, -(-4))
----
123456789

query I
SELECT greatest(-1, 1, 2, 123456789, 3 + 5, -(-4))
----
123456789

query T
SELECT greatest('2010-09-29', '2010-09-28'::TIMESTAMP)
----
2010-09-29 00:00:00 +0000 +0000

onlyif cockroachdb # needs a CAST to INTERVAL
query T
SELECT greatest('PT12H2M', 'PT12H2M'::INTERVAL, '1s')
----
12:02:00

query R
SELECT greatest(-1.123, 1.21313, 2.3, 123456789.321, 3 + 5.3213, -(-4.3213), abs(-9))
----
123456789.321

statement ok
CREATE TABLE untyped (b bool, n INT, f FLOAT, e DECIMAL, d DATE, ts TIMESTAMP, tz TIMESTAMPTZ, i INTERVAL)

onlyif cockroachdb # needs a STRING value f cannot be stored in a BOOLEAN column
statement ok
INSERT INTO untyped VALUES ('f', '42', '4.2', '4.20', '2010-09-28', '2010-09-28 12:00:00.1', '2010-09-29 12:00:00.1', 'PT12H2M')

skipif transformer no-interval
query BIRRTTTT
SELECT * FROM untyped
----
false  42  4.2  4.20  2010-09-28 00:00:00 +0000 +0000  2010-09-28 12:00:00.1 +0000 +0000  2010-09-29 12:00:00.1 +0000 UTC  12:02:00

onlyif transformer no-interval
query BIFRTT
SELECT * FROM untyped
----

# Issue #14527: support string literal coercion during overload resolution
onlyif cockroachdb # needs the rows of untyped, which a held statement writes
query T
SELECT ts FROM untyped WHERE ts != '2015-09-18 00:00:00'
----
2010-09-28 12:00:00.1 +0000 +0000

# Regression tests for #15050

onlyif cockroachdb # needs the error the runner does not raise: pq: parsing as type timestamp: could not parse "Not Timestamp"
statement error pq: parsing as type timestamp: could not parse "Not Timestamp"
CREATE TABLE t15050a (c DECIMAL DEFAULT CASE WHEN now() < 'Not Timestamp' THEN 2 ELSE 2 END);

onlyif cockroachdb # needs the error the runner does not raise: pq: parsing as type timestamp: could not parse "Not Timestamp"
statement error pq: parsing as type timestamp: could not parse "Not Timestamp"
CREATE TABLE t15050b (c DECIMAL DEFAULT IF(now() < 'Not Timestamp', 2, 2));

# Regression tests for #15632

onlyif cockroachdb # needs IFNULL()
statement error incompatible IFNULL expressions: could not parse "foo" as type bool
SELECT IFNULL('foo', false)

onlyif cockroachdb # needs IFNULL()
statement error incompatible IFNULL expressions: could not parse "foo" as type bool
SELECT IFNULL(true, 'foo')

onlyif cockroachdb # needs IFNULL()
query B
SELECT IFNULL(false, 'true')
----
false

