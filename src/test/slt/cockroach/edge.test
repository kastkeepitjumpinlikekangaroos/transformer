----
-1  -1  -1  0  0  -0.50000000000000000000  -0.50000000000000000000  -0.50000000000000000000  0  0

onlyif cockroachdb # needs sum_int()
query III
SELECT
    sum_int(t._int2), sum_int(t._int4), sum_int(t._int8)
