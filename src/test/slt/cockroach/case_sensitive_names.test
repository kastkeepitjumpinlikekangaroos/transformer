onlyif cockroachdb # needs the table B, which a held statement makes
statement ok
INSERT INTO "B"(x) VALUES(1)

onlyif cockroachdb # needs the table B, which a held statement makes
statement ok
UPDATE "B" SET x = 42

onlyif cockroachdb # needs the table B, which a held statement makes
statement ok
