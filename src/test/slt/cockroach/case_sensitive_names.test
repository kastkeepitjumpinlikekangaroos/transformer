# Case sensitivity of column names.

statement ok
CREATE TABLE foo(X INT, "Y" INT)

onlyif cockroachdb # held: finding C6, an unquoted name names its column as written, where CockroachDB folds it to lower case
query III colnames
SELECT x, X, "Y" FROM foo
----
x x Y

skipif transformer names-ignore-case
statement error column "X" does not exist
SELECT "X" FROM foo

onlyif transformer names-ignore-case
query I
SELECT "X" FROM foo
----

skipif transformer names-ignore-case
statement error column "y" does not exist
SELECT Y FROM foo

onlyif transformer names-ignore-case
query I
SELECT Y FROM foo
----

# The following should not be ambiguous.
skipif transformer refused-subquery
query II colnames
SELECT Y, "Y" FROM (SELECT x as y, "Y" FROM foo)
----
y Y

# Case sensitivity of view names.

statement ok
CREATE VIEW XV AS SELECT X, "Y" FROM foo

onlyif cockroachdb # needs a statement other than a query
query TT
SHOW CREATE VIEW xv
----
xv  CREATE VIEW public.xv (
      x,
      "Y"
    ) AS SELECT x, "Y" FROM test.public.foo

onlyif cockroachdb # needs SHOW statement
query error pgcode 42P01 relation "XV" does not exist
SHOW CREATE VIEW "XV"

statement ok
CREATE VIEW "YV" AS SELECT X, "Y" FROM foo

onlyif cockroachdb # needs a statement other than a query
query TT
SHOW CREATE VIEW "YV"
----
"YV"  CREATE VIEW public."YV" (
        x,
        "Y"
      ) AS SELECT x, "Y" FROM test.public.foo

onlyif cockroachdb # needs SHOW statement
query error pgcode 42P01 relation "yv" does not exist
SHOW CREATE VIEW YV

# Case sensitivity of index names.

onlyif cockroachdb # needs the table a, which a held statement drops
statement ok
CREATE TABLE a(x INT, y INT, CONSTRAINT Foo PRIMARY KEY(x)); CREATE INDEX I ON a(y)

onlyif cockroachdb # needs A database link (t@link)
statement error index "I" not found
SELECT * FROM a@"I"

onlyif cockroachdb # needs A database link (t@link)
statement error index "Foo" not found
SELECT * FROM a@"Foo"

onlyif cockroachdb # needs syntax the parser does not read, at "a@"
statement error index "I" not found
SELECT * FROM a ORDER BY INDEX a@"I"

onlyif cockroachdb # needs syntax the parser does not read, at "a@"
statement error index "Foo" not found
SELECT * FROM a ORDER BY INDEX a@"Foo"

onlyif cockroachdb # needs DROP a @ "I"
statement error index "I" does not exist
DROP INDEX a@"I"

onlyif cockroachdb # needs A database link (t@link)
statement ok
SELECT * FROM a@I

onlyif cockroachdb # needs A database link (t@link)
statement ok
SELECT * FROM a@Foo

onlyif cockroachdb # needs syntax the parser does not read, at "a@I"
statement ok
SELECT * FROM a ORDER BY INDEX a@I

onlyif cockroachdb # needs syntax the parser does not read, at "a@Foo"
statement ok
SELECT * FROM a ORDER BY INDEX a@Foo

onlyif cockroachdb # needs DROP a @ I
statement ok
DROP INDEX a@I

# Unicode sequences are preserved.

# Check that normalization occurs
onlyif cockroachdb # needs the error the runner does not raise: duplicate column name: "Amélie"
statement error duplicate column name: "Amélie"
CREATE TABLE Amelie("Amélie" INT, "Amélie" INT); INSERT INTO Amelie VALUES (1, 2)

# Check that function names are also recognized case-insensitively.
query I
SELECT LENGTH('abc') -- lint: uppercase function OK
----
3
