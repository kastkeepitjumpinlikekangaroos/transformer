# Golden plans for the eleven TPC-H queries tpch/tpch.test runs, over the
# tables as its dialect makes them (TPC-H's DECIMAL(15,2) for money and
# quantities), with no rows: a plan depends on the query and the schema alone.
# Each pins the order JoinOrder joins the tables in (plans/testing/05), by their
# equalities: Q5's six tables and Q10's four the largest. The queries are
# TPC-H's, from the TPC Benchmark H specification of the Transaction
# Processing Performance Council, as RisingWave's Apache-2.0 files hold them
# (tpch/LICENSE), with tpch/tpch.test's rewrites, `like` among them written
# `LIKE`.

statement ok
CREATE TABLE supplier (s_suppkey INT, s_name STRING, s_address STRING, s_nationkey INT, s_phone STRING,
  s_acctbal DECIMAL(15,2), s_comment STRING)

statement ok
CREATE TABLE part (p_partkey INT, p_name STRING, p_mfgr STRING, p_brand STRING, p_type STRING, p_size INT,
  p_container STRING, p_retailprice DECIMAL(15,2), p_comment STRING)

statement ok
CREATE TABLE partsupp (ps_partkey INT, ps_suppkey INT, ps_availqty INT, ps_supplycost DECIMAL(15,2),
  ps_comment STRING)

statement ok
CREATE TABLE customer (c_custkey INT, c_name STRING, c_address STRING, c_nationkey INT, c_phone STRING,
  c_acctbal DECIMAL(15,2), c_mktsegment STRING, c_comment STRING)

statement ok
CREATE TABLE orders (o_orderkey BIGINT, o_custkey INT, o_orderstatus STRING, o_totalprice DECIMAL(15,2),
  o_orderdate DATE, o_orderpriority STRING, o_clerk STRING, o_shippriority INT, o_comment STRING)

statement ok
CREATE TABLE lineitem (l_orderkey BIGINT, l_partkey INT, l_suppkey INT, l_linenumber INT, l_quantity DECIMAL(15,2),
  l_extendedprice DECIMAL(15,2), l_discount DECIMAL(15,2), l_tax DECIMAL(15,2), l_returnflag STRING,
  l_linestatus STRING, l_shipdate DATE, l_commitdate DATE, l_receiptdate DATE, l_shipinstruct STRING,
  l_shipmode STRING, l_comment STRING)

statement ok
CREATE TABLE nation (n_nationkey INT, n_name STRING, n_regionkey INT, n_comment STRING)

statement ok
CREATE TABLE region (r_regionkey INT, r_name STRING, r_comment STRING)

# Q1
query T nosort
EXPLAIN select
  l_returnflag,
  l_linestatus,
  sum(l_quantity) as sum_qty,
  sum(l_extendedprice) as sum_base_price,
  sum(l_extendedprice * (1 - l_discount)) as sum_disc_price,
  sum(l_extendedprice * (1 - l_discount) * (1 + l_tax)) as sum_charge,
  round(avg(l_quantity), 4) as avg_qty,
  round(avg(l_extendedprice), 4) as avg_price,
  round(avg(l_discount), 4) as avg_disc,
  count(*) as count_order
from
  lineitem
where
  l_shipdate <= date '1998-09-21'
group by
  l_returnflag,
  l_linestatus
order by
  l_returnflag,
  l_linestatus;
----
== Optimized Logical Plan ==
Sort: l_returnflag, l_linestatus
  Project: l_returnflag, l_linestatus, _agg0 AS sum_qty, _agg1 AS sum_base_price, _agg2 AS sum_disc_price, _agg3 AS sum_charge, ROUND(_agg4, 4) AS avg_qty, ROUND(_agg5, 4) AS avg_price, ROUND(_agg6, 4) AS avg_disc, _agg7 AS count_order
    Aggregate: GROUP BY lineitem.l_returnflag, lineitem.l_linestatus; SUM(lineitem.l_quantity) AS _agg0, SUM(lineitem.l_extendedprice) AS _agg1, SUM(lineitem.l_extendedprice * (1 - lineitem.l_discount)) AS _agg2, SUM(lineitem.l_extendedprice * (1 - lineitem.l_discount) * (1 + lineitem.l_tax)) AS _agg3, AVG(lineitem.l_quantity) AS _agg4, AVG(lineitem.l_extendedprice) AS _agg5, AVG(lineitem.l_discount) AS _agg6, COUNT(*) AS _agg7
      Filter: lineitem.l_shipdate <= DATE '1998-09-21'
        Scan lineitem: l_orderkey, l_partkey, l_suppkey, l_linenumber, l_quantity, l_extendedprice, l_discount, l_tax, l_returnflag, l_linestatus, l_shipdate, l_commitdate, l_receiptdate, l_shipinstruct, l_shipmode, l_comment
== Optimized SQL ==
SELECT lineitem.l_returnflag AS l_returnflag, lineitem.l_linestatus AS l_linestatus, SUM(lineitem.l_quantity) AS sum_qty, SUM(lineitem.l_extendedprice) AS sum_base_price, SUM(lineitem.l_extendedprice * (1 - lineitem.l_discount)) AS sum_disc_price, SUM(lineitem.l_extendedprice * (1 - lineitem.l_discount) * (1 + lineitem.l_tax)) AS sum_charge, ROUND(AVG(lineitem.l_quantity), 4) AS avg_qty, ROUND(AVG(lineitem.l_extendedprice), 4) AS avg_price, ROUND(AVG(lineitem.l_discount), 4) AS avg_disc, COUNT(*) AS count_order
FROM lineitem
WHERE lineitem.l_shipdate <= DATE '1998-09-21'
GROUP BY lineitem.l_returnflag, lineitem.l_linestatus
ORDER BY 1, 2

# Q3
query T nosort
EXPLAIN select
	l_orderkey,
	sum(l_extendedprice * (1 - l_discount)) as revenue,
	o_orderdate,
	o_shippriority
from
	customer,
	orders,
	lineitem
where
	c_mktsegment = 'FURNITURE'
	and c_custkey = o_custkey
	and l_orderkey = o_orderkey
	and o_orderdate < date '1995-03-29'
	and l_shipdate > date '1995-03-29'
group by
	l_orderkey,
	o_orderdate,
	o_shippriority
order by
	revenue desc,
	o_orderdate
LIMIT 10;
----
== Optimized Logical Plan ==
Limit: 10
  Sort: revenue DESC, o_orderdate
    Project: l_orderkey, _agg0 AS revenue, o_orderdate, o_shippriority
      Aggregate: GROUP BY lineitem.l_orderkey, orders.o_orderdate, orders.o_shippriority; SUM(lineitem.l_extendedprice * (1 - lineitem.l_discount)) AS _agg0
        Join INNER: lineitem.l_orderkey = orders.o_orderkey
          Join INNER: customer.c_custkey = orders.o_custkey
            Filter: customer.c_mktsegment = 'FURNITURE'
              Scan customer: c_custkey, c_name, c_address, c_nationkey, c_phone, c_acctbal, c_mktsegment, c_comment
            Filter: orders.o_orderdate < DATE '1995-03-29'
              Scan orders: o_orderkey, o_custkey, o_orderstatus, o_totalprice, o_orderdate, o_orderpriority, o_clerk, o_shippriority, o_comment
          Filter: lineitem.l_shipdate > DATE '1995-03-29'
            Scan lineitem: l_orderkey, l_partkey, l_suppkey, l_linenumber, l_quantity, l_extendedprice, l_discount, l_tax, l_returnflag, l_linestatus, l_shipdate, l_commitdate, l_receiptdate, l_shipinstruct, l_shipmode, l_comment
== Optimized SQL ==
WITH q1 AS (
  SELECT customer.c_custkey AS c_custkey, customer.c_name AS c_name, customer.c_address AS c_address, customer.c_nationkey AS c_nationkey, customer.c_phone AS c_phone, customer.c_acctbal AS c_acctbal, customer.c_mktsegment AS c_mktsegment, customer.c_comment AS c_comment
  FROM customer
  WHERE customer.c_mktsegment = 'FURNITURE'
), q2 AS (
  SELECT orders.o_orderkey AS o_orderkey, orders.o_custkey AS o_custkey, orders.o_orderstatus AS o_orderstatus, orders.o_totalprice AS o_totalprice, orders.o_orderdate AS o_orderdate, orders.o_orderpriority AS o_orderpriority, orders.o_clerk AS o_clerk, orders.o_shippriority AS o_shippriority, orders.o_comment AS o_comment
  FROM orders
  WHERE orders.o_orderdate < DATE '1995-03-29'
), q3 AS (
  SELECT lineitem.l_orderkey AS l_orderkey, lineitem.l_partkey AS l_partkey, lineitem.l_suppkey AS l_suppkey, lineitem.l_linenumber AS l_linenumber, lineitem.l_quantity AS l_quantity, lineitem.l_extendedprice AS l_extendedprice, lineitem.l_discount AS l_discount, lineitem.l_tax AS l_tax, lineitem.l_returnflag AS l_returnflag, lineitem.l_linestatus AS l_linestatus, lineitem.l_shipdate AS l_shipdate, lineitem.l_commitdate AS l_commitdate, lineitem.l_receiptdate AS l_receiptdate, lineitem.l_shipinstruct AS l_shipinstruct, lineitem.l_shipmode AS l_shipmode, lineitem.l_comment AS l_comment
  FROM lineitem
  WHERE lineitem.l_shipdate > DATE '1995-03-29'
)
SELECT q3.l_orderkey AS l_orderkey, SUM(q3.l_extendedprice * (1 - q3.l_discount)) AS revenue, q2.o_orderdate AS o_orderdate, q2.o_shippriority AS o_shippriority
FROM q1
JOIN q2 ON q1.c_custkey = q2.o_custkey
JOIN q3 ON q3.l_orderkey = q2.o_orderkey
GROUP BY q3.l_orderkey, q2.o_orderdate, q2.o_shippriority
ORDER BY 2 DESC, 3
LIMIT 10

# Q5
query T nosort
EXPLAIN select
	n_name,
	sum(l_extendedprice * (1 - l_discount)) as revenue
from
	customer,
	orders,
	lineitem,
	supplier,
	nation,
	region
where
	c_custkey = o_custkey
	and l_orderkey = o_orderkey
	and l_suppkey = s_suppkey
	and c_nationkey = s_nationkey
	and s_nationkey = n_nationkey
	and n_regionkey = r_regionkey
	and r_name = 'MIDDLE EAST'
	and o_orderdate >= date '1994-01-01'
	and o_orderdate < date '1995-01-01'
group by
	n_name
order by
	revenue desc;
----
== Optimized Logical Plan ==
Sort: revenue DESC
  Project: n_name, _agg0 AS revenue
    Aggregate: GROUP BY nation.n_name; SUM(lineitem.l_extendedprice * (1 - lineitem.l_discount)) AS _agg0
      Join INNER: nation.n_regionkey = region.r_regionkey
        Join INNER: supplier.s_nationkey = nation.n_nationkey
          Join INNER: lineitem.l_suppkey = supplier.s_suppkey AND customer.c_nationkey = supplier.s_nationkey
            Join INNER: lineitem.l_orderkey = orders.o_orderkey
              Join INNER: customer.c_custkey = orders.o_custkey
                Scan customer: c_custkey, c_name, c_address, c_nationkey, c_phone, c_acctbal, c_mktsegment, c_comment
                Filter: orders.o_orderdate >= DATE '1994-01-01' AND orders.o_orderdate < DATE '1995-01-01'
                  Scan orders: o_orderkey, o_custkey, o_orderstatus, o_totalprice, o_orderdate, o_orderpriority, o_clerk, o_shippriority, o_comment
              Scan lineitem: l_orderkey, l_partkey, l_suppkey, l_linenumber, l_quantity, l_extendedprice, l_discount, l_tax, l_returnflag, l_linestatus, l_shipdate, l_commitdate, l_receiptdate, l_shipinstruct, l_shipmode, l_comment
            Scan supplier: s_suppkey, s_name, s_address, s_nationkey, s_phone, s_acctbal, s_comment
          Scan nation: n_nationkey, n_name, n_regionkey, n_comment
        Filter: region.r_name = 'MIDDLE EAST'
          Scan region: r_regionkey, r_name, r_comment
== Optimized SQL ==
WITH q1 AS (
  SELECT orders.o_orderkey AS o_orderkey, orders.o_custkey AS o_custkey, orders.o_orderstatus AS o_orderstatus, orders.o_totalprice AS o_totalprice, orders.o_orderdate AS o_orderdate, orders.o_orderpriority AS o_orderpriority, orders.o_clerk AS o_clerk, orders.o_shippriority AS o_shippriority, orders.o_comment AS o_comment
  FROM orders
  WHERE orders.o_orderdate >= DATE '1994-01-01' AND orders.o_orderdate < DATE '1995-01-01'
), q2 AS (
  SELECT region.r_regionkey AS r_regionkey, region.r_name AS r_name, region.r_comment AS r_comment
  FROM region
  WHERE region.r_name = 'MIDDLE EAST'
)
SELECT nation.n_name AS n_name, SUM(lineitem.l_extendedprice * (1 - lineitem.l_discount)) AS revenue
FROM customer
JOIN q1 ON customer.c_custkey = q1.o_custkey
JOIN lineitem ON lineitem.l_orderkey = q1.o_orderkey
JOIN supplier ON lineitem.l_suppkey = supplier.s_suppkey AND customer.c_nationkey = supplier.s_nationkey
JOIN nation ON supplier.s_nationkey = nation.n_nationkey
JOIN q2 ON nation.n_regionkey = q2.r_regionkey
GROUP BY nation.n_name
ORDER BY 2 DESC

# Q6
query T nosort
EXPLAIN select
  sum(l_extendedprice * l_discount) as revenue
from
  lineitem
where
  l_shipdate >= date '1994-01-01'
  and l_shipdate < date '1995-01-01'
  and l_discount between 0.08 - 0.01 and 0.08 + 0.01
  and l_quantity < 24;
----
== Optimized Logical Plan ==
Project: _agg0 AS revenue
  Aggregate: SUM(lineitem.l_extendedprice * lineitem.l_discount) AS _agg0
    Filter: lineitem.l_shipdate >= DATE '1994-01-01' AND lineitem.l_shipdate < DATE '1995-01-01' AND lineitem.l_discount >= 0.08 - 0.01 AND lineitem.l_discount <= 0.08 + 0.01 AND lineitem.l_quantity < 24
      Scan lineitem: l_orderkey, l_partkey, l_suppkey, l_linenumber, l_quantity, l_extendedprice, l_discount, l_tax, l_returnflag, l_linestatus, l_shipdate, l_commitdate, l_receiptdate, l_shipinstruct, l_shipmode, l_comment
== Optimized SQL ==
SELECT SUM(lineitem.l_extendedprice * lineitem.l_discount) AS revenue
FROM lineitem
WHERE lineitem.l_shipdate >= DATE '1994-01-01' AND lineitem.l_shipdate < DATE '1995-01-01' AND lineitem.l_discount >= 0.08 - 0.01 AND lineitem.l_discount <= 0.08 + 0.01 AND lineitem.l_quantity < 24

# Q10
query T nosort
EXPLAIN select
	c_custkey,
	c_name,
	round(sum(l_extendedprice * (1 - l_discount)), 2) as revenue,
	round(c_acctbal, 1) as c_acctbal,
	n_name,
	c_address,
	c_phone,
	c_comment
from
	customer,
	orders,
	lineitem,
	nation
where
	c_custkey = o_custkey
	and l_orderkey = o_orderkey
	and o_orderdate >= date '1994-01-01'
	and o_orderdate < date '1994-04-01'
	and l_returnflag = 'R'
	and c_nationkey = n_nationkey
group by
	c_custkey,
	c_name,
	c_acctbal,
	c_phone,
	n_name,
	c_address,
	c_comment
order by
	revenue desc
LIMIT 20;
----
== Optimized Logical Plan ==
Limit: 20
  Sort: revenue DESC
    Project: c_custkey, c_name, ROUND(_agg0, 2) AS revenue, ROUND(c_acctbal, 1) AS c_acctbal, n_name, c_address, c_phone, c_comment
      Aggregate: GROUP BY customer.c_custkey, customer.c_name, customer.c_acctbal, customer.c_phone, nation.n_name, customer.c_address, customer.c_comment; SUM(lineitem.l_extendedprice * (1 - lineitem.l_discount)) AS _agg0
        Join INNER: customer.c_nationkey = nation.n_nationkey
          Join INNER: lineitem.l_orderkey = orders.o_orderkey
            Join INNER: customer.c_custkey = orders.o_custkey
              Scan customer: c_custkey, c_name, c_address, c_nationkey, c_phone, c_acctbal, c_mktsegment, c_comment
              Filter: orders.o_orderdate >= DATE '1994-01-01' AND orders.o_orderdate < DATE '1994-04-01'
                Scan orders: o_orderkey, o_custkey, o_orderstatus, o_totalprice, o_orderdate, o_orderpriority, o_clerk, o_shippriority, o_comment
            Filter: lineitem.l_returnflag = 'R'
              Scan lineitem: l_orderkey, l_partkey, l_suppkey, l_linenumber, l_quantity, l_extendedprice, l_discount, l_tax, l_returnflag, l_linestatus, l_shipdate, l_commitdate, l_receiptdate, l_shipinstruct, l_shipmode, l_comment
          Scan nation: n_nationkey, n_name, n_regionkey, n_comment
== Optimized SQL ==
WITH q1 AS (
  SELECT orders.o_orderkey AS o_orderkey, orders.o_custkey AS o_custkey, orders.o_orderstatus AS o_orderstatus, orders.o_totalprice AS o_totalprice, orders.o_orderdate AS o_orderdate, orders.o_orderpriority AS o_orderpriority, orders.o_clerk AS o_clerk, orders.o_shippriority AS o_shippriority, orders.o_comment AS o_comment
  FROM orders
  WHERE orders.o_orderdate >= DATE '1994-01-01' AND orders.o_orderdate < DATE '1994-04-01'
), q2 AS (
  SELECT lineitem.l_orderkey AS l_orderkey, lineitem.l_partkey AS l_partkey, lineitem.l_suppkey AS l_suppkey, lineitem.l_linenumber AS l_linenumber, lineitem.l_quantity AS l_quantity, lineitem.l_extendedprice AS l_extendedprice, lineitem.l_discount AS l_discount, lineitem.l_tax AS l_tax, lineitem.l_returnflag AS l_returnflag, lineitem.l_linestatus AS l_linestatus, lineitem.l_shipdate AS l_shipdate, lineitem.l_commitdate AS l_commitdate, lineitem.l_receiptdate AS l_receiptdate, lineitem.l_shipinstruct AS l_shipinstruct, lineitem.l_shipmode AS l_shipmode, lineitem.l_comment AS l_comment
  FROM lineitem
  WHERE lineitem.l_returnflag = 'R'
)
SELECT customer.c_custkey AS c_custkey, customer.c_name AS c_name, ROUND(SUM(q2.l_extendedprice * (1 - q2.l_discount)), 2) AS revenue, ROUND(customer.c_acctbal, 1) AS c_acctbal, nation.n_name AS n_name, customer.c_address AS c_address, customer.c_phone AS c_phone, customer.c_comment AS c_comment
FROM customer
JOIN q1 ON customer.c_custkey = q1.o_custkey
JOIN q2 ON q2.l_orderkey = q1.o_orderkey
JOIN nation ON customer.c_nationkey = nation.n_nationkey
GROUP BY customer.c_custkey, customer.c_name, customer.c_acctbal, customer.c_phone, nation.n_name, customer.c_address, customer.c_comment
ORDER BY 3 DESC
LIMIT 20

# Q12
query T nosort
EXPLAIN select
    l_shipmode,
    sum(case
        when o_orderpriority = '1-URGENT'
            or o_orderpriority = '2-HIGH'
            then 1
        else 0
    end) as high_line_count,
    sum(case
        when o_orderpriority <> '1-URGENT'
            and o_orderpriority <> '2-HIGH'
            then 1
        else 0
    end) as low_line_count
from
    orders,
    lineitem
where
    o_orderkey = l_orderkey
    and l_shipmode in ('FOB', 'SHIP')
    and l_commitdate < l_receiptdate
    and l_shipdate < l_commitdate
    and l_receiptdate >= date '1994-01-01'
    and l_receiptdate < date '1995-01-01'
group by
    l_shipmode
order by
    l_shipmode;
----
== Optimized Logical Plan ==
Sort: l_shipmode
  Project: l_shipmode, _agg0 AS high_line_count, _agg1 AS low_line_count
    Aggregate: GROUP BY lineitem.l_shipmode; SUM(CASE WHEN orders.o_orderpriority = '1-URGENT' OR orders.o_orderpriority = '2-HIGH' THEN 1 ELSE 0 END) AS _agg0, SUM(CASE WHEN orders.o_orderpriority <> '1-URGENT' AND orders.o_orderpriority <> '2-HIGH' THEN 1 ELSE 0 END) AS _agg1
      Join INNER: orders.o_orderkey = lineitem.l_orderkey
        Scan orders: o_orderkey, o_custkey, o_orderstatus, o_totalprice, o_orderdate, o_orderpriority, o_clerk, o_shippriority, o_comment
        Filter: lineitem.l_shipmode IN ('FOB', 'SHIP') AND lineitem.l_commitdate < lineitem.l_receiptdate AND lineitem.l_shipdate < lineitem.l_commitdate AND lineitem.l_receiptdate >= DATE '1994-01-01' AND lineitem.l_receiptdate < DATE '1995-01-01'
          Scan lineitem: l_orderkey, l_partkey, l_suppkey, l_linenumber, l_quantity, l_extendedprice, l_discount, l_tax, l_returnflag, l_linestatus, l_shipdate, l_commitdate, l_receiptdate, l_shipinstruct, l_shipmode, l_comment
== Optimized SQL ==
WITH q1 AS (
  SELECT lineitem.l_orderkey AS l_orderkey, lineitem.l_partkey AS l_partkey, lineitem.l_suppkey AS l_suppkey, lineitem.l_linenumber AS l_linenumber, lineitem.l_quantity AS l_quantity, lineitem.l_extendedprice AS l_extendedprice, lineitem.l_discount AS l_discount, lineitem.l_tax AS l_tax, lineitem.l_returnflag AS l_returnflag, lineitem.l_linestatus AS l_linestatus, lineitem.l_shipdate AS l_shipdate, lineitem.l_commitdate AS l_commitdate, lineitem.l_receiptdate AS l_receiptdate, lineitem.l_shipinstruct AS l_shipinstruct, lineitem.l_shipmode AS l_shipmode, lineitem.l_comment AS l_comment
  FROM lineitem
  WHERE lineitem.l_shipmode IN ('FOB', 'SHIP') AND lineitem.l_commitdate < lineitem.l_receiptdate AND lineitem.l_shipdate < lineitem.l_commitdate AND lineitem.l_receiptdate >= DATE '1994-01-01' AND lineitem.l_receiptdate < DATE '1995-01-01'
)
SELECT q1.l_shipmode AS l_shipmode, SUM(CASE WHEN orders.o_orderpriority = '1-URGENT' OR orders.o_orderpriority = '2-HIGH' THEN 1 ELSE 0 END) AS high_line_count, SUM(CASE WHEN orders.o_orderpriority <> '1-URGENT' AND orders.o_orderpriority <> '2-HIGH' THEN 1 ELSE 0 END) AS low_line_count
FROM orders
JOIN q1 ON orders.o_orderkey = q1.l_orderkey
GROUP BY q1.l_shipmode
ORDER BY 1

# Q14
query T nosort
EXPLAIN select
        ROUND(100.00 * sum(case
                when p_type LIKE 'PROMO%'
                        then l_extendedprice * (1 - l_discount)
                else 0
        end) / sum(l_extendedprice * (1 - l_discount)), 16) as promo_revenue
from
        lineitem,
        part
where
        l_partkey = p_partkey
        and l_shipdate >= date '1995-09-01'
        and l_shipdate < date '1995-10-01';
----
== Optimized Logical Plan ==
Project: ROUND(100.00 * _agg0 / _agg1, 16) AS promo_revenue
  Aggregate: SUM(CASE WHEN part.p_type LIKE 'PROMO%' THEN lineitem.l_extendedprice * (1 - lineitem.l_discount) ELSE 0 END) AS _agg0, SUM(lineitem.l_extendedprice * (1 - lineitem.l_discount)) AS _agg1
    Join INNER: lineitem.l_partkey = part.p_partkey
      Filter: lineitem.l_shipdate >= DATE '1995-09-01' AND lineitem.l_shipdate < DATE '1995-10-01'
        Scan lineitem: l_orderkey, l_partkey, l_suppkey, l_linenumber, l_quantity, l_extendedprice, l_discount, l_tax, l_returnflag, l_linestatus, l_shipdate, l_commitdate, l_receiptdate, l_shipinstruct, l_shipmode, l_comment
      Scan part: p_partkey, p_name, p_mfgr, p_brand, p_type, p_size, p_container, p_retailprice, p_comment
== Optimized SQL ==
WITH q1 AS (
  SELECT lineitem.l_orderkey AS l_orderkey, lineitem.l_partkey AS l_partkey, lineitem.l_suppkey AS l_suppkey, lineitem.l_linenumber AS l_linenumber, lineitem.l_quantity AS l_quantity, lineitem.l_extendedprice AS l_extendedprice, lineitem.l_discount AS l_discount, lineitem.l_tax AS l_tax, lineitem.l_returnflag AS l_returnflag, lineitem.l_linestatus AS l_linestatus, lineitem.l_shipdate AS l_shipdate, lineitem.l_commitdate AS l_commitdate, lineitem.l_receiptdate AS l_receiptdate, lineitem.l_shipinstruct AS l_shipinstruct, lineitem.l_shipmode AS l_shipmode, lineitem.l_comment AS l_comment
  FROM lineitem
  WHERE lineitem.l_shipdate >= DATE '1995-09-01' AND lineitem.l_shipdate < DATE '1995-10-01'
)
SELECT ROUND(100.00 * SUM(CASE WHEN part.p_type LIKE 'PROMO%' THEN q1.l_extendedprice * (1 - q1.l_discount) ELSE 0 END) / SUM(q1.l_extendedprice * (1 - q1.l_discount)), 16) AS promo_revenue
FROM q1
JOIN part ON q1.l_partkey = part.p_partkey

# Q19
query T nosort
EXPLAIN select
	sum(l_extendedprice* (1 - l_discount)) as revenue
from
	lineitem,
	part
where
	(
		p_partkey = l_partkey
		and p_brand = 'Brand#52'
		and p_container in ('SM CASE', 'SM BOX', 'SM PACK', 'SM PKG')
		and l_quantity >= 1 and l_quantity <= 11
		and p_size between 1 and 5
		and l_shipmode in ('AIR', 'AIR REG')
		and l_shipinstruct = 'DELIVER IN PERSON'
	)
	or
	(
		p_partkey = l_partkey
		and p_brand = 'Brand#24'
		and p_container in ('MED BAG', 'MED BOX', 'MED PKG', 'MED PACK')
		and l_quantity >= 30 and l_quantity <= 40
		and p_size between 1 and 10
		and l_shipmode in ('AIR', 'AIR REG')
		and l_shipinstruct = 'DELIVER IN PERSON'
	)
	or
	(
		p_partkey = l_partkey
		and p_brand = 'Brand#32'
		and p_container in ('LG CASE', 'LG BOX', 'LG PACK', 'LG PKG')
		and l_quantity >= 10 and l_quantity <= 20
		and p_size between 1 and 15
		and l_shipmode in ('AIR', 'AIR REG')
		and l_shipinstruct = 'DELIVER IN PERSON'
	);
----
== Optimized Logical Plan ==
Project: _agg0 AS revenue
  Aggregate: SUM(lineitem.l_extendedprice * (1 - lineitem.l_discount)) AS _agg0
    Join INNER: ((part.p_partkey = lineitem.l_partkey AND part.p_brand = 'Brand#52' AND part.p_container IN ('SM CASE', 'SM BOX', 'SM PACK', 'SM PKG') AND lineitem.l_quantity >= 1) AND ((lineitem.l_quantity <= 11 AND part.p_size >= 1 AND part.p_size <= 5) AND (lineitem.l_shipmode IN ('AIR', 'AIR REG') AND lineitem.l_shipinstruct = 'DELIVER IN PERSON'))) OR ((part.p_partkey = lineitem.l_partkey AND part.p_brand = 'Brand#24' AND part.p_container IN ('MED BAG', 'MED BOX', 'MED PKG', 'MED PACK') AND lineitem.l_quantity >= 30) AND ((lineitem.l_quantity <= 40 AND part.p_size >= 1 AND part.p_size <= 10) AND (lineitem.l_shipmode IN ('AIR', 'AIR REG') AND lineitem.l_shipinstruct = 'DELIVER IN PERSON'))) OR ((part.p_partkey = lineitem.l_partkey AND part.p_brand = 'Brand#32' AND part.p_container IN ('LG CASE', 'LG BOX', 'LG PACK', 'LG PKG') AND lineitem.l_quantity >= 10) AND ((lineitem.l_quantity <= 20 AND part.p_size >= 1 AND part.p_size <= 15) AND (lineitem.l_shipmode IN ('AIR', 'AIR REG') AND lineitem.l_shipinstruct = 'DELIVER IN PERSON')))
      Scan lineitem: l_orderkey, l_partkey, l_suppkey, l_linenumber, l_quantity, l_extendedprice, l_discount, l_tax, l_returnflag, l_linestatus, l_shipdate, l_commitdate, l_receiptdate, l_shipinstruct, l_shipmode, l_comment
      Scan part: p_partkey, p_name, p_mfgr, p_brand, p_type, p_size, p_container, p_retailprice, p_comment
== Optimized SQL ==
SELECT SUM(lineitem.l_extendedprice * (1 - lineitem.l_discount)) AS revenue
FROM lineitem
JOIN part ON ((part.p_partkey = lineitem.l_partkey AND part.p_brand = 'Brand#52' AND part.p_container IN ('SM CASE', 'SM BOX', 'SM PACK', 'SM PKG') AND lineitem.l_quantity >= 1) AND ((lineitem.l_quantity <= 11 AND part.p_size >= 1 AND part.p_size <= 5) AND (lineitem.l_shipmode IN ('AIR', 'AIR REG') AND lineitem.l_shipinstruct = 'DELIVER IN PERSON'))) OR ((part.p_partkey = lineitem.l_partkey AND part.p_brand = 'Brand#24' AND part.p_container IN ('MED BAG', 'MED BOX', 'MED PKG', 'MED PACK') AND lineitem.l_quantity >= 30) AND ((lineitem.l_quantity <= 40 AND part.p_size >= 1 AND part.p_size <= 10) AND (lineitem.l_shipmode IN ('AIR', 'AIR REG') AND lineitem.l_shipinstruct = 'DELIVER IN PERSON'))) OR ((part.p_partkey = lineitem.l_partkey AND part.p_brand = 'Brand#32' AND part.p_container IN ('LG CASE', 'LG BOX', 'LG PACK', 'LG PKG') AND lineitem.l_quantity >= 10) AND ((lineitem.l_quantity <= 20 AND part.p_size >= 1 AND part.p_size <= 15) AND (lineitem.l_shipmode IN ('AIR', 'AIR REG') AND lineitem.l_shipinstruct = 'DELIVER IN PERSON')))

# Q13
query T nosort
EXPLAIN with c_orders (c_custkey, c_count) as (
	select
		c_custkey,
		count(o_orderkey)
	from
		customer left outer join orders on
			c_custkey = o_custkey
			and o_comment NOT LIKE '%:1%:2%'
	group by
		c_custkey
)
select
	c_count,
	count(*) as custdist
from
	c_orders
group by
	c_count
order by
	custdist desc,
	c_count desc;
----
== Optimized Logical Plan ==
Sort: custdist DESC, c_count DESC
  Project: c_count, _agg0 AS custdist
    Aggregate: GROUP BY c_count; COUNT(*) AS _agg0
      Project: c_custkey, "count(o_orderkey)" AS c_count
        Project: c_custkey, _agg0 AS "count(o_orderkey)"
          Aggregate: GROUP BY customer.c_custkey; COUNT(orders.o_orderkey) AS _agg0
            Join LEFT: customer.c_custkey = orders.o_custkey AND orders.o_comment NOT LIKE '%:1%:2%'
              Scan customer: c_custkey, c_name, c_address, c_nationkey, c_phone, c_acctbal, c_mktsegment, c_comment
              Scan orders: o_orderkey, o_custkey, o_orderstatus, o_totalprice, o_orderdate, o_orderpriority, o_clerk, o_shippriority, o_comment
== Optimized SQL ==
WITH q1 AS (
  SELECT customer.c_custkey AS c_custkey, COUNT(orders.o_orderkey) AS "count(o_orderkey)"
  FROM customer
  LEFT JOIN orders ON customer.c_custkey = orders.o_custkey AND orders.o_comment NOT LIKE '%:1%:2%'
  GROUP BY customer.c_custkey
), q2 AS (
  SELECT q1.c_custkey AS c_custkey, q1."count(o_orderkey)" AS c_count
  FROM q1
)
SELECT q2.c_count AS c_count, COUNT(*) AS custdist
FROM q2
GROUP BY q2.c_count
ORDER BY 2 DESC, 1 DESC

# Q11
query T nosort
EXPLAIN with threshold (t) as (
	select
		sum(ps_supplycost * ps_availqty) * 0.0001000000
	from
		partsupp,
		supplier,
		nation
	where
		ps_suppkey = s_suppkey
		and s_nationkey = n_nationkey
		and n_name = 'ARGENTINA'
)
select
	ps_partkey,
	round(sum(ps_supplycost * ps_availqty), 1) as value
from
	partsupp,
	supplier,
	nation,
	threshold
where
	ps_suppkey = s_suppkey
	and s_nationkey = n_nationkey
	and n_name = 'ARGENTINA'
group by
	ps_partkey,
	t
having
    sum(ps_supplycost * ps_availqty) > t
order by
	value desc;
----
== Optimized Logical Plan ==
Sort: "value" DESC
  Project: ps_partkey, ROUND(_agg0, 1) AS "value"
    Filter: _agg0 > t
      Aggregate: GROUP BY partsupp.ps_partkey, t; SUM(partsupp.ps_supplycost * partsupp.ps_availqty) AS _agg0
        Join CROSS
          Join INNER: supplier.s_nationkey = nation.n_nationkey
            Join INNER: partsupp.ps_suppkey = supplier.s_suppkey
              Scan partsupp: ps_partkey, ps_suppkey, ps_availqty, ps_supplycost, ps_comment
              Scan supplier: s_suppkey, s_name, s_address, s_nationkey, s_phone, s_acctbal, s_comment
            Filter: nation.n_name = 'ARGENTINA'
              Scan nation: n_nationkey, n_name, n_regionkey, n_comment
          Project: "sum(ps_supplycost * ps_availqty) * 0.0001000000" AS t
            Project: _agg0 * 0.0001000000 AS "sum(ps_supplycost * ps_availqty) * 0.0001000000"
              Aggregate: SUM(partsupp.ps_supplycost * partsupp.ps_availqty) AS _agg0
                Join INNER: supplier.s_nationkey = nation.n_nationkey
                  Join INNER: partsupp.ps_suppkey = supplier.s_suppkey
                    Scan partsupp: ps_partkey, ps_suppkey, ps_availqty, ps_supplycost, ps_comment
                    Scan supplier: s_suppkey, s_name, s_address, s_nationkey, s_phone, s_acctbal, s_comment
                  Filter: nation.n_name = 'ARGENTINA'
                    Scan nation: n_nationkey, n_name, n_regionkey, n_comment
== Optimized SQL ==
WITH q1 AS (
  SELECT nation.n_nationkey AS n_nationkey, nation.n_name AS n_name, nation.n_regionkey AS n_regionkey, nation.n_comment AS n_comment
  FROM nation
  WHERE nation.n_name = 'ARGENTINA'
), q2 AS (
  SELECT nation.n_nationkey AS n_nationkey, nation.n_name AS n_name, nation.n_regionkey AS n_regionkey, nation.n_comment AS n_comment
  FROM nation
  WHERE nation.n_name = 'ARGENTINA'
), q3 AS (
  SELECT SUM(partsupp.ps_supplycost * partsupp.ps_availqty) * 0.0001000000 AS "sum(ps_supplycost * ps_availqty) * 0.0001000000"
  FROM partsupp
  JOIN supplier ON partsupp.ps_suppkey = supplier.s_suppkey
  JOIN q2 ON supplier.s_nationkey = q2.n_nationkey
), q4 AS (
  SELECT q3."sum(ps_supplycost * ps_availqty) * 0.0001000000" AS t
  FROM q3
)
SELECT partsupp.ps_partkey AS ps_partkey, ROUND(SUM(partsupp.ps_supplycost * partsupp.ps_availqty), 1) AS "value"
FROM partsupp
JOIN supplier ON partsupp.ps_suppkey = supplier.s_suppkey
JOIN q1 ON supplier.s_nationkey = q1.n_nationkey
CROSS JOIN q4
GROUP BY partsupp.ps_partkey, q4.t
HAVING SUM(partsupp.ps_supplycost * partsupp.ps_availqty) > q4.t
ORDER BY 2 DESC

# Q15
query T nosort
EXPLAIN with revenue0 (supplier_no, total_revenue) as (
  select
    l_suppkey,
    sum(l_extendedprice * (1 - l_discount))
  from
    lineitem
  where
    l_shipdate >= date '1993-01-01'
    and l_shipdate < date '1993-04-01'
  group by
    l_suppkey
),
max_revenue (m) as (
  select
    max(total_revenue)
  from
    revenue0
)
select
  s_suppkey,
  s_name,
  s_address,
  s_phone,
  total_revenue
from
  supplier,
  revenue0,
  max_revenue
where
  s_suppkey = supplier_no
  and total_revenue = m
order by
  s_suppkey;
----
== Optimized Logical Plan ==
Sort: s_suppkey
  Project: supplier.s_suppkey, supplier.s_name, supplier.s_address, supplier.s_phone, revenue0.total_revenue
    Join INNER: revenue0.total_revenue = m
      Join INNER: supplier.s_suppkey = revenue0.supplier_no
        Scan supplier: s_suppkey, s_name, s_address, s_nationkey, s_phone, s_acctbal, s_comment
        Scan CTE revenue0: supplier_no, total_revenue
      Project: "max(total_revenue)" AS m
        Project: _agg0 AS "max(total_revenue)"
          Aggregate: MAX(revenue0.total_revenue) AS _agg0
            Scan CTE revenue0: supplier_no, total_revenue
CTE revenue0:
  Project: l_suppkey AS supplier_no, "sum(l_extendedprice * (1 - l_discount))" AS total_revenue
    Project: l_suppkey, _agg0 AS "sum(l_extendedprice * (1 - l_discount))"
      Aggregate: GROUP BY lineitem.l_suppkey; SUM(lineitem.l_extendedprice * (1 - lineitem.l_discount)) AS _agg0
        Filter: lineitem.l_shipdate >= DATE '1993-01-01' AND lineitem.l_shipdate < DATE '1993-04-01'
          Scan lineitem: l_orderkey, l_partkey, l_suppkey, l_linenumber, l_quantity, l_extendedprice, l_discount, l_tax, l_returnflag, l_linestatus, l_shipdate, l_commitdate, l_receiptdate, l_shipinstruct, l_shipmode, l_comment
== Optimized SQL ==
WITH q1 AS (
  SELECT lineitem.l_suppkey AS l_suppkey, SUM(lineitem.l_extendedprice * (1 - lineitem.l_discount)) AS "sum(l_extendedprice * (1 - l_discount))"
  FROM lineitem
  WHERE lineitem.l_shipdate >= DATE '1993-01-01' AND lineitem.l_shipdate < DATE '1993-04-01'
  GROUP BY lineitem.l_suppkey
), revenue0 AS (
  SELECT q1.l_suppkey AS supplier_no, q1."sum(l_extendedprice * (1 - l_discount))" AS total_revenue
  FROM q1
), q2 AS (
  SELECT MAX(revenue0.total_revenue) AS "max(total_revenue)"
  FROM revenue0
), q3 AS (
  SELECT q2."max(total_revenue)" AS m
  FROM q2
)
SELECT supplier.s_suppkey AS s_suppkey, supplier.s_name AS s_name, supplier.s_address AS s_address, supplier.s_phone AS s_phone, revenue0.total_revenue AS total_revenue
FROM supplier
JOIN revenue0 ON supplier.s_suppkey = revenue0.supplier_no
JOIN q3 ON revenue0.total_revenue = q3.m
ORDER BY 1
