# Q15, the date '1993-01-01' + interval '3' month folded to '1993-04-01', and the
# uncorrelated scalar subquery, the one row of max(total_revenue), joined as the
# one-row WITH max_revenue (m).
query ITTTR
with revenue0 (supplier_no, total_revenue) as (
  select
    l_suppkey,
    sum(l_extendedprice * (1 - l_discount))
  from
    lineitem
  where
    l_shipdate >= date '1993-01-01'
    and l_shipdate < date '1993-04-01'
  group by
    l_suppkey
),
max_revenue (m) as (
  select
    max(total_revenue)
  from
    revenue0
)
select
  s_suppkey,
  s_name,
  s_address,
  s_phone,
  total_revenue
from
  supplier,
  revenue0,
  max_revenue
where
  s_suppkey = supplier_no
  and total_revenue = m
order by
  s_suppkey;
