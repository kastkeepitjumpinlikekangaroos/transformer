# TPC-H's queries over RisingWave's tiny TPC-H data, with RisingWave's answers
# (https://github.com/risingwavelabs/risingwave, commit
# d42d130042f0bf2b4ebaa5b6d84f69c66b997744): e2e_test/tpch/create_tables.slt.part
# and insert_*.slt.part (the eight tables, at about scale factor 0.001) are
# beside this file as they are there; each query is e2e_test/batch/tpch/q<n>.slt.part.
# RisingWave's files are under the Apache License 2.0 (LICENSE and NOTICE beside
# this file). The queries are TPC-H's, from the TPC Benchmark H specification of
# the Transaction Processing Performance Council (TPC); RisingWave's text of
# them is vendored as its files hold it (plans/testing/12, decision 4).
# transformer: an unconstrained DECIMAL is DECIMAL(15,2)
#
# The money and quantity columns, unconstrained NUMERICs there, are TPC-H's
# DECIMAL(15,2). Eleven of the 22 queries run: Q1, Q3, Q5, Q6, Q10, Q12, Q14 and
# Q19 as written but with each constant date expression folded to its value
# (`date '1998-12-01' - interval '71' day` as `date '1998-09-21'`), a rewrite
# that cannot change the meaning; Q13, whose subquery in FROM is a WITH, as the
# Postgres ports write one; and Q11 and Q15, whose uncorrelated scalar subquery
# is an aggregate with no GROUP BY, exactly one row, joined as a one-row WITH,
# which cannot change the answer. Q7, Q8 and Q9 need EXTRACT(year FROM ...),
# which the engine has not; Q2, Q4, Q16, Q17, Q18, Q20, Q21 and Q22 need a
# correlated, IN or EXISTS subquery. Each record says its rewrite; Q13's and
# Q14's `like` is written `LIKE`, since a lowercase `like` does not parse under
# a Turkish default locale (the zone configuration), a finding held for the
# user (plans/testing/10).

include ./create_tables.slt.part

include ./insert_region.slt.part

include ./insert_nation.slt.part

include ./insert_supplier.slt.part

include ./insert_customer.slt.part

include ./insert_part.slt.part

include ./insert_partsupp.slt.part

include ./insert_orders.slt.part

include ./insert_lineitem.slt.part


# Q1, the date '1998-12-01' - interval '71' day folded to '1998-09-21'.
query TTRRRRRRRI
select
  l_returnflag,
  l_linestatus,
  sum(l_quantity) as sum_qty,
  sum(l_extendedprice) as sum_base_price,
  sum(l_extendedprice * (1 - l_discount)) as sum_disc_price,
  sum(l_extendedprice * (1 - l_discount) * (1 + l_tax)) as sum_charge,
  round(avg(l_quantity), 4) as avg_qty,
  round(avg(l_extendedprice), 4) as avg_price,
  round(avg(l_discount), 4) as avg_disc,
  count(*) as count_order
from
  lineitem
where
  l_shipdate <= date '1998-09-21'
group by
  l_returnflag,
  l_linestatus
order by
  l_returnflag,
  l_linestatus;
