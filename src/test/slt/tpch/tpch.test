# Q11, the uncorrelated scalar subquery of its HAVING, an aggregate with no GROUP BY
# and so one row, joined as the one-row WITH threshold (t), and t added to the
# GROUP BY, where it is one value for every group.
query IR
with threshold (t) as (
	select
		sum(ps_supplycost * ps_availqty) * 0.0001000000
	from
		partsupp,
		supplier,
		nation
	where
		ps_suppkey = s_suppkey
		and s_nationkey = n_nationkey
		and n_name = 'ARGENTINA'
)
select
	ps_partkey,
	round(sum(ps_supplycost * ps_availqty), 1) as value
from
	partsupp,
	supplier,
	nation,
	threshold
where
	ps_suppkey = s_suppkey
	and s_nationkey = n_nationkey
	and n_name = 'ARGENTINA'
group by
	ps_partkey,
	t
having
    sum(ps_supplycost * ps_availqty) > t
order by
	value desc;
