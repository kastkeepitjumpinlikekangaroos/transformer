# Q12, the date '1994-01-01' + interval '1' year folded to '1995-01-01'.
query TII
select
    l_shipmode,
    sum(case
        when o_orderpriority = '1-URGENT'
            or o_orderpriority = '2-HIGH'
            then 1
        else 0
    end) as high_line_count,
    sum(case
        when o_orderpriority <> '1-URGENT'
            and o_orderpriority <> '2-HIGH'
            then 1
        else 0
    end) as low_line_count
from
    orders,
    lineitem
where
    o_orderkey = l_orderkey
    and l_shipmode in ('FOB', 'SHIP')
    and l_commitdate < l_receiptdate
    and l_shipdate < l_commitdate
    and l_receiptdate >= date '1994-01-01'
    and l_receiptdate < date '1995-01-01'
group by
    l_shipmode
order by
    l_shipmode;
----
FOB   4  3
SHIP  5  10

# Q14, the date '1995-09-01' + interval '1' month folded to '1995-10-01'. Its
# quotient of two DECIMAL sums keeps six places here (decimal-result-type), so
# ROUND to 16 places gives RisingWave's value to six.
skipif transformer decimal-result-type
query R
select
        ROUND(100.00 * sum(case
                when p_type LIKE 'PROMO%'
                        then l_extendedprice * (1 - l_discount)
                else 0
        end) / sum(l_extendedprice * (1 - l_discount)), 16) as promo_revenue
from
        lineitem,
        part
where
        l_partkey = p_partkey
        and l_shipdate >= date '1995-09-01'
        and l_shipdate < date '1995-10-01';
----
15.2302126115972488

onlyif transformer decimal-result-type
query R
select
        ROUND(100.00 * sum(case
                when p_type LIKE 'PROMO%'
                        then l_extendedprice * (1 - l_discount)
                else 0
        end) / sum(l_extendedprice * (1 - l_discount)), 16) as promo_revenue
from
        lineitem,
        part
where
        l_partkey = p_partkey
        and l_shipdate >= date '1995-09-01'
        and l_shipdate < date '1995-10-01';
