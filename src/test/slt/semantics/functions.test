# Hand-picked cells of the function sweep, src/test/semantics/functions-text.txt,
# functions-math.txt and functions-flow.txt, which semantics_tables_test
# generates by evaluating each call alone on both paths. Here they run through
# the whole engine, under every verification mode and as the plan printed back
# to SQL. A rule change regenerates the sweep and changes these records in the
# same commit.

statement ok
CREATE TABLE f (id INT, i INT, b BIGINT, d DOUBLE, m DECIMAL(5,2), s STRING, t BOOLEAN)

statement ok
INSERT INTO f VALUES (1, -2147483648, 9223372036854775807, -2.7, 999.99, ' 5', true), (2, 15, 2147483648, 2.5, -2.50, 'true ', NULL), (3, 0, 0, CAST('NaN' AS DOUBLE), 0.00, '', false), (4, NULL, NULL, NULL, NULL, NULL, NULL)

# ---- text: code points, Unicode's own case rules, TRIM removes spaces alone

query INT,STRING,STRING,STRING,STRING,STRING
SELECT id, UPPER(s), TRIM(s), SUBSTRING(s, 2), SUBSTRING(s, 2, 2), CONCAT(s, 'abc') FROM f ORDER BY id
----
1	 5	5	5	5	 5abc
2	TRUE 	true	rue 	ru	true abc
3	(empty)	(empty)	(empty)	(empty)	abc
4	NULL	NULL	NULL	NULL	NULL

query INT,STRING,STRING,STRING
SELECT LENGTH('x𠀀y'), UPPER('ß'), LOWER('İ'), CONCAT()
----
3	ß	i	(empty)

query STRING,STRING,STRING,STRING
SELECT SUBSTRING('abc', -1, 2), SUBSTRING('abc', 0, 2), SUBSTRING('abc', 4), SUBSTRING('abc', 2147483648)
----
ab	ab	(empty)	(empty)

statement error
SELECT SUBSTRING('abc', 2, -1)
----
SUBSTRING's length -1 is negative

statement error
SELECT SUBSTRING('abc', 2, i) FROM f WHERE id = 1
----
SUBSTRING's length -2147483648 is negative

statement error
SELECT LENGTH(i) FROM f
----
LENGTH on INT is not supported; CAST it to STRING

# ---- numbers: the rounding functions exact, ABS and SIGN, MOD as %

query INT,INT,DOUBLE,DOUBLE,DOUBLE,DOUBLE
SELECT id, ROUND(i, -1), ROUND(d), ROUND(d, 1), FLOOR(d), CEIL(d) FROM f WHERE id > 1 ORDER BY id
----
2	20	3.0	2.5	2.0	3.0
3	0	NaN	NaN	NaN	NaN
4	NULL	NULL	NULL	NULL	NULL

query INT,DECIMAL(4,0),DECIMAL(3,0),DECIMAL(5,1),DECIMAL(6,2)
SELECT id, ROUND(m), TRUNC(m), ROUND(m, 1), ROUND(m, i) FROM f ORDER BY id
----
1	1000	999	1000.0	0.00
2	-3	-2	-2.5	-2.50
3	0	0	0.0	0.00
4	NULL	NULL	NULL	NULL

query DOUBLE,DOUBLE,INT,BIGINT
SELECT ROUND(1.005, 2), ROUND(-2.5), ROUND(15, -1), TRUNC(9223372036854775807, -1)
----
1.01	-3.0	20	9223372036854775800

statement error
SELECT ROUND(i, -1) FROM f WHERE id = 1
----
Integer overflow: -2147483650 does not fit INT

statement error
SELECT ABS(i) FROM f WHERE id = 1
----
Integer overflow: ABS(-2147483648) does not fit INT

query INT,BIGINT,INT,INT
SELECT id, ABS(b), SIGN(i), SIGN(m) FROM f WHERE id > 1 ORDER BY id
----
2	2147483648	1	-1
3	0	0	0
4	NULL	NULL	NULL

statement error
SELECT SIGN(d) FROM f WHERE id = 3
----
SIGN of NaN is not defined; NaN is neither positive, negative nor zero

query INT,INT,DOUBLE,DECIMAL(5,2),DOUBLE
SELECT id, MOD(i, 7), MOD(d, 0), MOD(m, i), MOD(d, 1) FROM f WHERE id > 1 ORDER BY id
----
2	1	NULL	-2.50	0.5
3	0	NULL	NULL	NaN
4	NULL	NULL	NULL	NULL

# ---- math: outside a function's domain is NULL, NaN stays NaN

# Java's Math may round an exponential or a logarithm's last bit otherwise on
# another platform, so those are read to nine places.
query INT,DOUBLE,DOUBLE,DOUBLE,DOUBLE,DOUBLE
SELECT id, SQRT(d), ROUND(LN(d), 9), ROUND(LOG10(m), 9), ASIN(d), ROUND(EXP(i), 6) FROM f ORDER BY id
----
1	NULL	NULL	2.999995657	NULL	0.0
2	1.5811388300841898	0.916290732	NULL	NULL	3269017.372472
3	NaN	NaN	NULL	NaN	1.0
4	NULL	NULL	NULL	NULL	NULL

query DOUBLE,DOUBLE,DOUBLE,DOUBLE,DOUBLE,DOUBLE
SELECT POWER(0, -1), POWER(-8, 0.5), POWER(1, CAST('NaN' AS DOUBLE)), LOG(1, 8), LOG(2, 0), SIN(CAST('Infinity' AS DOUBLE))
----
NULL	NULL	1.0	NULL	NULL	NULL

query DOUBLE,DOUBLE,DOUBLE,DOUBLE
SELECT ROUND(LOG(2, 8), 9), POWER(2, 10), DEGREES(PI()), RADIANS(180)
----
3.0	1024.0	180.0	3.141592653589793

statement error
SELECT LOG(8)
----
LOG(x) with one argument is not supported, as engines disagree on its base; write LN(x) for base e, LOG10(x) for base 10, or LOG(base, x)

statement error
SELECT SQRT(s) FROM f
----
SQRT on STRING is not supported; CAST it to a number

# ---- flow: the first value not NULL, the chosen one, NULL where equal

query INT,INT,DOUBLE,STRING,INT,DOUBLE,DOUBLE
SELECT id, COALESCE(i, 2), COALESCE(d, 2.5), COALESCE(s, 'abc'), IF(t, 1, 2), GREATEST(d, 2.5), LEAST(d, 2.5) FROM f ORDER BY id
----
1	-2147483648	-2.7	 5	1	2.5	-2.7
2	15	2.5	true 	2	2.5	2.5
3	0	NaN	(empty)	2	NaN	2.5
4	2	2.5	abc	2	2.5	2.5

query INT,INT,STRING,BOOLEAN
SELECT id, NULLIF(i, 0), NULLIF(s, ''), NULLIF(t, TRUE) FROM f ORDER BY id
----
1	-2147483648	 5	NULL
2	15	true 	NULL
3	NULL	NULL	false
4	NULL	NULL	NULL

query DOUBLE,DOUBLE,INT
SELECT GREATEST(0.0, -0.0), LEAST(-0.0, 0.0), GREATEST(NULL, 1)
----
0.0	-0.0	1

statement error
SELECT IF(i, 1, 2) FROM f
----
IF takes a BOOLEAN, not INT; compare it with a value, or CAST it to BOOLEAN for TRUE where it is not 0
