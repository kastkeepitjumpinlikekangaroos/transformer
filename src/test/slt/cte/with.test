# A CTE is a name for its query, read wherever the query names it; one read
# twice is computed once and both reads see the same rows.

statement ok
CREATE TABLE t (id INT, g STRING, v INT)

statement ok
INSERT INTO t VALUES (1, 'a', 10), (2, 'a', 20), (3, 'b', 35), (4, 'b', NULL)

query STRING,BIGINT rowsort
WITH s AS (SELECT g, SUM(v) AS total FROM t GROUP BY g) SELECT g, total FROM s
----
a	30
b	35

query STRING,STRING rowsort
WITH s AS (SELECT g, SUM(v) AS total FROM t GROUP BY g) SELECT x.g, y.g FROM s x JOIN s y ON x.total < y.total
----
a	b

# A CTE may read an earlier one.
query INT rowsort
WITH a AS (SELECT id, v FROM t WHERE v IS NOT NULL), b AS (SELECT id FROM a WHERE v > 10) SELECT id FROM b
----
2
3

# Column names given with the CTE's name.
query INT,INT rowsort
WITH c(n, m) AS (SELECT id, v FROM t) SELECT n, m FROM c WHERE m >= 20
----
2	20
3	35

statement error
WITH c AS (SELECT 1 AS x), c AS (SELECT 2 AS x) SELECT x FROM c
