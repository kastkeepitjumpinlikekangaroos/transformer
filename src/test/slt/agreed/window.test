statement ok
CREATE TABLE t (id INTEGER, g INTEGER, k DOUBLE PRECISION, x BIGINT)

query INT,BIGINT,BIGINT rowsort
SELECT t.id AS id, DENSE_RANK() OVER (PARTITION BY t.g ORDER BY t.k DESC NULLS LAST) AS w0, MIN(t.x) OVER (PARTITION BY t.g ORDER BY t.k ASC NULLS FIRST RANGE BETWEEN UNBOUNDED PRECEDING AND CURRENT ROW) AS w1 FROM t AS t
----

statement ok
DROP TABLE t

