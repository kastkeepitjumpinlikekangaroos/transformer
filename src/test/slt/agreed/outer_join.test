query DATE,DATE,DECIMAL(18,4) nosort
SELECT t0.c1 AS o0, t2.c0 AS o1, t2.c3 AS o2 FROM r0 AS t0 FULL JOIN r2 AS t1 ON t0.c0 = t1.c0 RIGHT JOIN r0 AS t2 ON t1.c0 = t2.c1 WHERE 2 <= t0.c2 ORDER BY t0.c1 ASC NULLS FIRST, t2.c0 ASC NULLS FIRST, t2.c3 ASC NULLS FIRST LIMIT 2
