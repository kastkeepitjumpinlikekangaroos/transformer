query DATE,DOUBLE,DOUBLE rowsort
WITH w0 AS (SELECT DISTINCT t0.c1 AS o0, t0.c0 AS o1, t0.c4 AS o2 FROM r0 AS t0 WHERE t0.c3 = 1), w1 AS (SELECT DISTINCT t0.c0 AS o0, t0.c0 AS o1 FROM r1 AS t0) SELECT t0.o1 AS o0, AVG(t0.o2) AS o1, AVG(t0.o2) AS o2 FROM w0 AS t0 LEFT JOIN w0 AS t1 ON t0.o0 = t1.o1 WHERE t0.o2 <> t0.o2 GROUP BY t0.o1 HAVING COUNT(*) >= 2
----

query DATE rowsort
WITH w0 AS (SELECT DISTINCT t0.c0 AS o0 FROM r2 AS t0 WHERE CAST(3 AS BIGINT) >= CAST(3 AS BIGINT)), w1 AS (SELECT t0.c0 AS o0, t0.c1 AS o1, t0.c1 AS o2 FROM r0 AS t0) SELECT MIN(t0.o0) AS o0 FROM w1 AS t0 LEFT JOIN r1 AS t1 ON t0.o0 = t1.c0
