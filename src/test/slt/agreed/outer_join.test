query DATE,BIGINT rowsort
WITH w0 AS (SELECT DISTINCT t0.c1 AS o0, t0.c0 AS o1 FROM r0 AS t0 WHERE TRUE OR (CAST(NULL AS DATE) > t0.c1)), w1 AS (SELECT t0.c1 AS o0 FROM r0 AS t0 WHERE COALESCE(0) IS NOT NULL) SELECT t2.c0 AS o0, COUNT(*) AS o1 FROM r1 AS t0 LEFT JOIN w0 AS t1 ON t0.c0 = t1.o0 LEFT JOIN r2 AS t2 ON (t1.o0 = t2.c0) AND (CAST(NULL AS DOUBLE PRECISION) IS NULL) WHERE CAST(2 AS BIGINT) IS NOT NULL GROUP BY t2.c0 HAVING COUNT(*) < 1
