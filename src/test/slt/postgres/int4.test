# From PostgreSQL's regression suite (https://github.com/postgres/postgres):
# src/test/regress/sql/int4.sql at REL_18_6, commit
# 724edf9bde9d356724ad384a2e196edc3c9f80f7, with every answer from
# src/test/regress/expected/int4.out at that commit, never the engine's.
# Portions Copyright (c) 1996-2026, PostgreSQL Global Development Group;
# Portions Copyright (c) 1994, The Regents of the University of California.
# Distributed under the PostgreSQL License, a permissive license whose text
# travels with every copy: it is COPYRIGHT beside this file.
#
# The INT, Postgres's int4, at its limits: text no INT holds, comparisons,
# arithmetic past the range, which is an error in both engines, INT_MIN times
# and divided by -1, integer division, casts from DOUBLE and DECIMAL, and the
# text Postgres reads as an integer. 76 of the file's 94 statements are here,
# each record naming the line of int4.sql it comes from: 36 queries and 24
# statements that must fail, answered as Postgres answers them, and 16
# records the engine answers otherwise by design, below.
#
# A statement is as Postgres wrote it but where a rewrite cannot change what
# it means, which its record says: int4 as INT, x::int4 and int4 'x' as
# CAST(x AS INT), and int2 'x' and x::int2 as CAST(x AS INT) too, as no answer
# here depends on SMALLINT's range (the engine has none, and every value is
# small), an alias named true or false in double quotes (the engine reads
# TRUE and FALSE as the literals wherever they are written), a VALUES list in
# FROM as a table of its rows, made here, and a string an INSERT stores in
# INT4_TBL, which Postgres refuses, as CAST('...' AS INT), the conversion
# Postgres makes of it, so the engine reads the text, not the runner, which
# stores no text in an INT column. INT4_TBL is test_setup.sql's, each string
# it stores written as the number Postgres reads. An overflow's message is
# each engine's own, so those records are statement error with no text, and
# a result in no fixed order is compared as rowsort.
#
# `skipif transformer <id>` marks what the engine answers otherwise by
# design, the id naming the rule in the ledger in docs/gotchas.md and the
# comment the case: a CAST of a DOUBLE or a DECIMAL to INT truncates toward
# zero, where Postgres rounds (cast-truncates, 2), and text casts to INT by
# CSV's grammar, an optional sign and digits, where Postgres reads 0x, 0o and
# 0b prefixes and _ between digits (int-text, 14). After each, its twin,
# `onlyif transformer <id>`, is the same statement with the engine's own
# answer.
#
# Left out (12 statements), by what they need:
#    6  gcd() and lcm()
#    4  pg_input_is_valid() and pg_input_error_info()
#    2  the bitwise operator <<
#
# Held out (6 statements), both engines refusing them for different reasons:
# int4.sql:187, 189, 191, 194, 196 and 198, the text of a number one past
# INT's range in base 2, 8 or 16 (int4 '0x80000000'), which Postgres refuses
# as out of range and the engine as no integer of its grammar (int-text).

# test_setup.sql:67-75: INT4_TBL, int4 written INT, each string test_setup.sql
# stores written as the number Postgres reads it as ('   0  ' as 0).
statement ok
CREATE TABLE INT4_TBL(f1 INT)

statement ok
INSERT INTO INT4_TBL(f1) VALUES (0), (123456), (-123456), (2147483647), (-2147483647)

# int4.sql:8: bad values, each string written CAST('...' AS INT), the
# conversion Postgres makes of it as it stores it, so the engine reads the
# text. Postgres: invalid input syntax for type integer: "34.5".
statement error
INSERT INTO INT4_TBL(f1) VALUES (CAST('34.5' AS INT))

# int4.sql:9: Postgres: value "1000000000000" is out of range for type
# integer.
statement error
INSERT INTO INT4_TBL(f1) VALUES (CAST('1000000000000' AS INT))

# int4.sql:10: Postgres: invalid input syntax for type integer: "asdf".
statement error
INSERT INTO INT4_TBL(f1) VALUES (CAST('asdf' AS INT))

# int4.sql:11: Postgres: invalid input syntax for type integer: "     ".
statement error
INSERT INTO INT4_TBL(f1) VALUES (CAST('     ' AS INT))

# int4.sql:12: Postgres: invalid input syntax for type integer: "   asdf   ".
statement error
INSERT INTO INT4_TBL(f1) VALUES (CAST('   asdf   ' AS INT))

# int4.sql:13: Postgres: invalid input syntax for type integer: "- 1234".
statement error
INSERT INTO INT4_TBL(f1) VALUES (CAST('- 1234' AS INT))

# int4.sql:14: Postgres: invalid input syntax for type integer: "123       5".
statement error
INSERT INTO INT4_TBL(f1) VALUES (CAST('123       5' AS INT))

# int4.sql:15: Postgres: invalid input syntax for type integer: "".
statement error
INSERT INTO INT4_TBL(f1) VALUES (CAST('' AS INT))

