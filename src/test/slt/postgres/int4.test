# For int4.sql:130: its VALUES list in FROM is the table float8_values of
# its rows, each x::float8 written as the DOUBLE it is.
statement ok
CREATE TABLE float8_values (x DOUBLE)

statement ok
INSERT INTO float8_values VALUES (-2.5), (-1.5), (-0.5), (0.0), (0.5), (1.5), (2.5)

# int4.sql:130: rounding when casting from float.
skipif transformer cast-truncates # a CAST of a DOUBLE to INT truncates toward zero, where Postgres rounds half to even
query DOUBLE,INT rowsort
SELECT x, CAST(x AS INT) AS int4_value
FROM float8_values t
----
-0.5	0
-1.5	-2
-2.5	-2
0.0	0
0.5	0
1.5	2
2.5	2

onlyif transformer cast-truncates
query DOUBLE,INT rowsort
SELECT x, CAST(x AS INT) AS int4_value
FROM float8_values t
----
-0.5	0
-1.5	-1
-2.5	-2
0.0	0
0.5	0
1.5	1
2.5	2

# For int4.sql:140: its VALUES list is the table numeric_values of its rows,
# each x::numeric written as the DECIMAL(2,1) it is.
statement ok
CREATE TABLE numeric_values (x DECIMAL(2,1))

statement ok
INSERT INTO numeric_values VALUES (-2.5), (-1.5), (-0.5), (0.0), (0.5), (1.5), (2.5)

# int4.sql:140: rounding when casting from numeric.
skipif transformer cast-truncates # a CAST of a DECIMAL to INT truncates toward zero, where Postgres rounds half away from zero
query DECIMAL(2,1),INT rowsort
SELECT x, CAST(x AS INT) AS int4_value
FROM numeric_values t
----
-0.5	-1
-1.5	-2
-2.5	-3
0.0	0
0.5	1
1.5	2
2.5	3

onlyif transformer cast-truncates
query DECIMAL(2,1),INT rowsort
SELECT x, CAST(x AS INT) AS int4_value
FROM numeric_values t
----
-0.5	0
-1.5	-1
-2.5	-2
0.0	0
0.5	0
1.5	1
2.5	2

# int4.sql:177: non-decimal literals, int4 '...' written CAST('...' AS INT).
skipif transformer int-text # text casts to INT by CSV's grammar, which has no 0b prefix
query INT nosort
SELECT CAST('0b100101' AS INT)
----
37

onlyif transformer int-text
statement error
SELECT CAST('0b100101' AS INT)
----
Cannot cast '0b100101' to int

