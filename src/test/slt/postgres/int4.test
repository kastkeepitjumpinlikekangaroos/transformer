# int4.sql:95: more complex expressions: variations on unary minus parsing.
query INT nosort
SELECT -2+3 AS one
----
1

# int4.sql:97
query INT nosort
SELECT 4-2 AS two
----
2

# int4.sql:99
query INT nosort
SELECT 2- -1 AS three
----
3

# int4.sql:101
query INT nosort
SELECT 2 - -2 AS four
----
4

# int4.sql:103: the alias true written in double quotes, as the engine reads
# TRUE as the literal wherever it is written.
query BOOLEAN nosort
SELECT CAST('2' AS INT) * CAST('2' AS INT) = CAST('16' AS INT) / CAST('4' AS INT) AS "true"
----
true

# int4.sql:105
query BOOLEAN nosort
SELECT CAST('2' AS INT) * CAST('2' AS INT) = CAST('16' AS INT) / CAST('4' AS INT) AS "true"
