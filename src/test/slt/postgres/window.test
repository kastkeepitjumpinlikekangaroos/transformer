# window.sql:73. Postgres's lead is a numeric here (0, 8, -1.4); the
# engine's is a DOUBLE, since the default -1.4 is one, so each value prints
# as a DOUBLE (0.0, 8.0, -1.4). rowsort: the ORDER BY leaves ties.
query DOUBLE,INT,INT rowsort
SELECT lead(ten * 2, 1, -1.4) OVER (PARTITION BY four ORDER BY ten), ten, four FROM tenk1 WHERE unique2 < 10 ORDER BY four, ten
----
-1.4	0	2
-1.4	3	3
-1.4	4	0
-1.4	9	1
0.0	0	0
14.0	1	1
18.0	7	1
2.0	1	1
6.0	1	3
8.0	0	0

# window.sql:87. rowsort: the query has no ORDER BY. Postgres's sum of a
# bigint (wsum) is a numeric; its values print as a BIGINT's do.
query INT,INT,BIGINT,BIGINT rowsort
SELECT ten, two, sum(hundred) AS gsum, sum(sum(hundred)) OVER (PARTITION BY two ORDER BY ten) AS wsum
FROM tenk1 GROUP BY ten, two
