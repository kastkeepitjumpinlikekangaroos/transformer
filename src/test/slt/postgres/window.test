1	sales	1
2	personnel	1
3	sales	2
5	personnel	2
7	develop	1
8	develop	2

# window.sql:1355, its subquery in FROM written as a WITH.
query BIGINT,STRING,INT,BIGINT rowsort
WITH emp AS
  (SELECT empno,
          depname,
          salary,
          count(empno) OVER (PARTITION BY depname ORDER BY salary DESC) c
   FROM empsalary)
SELECT * FROM emp
WHERE c <= 3
----
1	sales	5000	1
10	develop	5200	3
11	develop	5200	3
2	personnel	3900	1
3	sales	4800	3
4	sales	4800	3
5	personnel	3500	2
8	develop	6000	1

# window.sql:1396: a window function with a byref return type, its subquery
# in FROM written as a WITH.
query BIGINT,STRING rowsort
WITH emp AS
  (SELECT row_number() OVER (PARTITION BY salary) AS rn,
          lead(depname) OVER (PARTITION BY salary) || ' Department' AS n_dep
   FROM empsalary)
SELECT * FROM emp
WHERE rn < 1
----

