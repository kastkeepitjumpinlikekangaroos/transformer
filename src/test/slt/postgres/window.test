# window.sql:338: a frame offset as large as a BIGINT. The frame starts
# past its end on every row, so every sum is NULL, whatever order the rows
# are read in.
query BIGINT,INT,INT rowsort
SELECT sum(unique1) over (rows between 9223372036854775807 following and 1 following),
	unique1, four
FROM tenk1 WHERE unique1 < 10
----
NULL	0	0
NULL	1	1
NULL	2	2
NULL	3	3
NULL	4	0
NULL	5	1
NULL	6	2
NULL	7	3
NULL	8	0
NULL	9	1

