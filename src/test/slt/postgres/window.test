          salary,
          dense_rank() OVER (ORDER BY salary DESC) dr
   FROM empsalary)
SELECT * FROM emp
WHERE dr = 1
----
8	6000	1

# window.sql:1270: COUNT(*), its subquery in FROM written as a WITH.
query BIGINT,INT,BIGINT rowsort
WITH emp AS
  (SELECT empno,
          salary,
