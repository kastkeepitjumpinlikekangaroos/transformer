# window.sql:1095: ordering by a non-integer constant is allowed.
skipif transformer # refused by design: a window's ORDER BY key that reads no column orders nothing
query BIGINT rowsort
SELECT rank() OVER (ORDER BY length('abc'))
----
1

# window.sql:1098: can't order by another window function. Postgres: window
# functions are not allowed in window definitions.
statement error
SELECT rank() OVER (ORDER BY rank() OVER (ORDER BY random()))

# window.sql:1101. Postgres: window functions are not allowed in WHERE.
statement error
SELECT * FROM empsalary WHERE row_number() OVER (ORDER BY salary) < 10

# window.sql:1103. Postgres: window functions are not allowed in JOIN
# conditions.
statement error
SELECT * FROM empsalary INNER JOIN tenk1 ON row_number() OVER (ORDER BY salary) < 10

# window.sql:1105. Postgres: window functions are not allowed in GROUP BY.
statement error
SELECT rank() OVER (ORDER BY 1), count(*) FROM empsalary GROUP BY 1

# window.sql:1107. Postgres: syntax error at or near "ORDER".
statement error
SELECT * FROM rank() OVER (ORDER BY random())

# window.sql:1115. Postgres: syntax error at or near "ORDER".
statement error
SELECT rank() OVER (PARTITION BY four, ORDER BY ten) FROM tenk1

# window.sql:1117. Postgres: count(*) must be used to call a parameterless
# aggregate function.
statement error
SELECT count() OVER () FROM tenk1

# window.sql:1211: the three statements that should give the same result,
# each subquery in FROM written as a WITH.
query BIGINT,BIGINT rowsort
WITH emp AS
  (SELECT empno,
          row_number() OVER (ORDER BY empno) rn
   FROM empsalary)
SELECT * FROM emp
WHERE rn < 3
----
1	1
2	2

