----
10	5200	3
11	5200	3
8	6000	1

# window.sql:1327: with a PARTITION BY, its subquery in FROM written as a
# WITH.
query BIGINT,STRING,BIGINT rowsort
WITH emp AS
  (SELECT empno,
          depname,
          row_number() OVER (PARTITION BY depname ORDER BY empno) rn
   FROM empsalary)
SELECT * FROM emp
WHERE rn < 3
