# window.sql:1872. Postgres's avg is a numeric (1.5000000000000000), the
# engine's a DOUBLE; the values are equal.
query INT,DOUBLE rowsort
SELECT i,AVG(CAST(v AS bigint)) OVER (ORDER BY i ROWS BETWEEN CURRENT ROW AND UNBOUNDED FOLLOWING)
  FROM t
----
1	1.5
2	2.0
3	NULL
4	NULL

