# window.sql:1238, its subquery in FROM written as a WITH.
query BIGINT,INT,BIGINT rowsort
WITH emp AS
  (SELECT empno,
          salary,
          rank() OVER (ORDER BY salary DESC) r
   FROM empsalary)
SELECT * FROM emp
WHERE r <= 3
----
