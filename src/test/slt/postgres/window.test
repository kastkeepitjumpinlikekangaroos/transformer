# From PostgreSQL's regression suite (https://github.com/postgres/postgres):
# src/test/regress/sql/window.sql at REL_18_6, commit
# 724edf9bde9d356724ad384a2e196edc3c9f80f7, with every answer from
# src/test/regress/expected/window.out at that commit, never the engine's.
# Portions Copyright (c) 1996-2026, PostgreSQL Global Development Group;
# Portions Copyright (c) 1994, The Regents of the University of California.
# Distributed under the PostgreSQL License, a permissive license whose text
# travels with every copy: it is COPYRIGHT beside this file.
#
# 97 of the file's 400 statements are here: 7 that make, fill or drop a table
# or a view, 81 queries, 8 statements that must fail, and one query the
# engine answers otherwise by design, marked `skipif transformer` with the
# reason. Each record names the line of window.sql it comes from. A statement
# is as Postgres wrote it but where a rewrite cannot change what it means,
# which its record says: a named WINDOW written inline in each OVER, a
# subquery in FROM written as a WITH, x::type as CAST(x AS type), a frame
# offset 2::int8 as 2, int8 as BIGINT, and generate_series() or a VALUES list
# in FROM as a table of its rows, made here. tenk1, tenk2 and int4_tbl are
# test_setup.sql's, tenk1 loaded with COPY from data/tenk.data, Postgres's
# file of its 10,000 rows.
#
# A result Postgres printed in no fixed order, or in an order its ORDER BY
# leaves tied, is compared as rowsort. Where Postgres's type differs from the
# engine's by design and the value does not (avg of an integer is a numeric
# there, a DOUBLE here), the value is written as the engine's type prints it,
# and the record says so. VAR_POP, VAR_SAMP, VARIANCE and the STDDEVs are
# DOUBLEs in the engine and numerics in Postgres, and are compared as SQLite's
# R, to three places.
#
# Left out (303 statements), by what they need:
#   58  FIRST_VALUE, LAST_VALUE, NTH_VALUE, NTILE, PERCENT_RANK or CUME_DIST
#   49  EXPLAIN, whose answer is Postgres's plan
#   49  RANGE over an INTERVAL, TIME, TIMETZ or TIMESTAMPTZ, or those types
#   35  user-defined functions, aggregates and window functions
#   32  an EXCLUDE clause
#   30  a GROUPS frame
#    9  SMALLINT or MONEY
#    9  pg_get_viewdef(), SET or RESET
#    8  a ROWS frame, or ROW_NUMBER over ties, on rows in no fixed order,
#       whose answer is the order Postgres happened to read them in
#    5  EXTRACT, FILTER, to_char(), bool_and()/bool_or() or array_agg()
#    5  a named WINDOW that, written inline, is another record's query or no
#       window at all, or a WINDOW clause defining a name twice
#    4  a LAG offset or a frame offset read from a column
#    3  float4, and numeric Infinity and NaN, which no DECIMAL holds
#    3  the errors of functions the engine lacks (generate_series() with
#       OVER, ntile(0), nth_value(x, 0))
#    2  a subquery
#    2  a DELETE with a window function, which the runner, not the engine,
#       carries out

statement ok
CREATE TEMPORARY TABLE empsalary (
    depname varchar,
    empno bigint,
    salary int,
    enroll_date date
)

statement ok
INSERT INTO empsalary VALUES
('develop', 10, 5200, '2007-08-01'),
('sales', 1, 5000, '2006-10-01'),
('personnel', 5, 3500, '2007-12-10'),
('sales', 4, 4800, '2007-08-08'),
('personnel', 2, 3900, '2006-12-23'),
('develop', 7, 4200, '2008-01-01'),
('develop', 9, 4500, '2008-01-01'),
('sales', 3, 4800, '2007-08-01'),
('develop', 8, 6000, '2006-10-01'),
('develop', 11, 5200, '2007-08-15')

# tenk1 and int4_tbl as test_setup.sql creates them, int4 written INT and name
# STRING, and tenk1 loaded with COPY from data/tenk.data, as test_setup.sql
# loads it. test_setup.sql fills int4_tbl from strings ('   0  '), written
# here as the numbers. tenk2 is its copy of tenk1.
statement ok
CREATE TABLE tenk1 (
    unique1     INT,
    unique2     INT,
    two         INT,
    four        INT,
    ten         INT,
    twenty      INT,
    hundred     INT,
    thousand    INT,
    twothousand INT,
    fivethous   INT,
    tenthous    INT,
    odd         INT,
    even        INT,
    stringu1    STRING,
    stringu2    STRING,
    string4     STRING
)

statement ok
COPY tenk1 FROM 'data/tenk.data'

statement ok
CREATE TABLE tenk2 AS SELECT * FROM tenk1

statement ok
CREATE TABLE INT4_TBL(f1 INT)

statement ok
INSERT INTO INT4_TBL(f1) VALUES
  (0),
  (123456),
  (-123456),
  (2147483647),
  (-2147483647)

# window.sql:24. rowsort: the ORDER BY leaves ties (develop's two 5200s,
# sales's two 4800s).
query STRING,BIGINT,INT,BIGINT rowsort
SELECT depname, empno, salary, sum(salary) OVER (PARTITION BY depname) FROM empsalary ORDER BY depname, salary
----
develop	10	5200	25100
develop	11	5200	25100
develop	7	4200	25100
develop	8	6000	25100
develop	9	4500	25100
personnel	2	3900	7400
personnel	5	3500	7400
sales	1	5000	14600
sales	3	4800	14600
sales	4	4800	14600

# window.sql:26
query STRING,BIGINT,INT,BIGINT rowsort
SELECT depname, empno, salary, rank() OVER (PARTITION BY depname ORDER BY salary) FROM empsalary
----
develop	10	5200	3
develop	11	5200	3
develop	7	4200	1
develop	8	6000	5
develop	9	4500	2
personnel	2	3900	2
personnel	5	3500	1
sales	1	5000	3
sales	3	4800	1
sales	4	4800	1

# window.sql:29. Postgres's sum of a bigint is a numeric, and its avg of an
# integer (it prints 0.00000000000000000000 and 2.0000000000000000); the
# engine's are a BIGINT and a DOUBLE, and the values are equal.
query INT,INT,BIGINT,DOUBLE nosort
SELECT four, ten, SUM(SUM(four)) OVER (PARTITION BY four), AVG(ten) FROM tenk1
GROUP BY four, ten ORDER BY four, ten
