# window.sql:1060. Postgres: RANGE with offset PRECEDING/FOLLOWING requires
# exactly one ORDER BY column.
statement error
select f1, sum(f1) over (partition by f1
                         range between 1 preceding and 1 following)
from t1 where f1 = f2

