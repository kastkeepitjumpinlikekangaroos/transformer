# numeric.sql:518: addition check.
statement ok
DELETE FROM num_result

statement ok
INSERT INTO num_result SELECT t1.id, t2.id, t1.val + t2.val
    FROM num_data t1, num_data t2

query INT,INT,DECIMAL(38,10),DECIMAL(38,10) rowsort
SELECT t1.id1, t1.id2, t1.result, t2.expected
    FROM num_result t1, num_exp_add t2
    WHERE t1.id1 = t2.id1 AND t1.id2 = t2.id2
    AND t1.result != t2.expected
----

statement ok
DELETE FROM num_result

statement ok
INSERT INTO num_result SELECT t1.id, t2.id, round(t1.val + t2.val, 10)
    FROM num_data t1, num_data t2

# numeric.sql:526
query INT,INT,DECIMAL(38,10),DECIMAL(38,10) rowsort
SELECT t1.id1, t1.id2, t1.result, round(t2.expected, 10) as expected
    FROM num_result t1, num_exp_add t2
    WHERE t1.id1 = t2.id1 AND t1.id2 = t2.id2
    AND t1.result != round(t2.expected, 10)
----

# numeric.sql:537: subtraction check.
statement ok
DELETE FROM num_result

statement ok
INSERT INTO num_result SELECT t1.id, t2.id, t1.val - t2.val
    FROM num_data t1, num_data t2

query INT,INT,DECIMAL(38,10),DECIMAL(38,10) rowsort
SELECT t1.id1, t1.id2, t1.result, t2.expected
    FROM num_result t1, num_exp_sub t2
    WHERE t1.id1 = t2.id1 AND t1.id2 = t2.id2
    AND t1.result != t2.expected
----

statement ok
DELETE FROM num_result

statement ok
INSERT INTO num_result SELECT t1.id, t2.id, round(t1.val - t2.val, 40)
    FROM num_data t1, num_data t2

# numeric.sql:545
query INT,INT,DECIMAL(38,10),DECIMAL(38,10) rowsort
SELECT t1.id1, t1.id2, t1.result, round(t2.expected, 40)
    FROM num_result t1, num_exp_sub t2
    WHERE t1.id1 = t2.id1 AND t1.id2 = t2.id2
    AND t1.result != round(t2.expected, 40)
----

# numeric.sql:556: multiply check. Postgres rounds each product to ten
# places as it stores it in num_result's numeric(210,10) column; the runner
# stores only a value its column holds exactly, so the INSERT's SELECT says
# the rounding, ROUND(..., 10), which rounds half away from zero as the
# column does.
statement ok
DELETE FROM num_result

statement ok
INSERT INTO num_result SELECT t1.id, t2.id, round(t1.val * t2.val, 10)
    FROM num_data t1, num_data t2

query INT,INT,DECIMAL(38,10),DECIMAL(38,10) rowsort
SELECT t1.id1, t1.id2, t1.result, t2.expected
    FROM num_result t1, num_exp_mul t2
    WHERE t1.id1 = t2.id1 AND t1.id2 = t2.id2
    AND t1.result != t2.expected
----

# numeric.sql:564, the storing rounding said as in the record before.
statement ok
DELETE FROM num_result

statement ok
INSERT INTO num_result SELECT t1.id, t2.id, round(round(t1.val * t2.val, 30), 10)
    FROM num_data t1, num_data t2

query INT,INT,DECIMAL(38,10),DECIMAL(38,10) rowsort
SELECT t1.id1, t1.id2, t1.result, round(t2.expected, 30) as expected
    FROM num_result t1, num_exp_mul t2
    WHERE t1.id1 = t2.id1 AND t1.id2 = t2.id2
    AND t1.result != round(t2.expected, 30)
----

# numeric.sql:576: division check, the storing rounding said as for
# the products, and '0.0' written 0.0 (a DECIMAL reads no string literal).
statement ok
DELETE FROM num_result

statement ok
INSERT INTO num_result SELECT t1.id, t2.id, round(t1.val / t2.val, 10)
    FROM num_data t1, num_data t2
    WHERE t2.val != 0.0

