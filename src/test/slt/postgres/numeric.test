# numeric.sql:754: numeric AVG used to fail on some platforms. Postgres
# prints -13430913.592242320700; the engine's AVG of a DECIMAL(18,10) is a
# DECIMAL(22,14); the values are equal.
query DECIMAL(22,14)
SELECT AVG(val) FROM num_data
----
-13430913.59224232070000

# numeric.sql:755
query DECIMAL(18,10)
SELECT MAX(val) FROM num_data
----
7799461.4119000000

# numeric.sql:756
query DECIMAL(18,10)
SELECT MIN(val) FROM num_data
----
-83028485.0000000000

# numeric.sql:757. STDDEV and VARIANCE are DOUBLEs in the engine,
# numerics in Postgres: compared as SQLite's R, to three places.
query R
SELECT STDDEV(val) FROM num_data
----
27791203.288

# numeric.sql:758
skipif transformer # VARIANCE is a DOUBLE, which at 7.7e14 holds no third decimal place (its nearest is 772350980172061.75)
query R
SELECT VARIANCE(val) FROM num_data
----
772350980172061.697

# numeric.sql:777: conversion to integers, each ::int8 and ::int4 written
# as a CAST. Postgres reads -9223372036854775808.5 as a numeric and rounds it
# to -9223372036854775809, past BIGINT.
skipif transformer # the number is a DOUBLE, -2^63 exactly, and a CAST to an integer truncates, so no error
statement error
SELECT CAST((-9223372036854775808.5) AS BIGINT)

# numeric.sql:778
query BIGINT
SELECT CAST((-9223372036854775808.4) AS BIGINT)
