# From PostgreSQL's regression suite (https://github.com/postgres/postgres):
# src/test/regress/sql/numeric.sql at REL_18_6, commit
# 724edf9bde9d356724ad384a2e196edc3c9f80f7, with every answer from
# src/test/regress/expected/numeric.out at that commit, never the engine's.
# Portions Copyright (c) 1996-2026, PostgreSQL Global Development Group;
# Portions Copyright (c) 1994, The Regents of the University of California.
# Distributed under the PostgreSQL License, a permissive license whose text
# travels with every copy: it is COPYRIGHT beside this file.
#
# The part of the file a DECIMAL of at most 38 digits can run: the checks of
# addition, subtraction, multiplication and division against bc(1)'s answers
# over num_data, the aggregates of num_data, conversion to integers, CEIL,
# FLOOR and ROUND, the corner cases of division, and EXP, LN and LOG of
# numbers written with a point. 475 of the file's 1,058 statements are here
# (390 of its single-row INSERTs as five INSERTs of their rows), and each
# record names the line of numeric.sql it comes from. A statement is as
# Postgres wrote it but where a rewrite cannot change what it means, which its
# record says: x::type as CAST(x AS type), a number written as a string
# ('4.31') as the number, a ::numeric on a number past BIGINT left out (it is
# a DECIMAL in the engine), a value an INSERT stores as Postgres stores it,
# rounded to its column's ten places (in num_exp_mul and num_exp_div, and by
# ROUND(..., 10) in the INSERTs into num_result), and log(x), Postgres's
# base-10 logarithm, as log10(x). The engine has no unconstrained numeric and
# no numeric(210,10), so each such column is a DECIMAL whose record says
# which.
#
# Where Postgres's type differs from the engine's by design and the value does
# not, the value is written as the engine's type prints it, and the record
# says so: a DECIMAL's scale is its type's (Spark's and SQL Server's rules),
# where Postgres's numeric keeps the scale each value has, and a number written
# with a point is a DOUBLE in the engine. EXP, LN, LOG and the statistics,
# DOUBLEs in the engine and numerics in Postgres, are compared as SQLite's R,
# to three places. `skipif transformer` marks the 9 records the engine
# answers otherwise by design, each with the reason.
#
# Left out (583 statements), by what they need:
#  101  to_char(), to_number() or lc_numeric
#   61  numeric input syntax (strings with spaces, underscores, hex) or
#       pg_input_is_valid()
#   56  the SQRT, LN, LOG10 and POWER(10, LN(x)) checks: bc's answers to
#       200 places, which the engine's DOUBLE functions do not reach
#   52  numeric Infinity and NaN, which no DECIMAL holds, with div() and
#       numeric_inc()
#   51  a cast to numeric, for which the engine has no CAST, or the ^ operator
#   32  scale(), min_scale() or trim_scale()
#   30  width_bucket()
#   28  transaction control, indexes and VACUUM, which change no answer
#   23  VARIANCE() of numbers near 1e-500 and 9e131071, past 38 digits, and
#       parallel-worker settings
#   22  numbers past 38 digits
#   22  casts between numerics and float4 or float8 Infinity and NaN, and to
#       and from int2
#   20  the quotients by zero bc wrote as NaN, which no query below reads
#   18  negative and narrow typmods (num_typemod_test)
#   16  generate_series()
#   14  INSERTs Postgres rounds or refuses as it stores them (fract_only),
#       which the runner, not the engine, carries out
#   14  gcd(), lcm(), factorial() or pg_lsn()
#    9  div()
#    4  SMALLINT
#   10  answered otherwise by the engine, not by a documented decision, and
#       held out until that is settled: LN and LOG of zero or a negative
#       number and LOG to base 1, which Postgres refuses and the engine
#       answers with NaN or an infinity

# numeric.sql:5-15, the tables the checks below read. Each numeric(210,10)
# column is a DECIMAL(38,10), the widest a DECIMAL holds at the same scale,
# but num_data's values, which the checks add, subtract, multiply and divide,
# are a DECIMAL(18,10), the narrowest that holds every one of them: a product
# or quotient of two DECIMAL(38,10)s gives way on scale to six places.
statement ok
CREATE TABLE num_data (id int, val DECIMAL(18,10))

statement ok
CREATE TABLE num_exp_add (id1 int, id2 int, expected DECIMAL(38,10))

statement ok
CREATE TABLE num_exp_sub (id1 int, id2 int, expected DECIMAL(38,10))

statement ok
CREATE TABLE num_exp_div (id1 int, id2 int, expected DECIMAL(38,10))

statement ok
CREATE TABLE num_exp_mul (id1 int, id2 int, expected DECIMAL(38,10))

statement ok
CREATE TABLE num_result (id1 int, id2 int, result DECIMAL(38,10))

# numeric.sql:23-484: the expected results bc(1) computed, each
# table's INSERTs written as one INSERT of their rows, each value as a number
# rather than a string, and as Postgres stores it in its numeric(210,10)
# column: 24 products and 56 quotients rounded half away from zero to ten
# places, since the runner stores a value only where its column holds it
# exactly. The 20 quotients by zero, NaN, are left out: no DECIMAL holds NaN,
# and the division check below reads none of them.
statement ok
