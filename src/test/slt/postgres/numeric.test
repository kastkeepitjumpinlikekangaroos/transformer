# numeric.sql:815: ceil(), floor() and round(). The unconstrained numeric
# column is a DECIMAL(10,7), the scale of its most precise value, and each
# string inserted is written as the number it is. Postgres prints each a at
# the scale it was written with (-5.5); the DECIMAL(10,7) column prints
# -5.5000000; the values are equal.
statement ok
CREATE TABLE ceil_floor_round (a DECIMAL(10,7))

statement ok
INSERT INTO ceil_floor_round VALUES (-5.5)

statement ok
INSERT INTO ceil_floor_round VALUES (-5.499999)

statement ok
INSERT INTO ceil_floor_round VALUES (9.5)

statement ok
INSERT INTO ceil_floor_round VALUES (9.4999999)

statement ok
INSERT INTO ceil_floor_round VALUES (0.0)

statement ok
INSERT INTO ceil_floor_round VALUES (0.0000001)

statement ok
INSERT INTO ceil_floor_round VALUES (-0.000001)

query DECIMAL(10,7),DECIMAL(4,0),DECIMAL(4,0),DECIMAL(4,0),DECIMAL(4,0) rowsort
SELECT a, ceil(a), ceiling(a), floor(a), round(a) FROM ceil_floor_round
----
-0.0000010	0	0	-1	0
-5.4999990	-5	-5	-6	-5
-5.5000000	-5	-5	-6	-6
0.0000000	0	0	0	0
0.0000001	1	1	0	0
9.4999999	10	10	9	9
9.5000000	10	10	9	10

statement ok
DROP TABLE ceil_floor_round

# numeric.sql:1248: corner cases for division, each ::numeric on a
# number past BIGINT left out, since the number is a numeric in Postgres and a
# DECIMAL in the engine without it. Postgres prints 1.00000000000000000000;
# the engine's quotient is a DECIMAL(38,17), whose scale its type rules
# choose; the values are equal.
query DECIMAL(38,17)
select 999999999999999999999/1000000000000000000000
----
1.00000000000000000

# numeric.sql:1250
query DECIMAL(21,0)
select mod(999999999999999999999,1000000000000000000000)
----
999999999999999999999

# numeric.sql:1252
query DECIMAL(22,0)
select mod(-9999999999999999999999,1000000000000000000000)
----
-999999999999999999999

# numeric.sql:1254. 70.0 is a numeric in Postgres and a DOUBLE in the
# engine; 0.0 prints the same.
query DOUBLE
select mod (70.0,70)
----
0.0

# numeric.sql:1256. Postgres prints 1.00000000000000000000, a numeric;
# the engine's quotient is a DOUBLE; the values are equal.
query DOUBLE
select 70.0 / 70
----
1.0

# numeric.sql:1257
query DECIMAL(3,0)
select 12345678901234567890 % 123
----
78

# numeric.sql:1258. Postgres's quotient rounds to an integer.
skipif transformer # the DECIMAL quotient's type keeps six places: 100371373180768844.634146
query DECIMAL(26,6)
select 12345678901234567890 / 123
----
100371373180768845.000000

