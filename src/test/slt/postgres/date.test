# From PostgreSQL's regression suite (https://github.com/postgres/postgres):
# src/test/regress/sql/date.sql at REL_18_6, commit
# 724edf9bde9d356724ad384a2e196edc3c9f80f7, with every answer from
# src/test/regress/expected/date.out at that commit, never the engine's.
# Portions Copyright (c) 1996-2026, PostgreSQL Global Development Group;
# Portions Copyright (c) 1994, The Regents of the University of California.
# Distributed under the PostgreSQL License, a permissive license whose text
# travels with every copy: it is COPYRIGHT beside this file.
#
# DATE: a table of ISO dates, one before year 1, compared with ISO literals,
# and the text Postgres reads as a date under each DateStyle field order (YMD,
# DMY, MDY), which the engine reads only as an ISO date, and the ends of
# Postgres's date range. 126 of the file's 271 statements are here, each
# record naming the line of date.sql it comes from: 17 that make or fill the
# table, 15 queries and 10 statements that must fail, answered as Postgres
# answers them, and 84 queries the engine answers otherwise by design, below.
# Postgres prints a date as MM-DD-YYYY under its first DateStyle (Postgres,
# MDY) and as ISO after SET datestyle; each is written as the engine prints
# it, ISO, a year before 1 as ISO 8601's astronomical year (1 BC is 0000).
#
# A statement is as Postgres wrote it but where a rewrite cannot change what
# it means, which its record says: date as DATE, a string an INSERT stores
# written as the date it is in ISO form ('2040-04-10 BC' as '-2039-04-10'),
# and one Postgres refuses as CAST('...' AS DATE), the conversion Postgres
# makes of it, so the engine reads the text, not the runner. The settings of
# DateStyle are left out; the records under each are kept, and say which.
#
# `skipif transformer date-text-iso` marks the 84 queries whose text Postgres
# reads as a date and the engine does not, by that rule of the ledger in
# docs/gotchas.md: text casts to DATE from an ISO date alone, a year past 9999
# or before 1 with a sign, where Postgres reads its DateStyle's formats
# ('January 8, 1999', '1/8/1999', '19990108', '1999.008', 'J2451187') and BC
# after a year. After each, its twin, `onlyif transformer date-text-iso`, is
# the same statement with the engine's own answer, an error naming the text.
# A text no date in either grammar is an error in both (Postgres: invalid
# input syntax), and so is 1997-02-29.
#
# Left out (114 statements), by what they need:
#   71  date_part() and EXTRACT
#   10  date_trunc()
#   10  make_date() and make_time()
#    8  a DATE minus a DATE, over the special values epoch, today, yesterday
#       and tomorrow
#    5  SET and RESET of DateStyle
#    5  pg_input_is_valid() and pg_input_error_info()
#    5  the dates infinity and -infinity, which a DATE does not hold
#
# Held out (31 statements), both engines refusing them for different
# reasons: text in a DateStyle format that Postgres reads and finds a field
# out of range in (1/8/1999 under YMD, 08-01-1999 under YMD), and the dates
# one past each end of Postgres's range (4714-11-23 BC, 5874898-01-01), which
# the engine refuses as no ISO date. docs/gotchas.md lists them.

# date.sql:5
statement ok
CREATE TABLE DATE_TBL (f1 date)

# date.sql:7
statement ok
INSERT INTO DATE_TBL VALUES ('1957-04-09')

# date.sql:8
statement ok
INSERT INTO DATE_TBL VALUES ('1957-06-13')

# date.sql:9
statement ok
INSERT INTO DATE_TBL VALUES ('1996-02-28')

# date.sql:10
statement ok
INSERT INTO DATE_TBL VALUES ('1996-02-29')

# date.sql:11
statement ok
INSERT INTO DATE_TBL VALUES ('1996-03-01')

# date.sql:12
statement ok
INSERT INTO DATE_TBL VALUES ('1996-03-02')

# date.sql:13
statement ok
INSERT INTO DATE_TBL VALUES ('1997-02-28')

# date.sql:14: a date that does not exist, written CAST('...' AS DATE), the
# conversion Postgres makes of it as it stores it, so the engine reads the
# text, not the runner. Postgres: date/time field value out of range:
# "1997-02-29".
statement error
INSERT INTO DATE_TBL VALUES (CAST('1997-02-29' AS DATE))

# date.sql:15
statement ok
INSERT INTO DATE_TBL VALUES ('1997-03-01')

# date.sql:16
statement ok
INSERT INTO DATE_TBL VALUES ('1997-03-02')

# date.sql:17
statement ok
INSERT INTO DATE_TBL VALUES ('2000-04-01')

# date.sql:18
statement ok
INSERT INTO DATE_TBL VALUES ('2000-04-02')

# date.sql:19
statement ok
INSERT INTO DATE_TBL VALUES ('2000-04-03')

# date.sql:20
statement ok
INSERT INTO DATE_TBL VALUES ('2038-04-08')

# date.sql:21
statement ok
INSERT INTO DATE_TBL VALUES ('2039-04-09')

# date.sql:22
statement ok
INSERT INTO DATE_TBL VALUES ('2040-04-10')

# date.sql:23: '2040-04-10 BC' written as the same date in ISO 8601, whose
# year 0 is 1 BC, so -2039 is 2040 BC: the stored value, which the runner
# reads only as ISO text.
statement ok
INSERT INTO DATE_TBL VALUES ('-2039-04-10')

# date.sql:25
query DATE rowsort
SELECT f1 FROM DATE_TBL
----
-2039-04-10
1957-04-09
1957-06-13
1996-02-28
1996-02-29
1996-03-01
1996-03-02
1997-02-28
1997-03-01
1997-03-02
2000-04-01
2000-04-02
2000-04-03
2038-04-08
2039-04-09
2040-04-10

# date.sql:27
query DATE rowsort
SELECT f1 FROM DATE_TBL WHERE f1 < '2000-01-01'
----
-2039-04-10
1957-04-09
1957-06-13
1996-02-28
1996-02-29
1996-03-01
1996-03-02
1997-02-28
1997-03-01
1997-03-02

# date.sql:29
query DATE rowsort
SELECT f1 FROM DATE_TBL
  WHERE f1 BETWEEN '2000-01-01' AND '2001-01-01'
----
2000-04-01
2000-04-02
2000-04-03

