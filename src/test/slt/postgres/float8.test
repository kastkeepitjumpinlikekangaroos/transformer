# CAST('Infinity' AS DOUBLE).
query DOUBLE,DOUBLE,DOUBLE
SELECT exp(CAST('Infinity' AS DOUBLE)), exp(CAST('-Infinity' AS DOUBLE)), exp(CAST('NaN' AS DOUBLE))
----
Infinity	0.0	NaN

