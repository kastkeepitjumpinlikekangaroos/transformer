# float8.sql:114: sign, an INT in the engine and a float8 in Postgres
# (0, 1, -1, 1, 1); the values are equal.
query INT rowsort
select sign(f1) as sign_f1 from float8_tbl f
----
-1
0
1
1
1

# float8.sql:120: square root, float8 '64' written CAST('64' AS DOUBLE).
# From here to float8.sql:235 Postgres prints 15 significant digits, and a
# computed value is compared as SQLite's T, to the same 15.
query T
SELECT sqrt(CAST('64' AS DOUBLE)) AS eight
----
8.0

# float8.sql:122, |/ written SQRT.
query T
SELECT SQRT(CAST('64' AS DOUBLE)) AS eight
----
8.0

# float8.sql:124, |/f.f1 written SQRT(f.f1).
query DOUBLE,T rowsort
SELECT f.f1, SQRT(f.f1) AS sqrt_f1
   FROM FLOAT8_TBL f
   WHERE f.f1 > '0.0'
----
1.2345678901234E-200	1.11111110611109e-100
1.2345678901234E200	1.11111110611109e+100
1004.3	31.6906926399535

# float8.sql:129: power, each float8 'x' written CAST('x' AS DOUBLE), and
# 'inf' written 'Infinity'. A power of finite numbers is compared as SQLite's
# T; each special case's value is exact.
query T
SELECT power(CAST('144' AS DOUBLE), CAST('0.5' AS DOUBLE))
----
12.0

