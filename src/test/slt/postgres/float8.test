# float8.sql:158, the string '0' read as the DOUBLE beside it, as Postgres
# reads it. Postgres tests only that the power is zero, since one compiler
# got its sign wrong.
query BOOLEAN
SELECT power(CAST('-Infinity' AS DOUBLE), CAST('-2' AS DOUBLE)) = '0'
----
true

