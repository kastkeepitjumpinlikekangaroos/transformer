# float8.sql:182
statement ok
UPDATE FLOAT8_TBL
   SET f1 = FLOAT8_TBL.f1 * '-1'
   WHERE FLOAT8_TBL.f1 > '0.0'

# float8.sql:186. Postgres: value out of range: overflow.
skipif transformer # arithmetic past DOUBLE's range is an infinity, not an error
statement error
SELECT f.f1 * '1e200' from FLOAT8_TBL f

# float8.sql:188, f.f1 ^ '1e200' written POWER(f.f1, CAST('1e200' AS DOUBLE)).
# Postgres: value out of range: overflow.
skipif transformer # a power past DOUBLE's range is an infinity, and one too small for it 0, not an error
statement error
SELECT POWER(f.f1, CAST('1e200' AS DOUBLE)) from FLOAT8_TBL f

# float8.sql:190, x ^ y written POWER(x, y). Postgres reads 0 ^ 0 and 0 ^ 1
# as float8s, 0 ^ 0.0 and 0 ^ 0.5 as numerics and their sum as a float8; in
# the engine each is a DOUBLE.
query DOUBLE
SELECT POWER(0, 0) + POWER(0, 1) + POWER(0, 0.0) + POWER(0, 0.5)
----
2.0

# float8.sql:192. Postgres: cannot take logarithm of zero.
skipif transformer # a logarithm of zero or less is NULL, as a division by zero is
statement error
SELECT ln(f.f1) from FLOAT8_TBL f where f.f1 = '0.0'

# float8.sql:194. Postgres: cannot take logarithm of a negative number.
skipif transformer # a logarithm of zero or less is NULL, as a division by zero is
statement error
SELECT ln(f.f1) from FLOAT8_TBL f where f.f1 < '0.0'

# float8.sql:196. Postgres: value out of range: underflow.
skipif transformer # a result too small for a DOUBLE is 0, not an error, as one past its range is an infinity
statement error
SELECT exp(f.f1) from FLOAT8_TBL f

# float8.sql:198. Postgres: division by zero.
skipif transformer # a division by zero is NULL
statement error
SELECT f.f1 / '0.0' from FLOAT8_TBL f

