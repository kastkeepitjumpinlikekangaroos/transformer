# float8.sql:167: exp of ln.
query DOUBLE,T rowsort
SELECT f.f1, exp(ln(f.f1)) AS exp_ln_f1
   FROM FLOAT8_TBL f
   WHERE f.f1 > '0.0'
----
1.2345678901234E-200	1.23456789012339e-200
1.2345678901234E200	1.23456789012338e+200
1004.3	1004.3

