# From PostgreSQL's regression suite (https://github.com/postgres/postgres):
# src/test/regress/sql/float8.sql at REL_18_6, commit
# 724edf9bde9d356724ad384a2e196edc3c9f80f7, with every answer from
# src/test/regress/expected/float8.out at that commit, never the engine's.
# Portions Copyright (c) 1996-2026, PostgreSQL Global Development Group;
# Portions Copyright (c) 1994, The Regents of the University of California.
# Distributed under the PostgreSQL License, a permissive license whose text
# travels with every copy: it is COPYRIGHT beside this file.
#
# The DOUBLE, Postgres's float8, at its edges: the text a CAST reads, the
# infinities and NaN in arithmetic, POWER's special cases, the rounding
# functions, the hyperbolic functions, and casts to integers at the ends of
# their ranges. 127 of the file's 184 statements are here: 8 that make, fill,
# change or drop a table, 83 queries, 21 statements that must fail, and 15
# records the engine answers otherwise by design, marked `skipif transformer`
# with the reason. Each record names the line of float8.sql it comes from.
#
# A statement is as Postgres wrote it but where a rewrite cannot change what
# it means, which its record says: float8 as DOUBLE, int4 and int8 as INT and
# BIGINT, x::float8 and float8 'x' as CAST(x AS DOUBLE), Postgres's operators
# |/ x, ||/ x, @ x and x ^ y as SQRT(x), CBRT(x), ABS(x) and POWER(x, y) (a
# string beside ^ as the float8 Postgres reads it as, since the engine's
# functions take no text), and Postgres's other spellings of the infinities
# and NaN ('inf', 'infinity', 'nan') as Infinity and NaN where the test is of
# what is done with the value rather than of how it is spelled. A string an
# INSERT stores in the float8 column is written as the number it spells,
# which Postgres reads, spaces and all; one Postgres refuses is written
# CAST('...' AS DOUBLE), the conversion Postgres makes of it, so the engine
# reads the text, not the runner, which stores no text in a DOUBLE column.
# test_setup.sql's float8_tbl, which the file's temporary table hides until
# the file drops it, is made after the DROP.
#
# A float8 Postgres prints in full, the shortest text that reads back as the
# same double, is compared exactly, as Java's Double.toString prints a DOUBLE
# (1004.3, 1.2345678901234E200, -10.0, -0.0). From float8.sql:117 to 235
# Postgres prints 15 significant digits (extra_float_digits 0, C's %.15g), so
# a value a function computes there (SQRT, CBRT, EXP of LN, POWER of finite
# numbers, SINH, COSH and TANH) is compared as SQLite's T, which prints a
# DOUBLE to the same 15 digits (SQLite's %!.15g, which writes a whole number
# with .0 after it); the values there that are exact by definition, the
# table's rows and the infinities, NaNs, zeros and ones that a function's
# special cases are, are compared exactly. The one other function result,
# POWER at float8.sql:91, comes from C's libm in Postgres, whose last digit
# Java's need not share, so it is compared as SQLite's R, to three places. A
# result in no fixed order is compared as rowsort. SIGN is an INT in the
# engine and a float8 in Postgres; its values are written as the INT prints
# them.
#
# `skipif transformer` marks what the engine answers otherwise by design,
# with the reason: text casts to DOUBLE by CSV's grammar, which takes NaN,
# Infinity and -Infinity as written and no spaces around a number (4); a
# division by zero, a logarithm of zero or less and a power with no real
# answer are NULL, which Postgres refuses (6); arithmetic past DOUBLE's range
# is an infinity, and a result too small for it 0, not an error (3); and a
# CAST to an integer truncates, where Postgres rounds (2).
#
# Left out (57 statements), by what they need:
#   12  gamma() and lgamma()
#   12  a type of the test's own, xfloat8, with its functions and casts, made
#       to read bit patterns as float8s, the two queries over them, which also
#       need float8send(), and the DROP
#   11  asinh(), acosh() and atanh()
#    6  sind(), cosd(), tand(), cotd(), asind(), acosd(), atand() and
#       atan2d(), over generate_series() or a VALUES list
#    5  SET and RESET of extra_float_digits, which say how Postgres prints a
#       float8 (above)
#    4  pg_input_is_valid() and pg_input_error_info()
#    4  SMALLINT
#    1  erf() and erfc()
#    1  float8send()
#    1  numeric NaN, which no DECIMAL holds

# float8.sql:10, float8 written DOUBLE.
statement ok
CREATE TEMP TABLE FLOAT8_TBL(f1 DOUBLE)

# float8.sql:12, each string of these INSERTs written as the number it
# spells: Postgres reads '    0.0   ', spaces and all.
statement ok
INSERT INTO FLOAT8_TBL(f1) VALUES (0.0)

# float8.sql:13, '1004.30  '
statement ok
INSERT INTO FLOAT8_TBL(f1) VALUES (1004.30)

# float8.sql:14, '   -34.84'
statement ok
INSERT INTO FLOAT8_TBL(f1) VALUES (-34.84)

# float8.sql:15
statement ok
INSERT INTO FLOAT8_TBL(f1) VALUES (1.2345678901234e+200)

# float8.sql:16
statement ok
INSERT INTO FLOAT8_TBL(f1) VALUES (1.2345678901234e-200)

# float8.sql:19: text past DOUBLE's range, and text too small for it, each
# '...'::float8 written CAST('...' AS DOUBLE). Postgres: "10e400" is out of
# range for type double precision.
statement error
SELECT CAST('10e400' AS DOUBLE)

# float8.sql:20. Postgres: "-10e400" is out of range for type double
# precision.
statement error
SELECT CAST('-10e400' AS DOUBLE)

# float8.sql:21. Postgres: "10e-400" is out of range for type double
# precision.
statement error
SELECT CAST('10e-400' AS DOUBLE)

# float8.sql:22. Postgres: "-10e-400" is out of range for type double
# precision.
statement error
SELECT CAST('-10e-400' AS DOUBLE)

# float8.sql:28: bad input. Each string, which Postgres refuses to store in
# the float8 column, written CAST('...' AS DOUBLE), the conversion Postgres
# makes of it. Postgres: invalid input syntax for type double precision: "".
statement error
INSERT INTO FLOAT8_TBL(f1) VALUES (CAST('' AS DOUBLE))

# float8.sql:29. Postgres: invalid input syntax for type double precision:
# "     ".
statement error
INSERT INTO FLOAT8_TBL(f1) VALUES (CAST('     ' AS DOUBLE))

# float8.sql:30. Postgres: invalid input syntax for type double precision:
# "xyz".
statement error
INSERT INTO FLOAT8_TBL(f1) VALUES (CAST('xyz' AS DOUBLE))

# float8.sql:31. Postgres: invalid input syntax for type double precision:
# "5.0.0".
statement error
INSERT INTO FLOAT8_TBL(f1) VALUES (CAST('5.0.0' AS DOUBLE))

# float8.sql:32. Postgres: invalid input syntax for type double precision:
# "5 . 0".
statement error
INSERT INTO FLOAT8_TBL(f1) VALUES (CAST('5 . 0' AS DOUBLE))

# float8.sql:33. Postgres: invalid input syntax for type double precision:
# "5.   0".
statement error
INSERT INTO FLOAT8_TBL(f1) VALUES (CAST('5.   0' AS DOUBLE))

# float8.sql:34. Postgres: invalid input syntax for type double precision:
# "    - 3".
statement error
INSERT INTO FLOAT8_TBL(f1) VALUES (CAST('    - 3' AS DOUBLE))

# float8.sql:35. Postgres: invalid input syntax for type double precision:
# "123           5".
statement error
INSERT INTO FLOAT8_TBL(f1) VALUES (CAST('123           5' AS DOUBLE))

# float8.sql:44: special inputs.
query DOUBLE
SELECT CAST('NaN' AS DOUBLE)
----
NaN

# float8.sql:45. The engine casts text to DOUBLE by the grammar CSV reads a
# number by, which takes the words NaN, Infinity and -Infinity as the CSV
# writer writes them, and no spaces around a number, so Postgres's other
# spellings are errors there by design.
skipif transformer # text casts to DOUBLE by CSV's grammar, which spells it NaN
query DOUBLE
SELECT CAST('nan' AS DOUBLE)
----
NaN

# float8.sql:46
skipif transformer # text casts to DOUBLE by CSV's grammar, which spells it NaN, with no spaces around
query DOUBLE
SELECT CAST('   NAN  ' AS DOUBLE)
----
NaN

# float8.sql:47
skipif transformer # text casts to DOUBLE by CSV's grammar, which spells it Infinity
query DOUBLE
SELECT CAST('infinity' AS DOUBLE)
----
Infinity

# float8.sql:48
skipif transformer # text casts to DOUBLE by CSV's grammar, which spells it -Infinity, with no spaces around
query DOUBLE
SELECT CAST('          -INFINiTY   ' AS DOUBLE)
----
-Infinity

# float8.sql:50: bad special inputs. Postgres: invalid input syntax for type
# double precision: "N A N".
statement error
SELECT CAST('N A N' AS DOUBLE)

# float8.sql:51. Postgres: invalid input syntax for type double precision:
# "NaN x".
statement error
SELECT CAST('NaN x' AS DOUBLE)

# float8.sql:52. Postgres: invalid input syntax for type double precision:
# " INFINITY    x".
statement error
SELECT CAST(' INFINITY    x' AS DOUBLE)

# float8.sql:54. 100.0 is a numeric in Postgres, which adds it to a float8 as
# a float8, and a DOUBLE in the engine.
query DOUBLE
SELECT CAST('Infinity' AS DOUBLE) + 100.0
----
Infinity

# float8.sql:55
query DOUBLE
SELECT CAST('Infinity' AS DOUBLE) / CAST('Infinity' AS DOUBLE)
----
NaN

# float8.sql:56
query DOUBLE
SELECT CAST('42' AS DOUBLE) / CAST('Infinity' AS DOUBLE)
----
0.0

# float8.sql:57, 'nan' written 'NaN', as from here on: the rest of the file
# tests what is done with these values, not how they are spelled.
query DOUBLE
SELECT CAST('NaN' AS DOUBLE) / CAST('NaN' AS DOUBLE)
----
NaN

# float8.sql:58
skipif transformer # a division by zero is NULL, NaN's too
query DOUBLE
SELECT CAST('NaN' AS DOUBLE) / CAST('0' AS DOUBLE)
----
NaN

