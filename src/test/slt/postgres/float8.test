# float8.sql:91, f.f1 ^ '2.0' written POWER(f.f1, CAST('2.0' AS DOUBLE)).
# Postgres's power is C's pow, compared as SQLite's R, to three places
# (Postgres: 1008618.4899999999).
query R
SELECT POWER(f.f1, CAST('2.0' AS DOUBLE)) AS square_f1
   FROM FLOAT8_TBL f where f.f1 = '1004.3'
----
1008618.490

# float8.sql:95: absolute value, @f.f1 written ABS(f.f1).
query DOUBLE,DOUBLE rowsort
SELECT f.f1, ABS(f.f1) AS abs_f1
   FROM FLOAT8_TBL f
----
-34.84	34.84
0.0	0.0
1.2345678901234E-200	1.2345678901234E-200
1.2345678901234E200	1.2345678901234E200
1004.3	1004.3

