NULL	1
NULL	2
NULL	2
NULL	3

# case.sql:136
query INT,DOUBLE,INT,INT rowsort
SELECT *
  FROM CASE_TBL a, CASE2_TBL b
  WHERE COALESCE(f,b.i) = 2
----
4	NULL	2	-2
4	NULL	2	-4

# case.sql:155: examples of updates involving tables.
statement ok
UPDATE CASE_TBL
  SET i = CASE WHEN i >= 3 THEN (- i)
                ELSE (2 * i) END

# case.sql:159
query INT,DOUBLE rowsort
SELECT * FROM CASE_TBL
----
-3	-30.3
-4	NULL
2	10.1
4	20.2

# case.sql:161
statement ok
UPDATE CASE_TBL
  SET i = CASE WHEN i >= 2 THEN (2 * i)
                ELSE (3 * i) END

# case.sql:165
query INT,DOUBLE rowsort
SELECT * FROM CASE_TBL
----
-12	NULL
-9	-30.3
4	10.1
8	20.2

