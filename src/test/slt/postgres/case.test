#
# CASE, COALESCE and NULLIF, where NULL comes from and goes: a CASE that
# takes no branch is NULL, COALESCE passes the first value that is not NULL,
# NULLIF makes one, and a comparison with NULL keeps no row. 38 of the file's
# 64 statements are here, as Postgres wrote them, each record naming the line
# of case.sql it comes from. A result in no fixed order is compared as
# rowsort; a double precision Postgres prints as 1 prints as the DOUBLE 1.0.
# `skipif transformer <id>` marks the one record the engine answers otherwise
# by design, with the id of its rule in the ledger in docs/gotchas.md and the
# reason; its twin after it, `onlyif transformer <id>`, is the same statement
# with the engine's own answer.
#
# Left out (26 statements), by what they need:
#   21  user-defined functions, domains, operators, arrays and an enum type,
#       in the transactions that create them
#    3  EXPLAIN, whose answer is Postgres's plan
#    2  UPDATE ... FROM, which the runner, which carries out every UPDATE,
#       does not, and the query that reads what it changed

# case.sql:6-26
statement ok
CREATE TABLE CASE_TBL (
  i integer,
  f double precision
)

statement ok
CREATE TABLE CASE2_TBL (
  i integer,
  j integer
)

statement ok
INSERT INTO CASE_TBL VALUES (1, 10.1)

statement ok
INSERT INTO CASE_TBL VALUES (2, 20.2)

statement ok
INSERT INTO CASE_TBL VALUES (3, -30.3)

statement ok
INSERT INTO CASE_TBL VALUES (4, NULL)

statement ok
INSERT INTO CASE2_TBL VALUES (1, -1)

statement ok
INSERT INTO CASE2_TBL VALUES (2, -2)

statement ok
INSERT INTO CASE2_TBL VALUES (3, -3)

statement ok
INSERT INTO CASE2_TBL VALUES (2, -4)

statement ok
INSERT INTO CASE2_TBL VALUES (1, NULL)

statement ok
INSERT INTO CASE2_TBL VALUES (NULL, -6)

# case.sql:32: simplest examples without tables.
query STRING,INT
SELECT '3' AS "One",
  CASE
    WHEN 1 < 2 THEN 3
  END AS "Simple WHEN"
----
3	3

# case.sql:37
query STRING,INT
SELECT '<NULL>' AS "One",
  CASE
    WHEN 1 > 2 THEN 3
  END AS "Simple default"
----
<NULL>	NULL

# case.sql:42
query STRING,INT
SELECT '3' AS "One",
  CASE
    WHEN 1 < 2 THEN 3
    ELSE 4
  END AS "Simple ELSE"
----
3	3

# case.sql:48
query STRING,INT
SELECT '4' AS "One",
  CASE
    WHEN 1 > 2 THEN 3
    ELSE 4
  END AS "ELSE default"
----
4	4

# case.sql:54
query STRING,INT
SELECT '6' AS "One",
  CASE
    WHEN 1 > 2 THEN 3
    WHEN 4 < 5 THEN 6
    ELSE 7
  END AS "Two WHEN with default"
----
6	6

# case.sql:62
query STRING,INT
SELECT '7' AS "None",
   CASE WHEN random() < 0 THEN 1
   END AS "NULL on no matches"
----
7	NULL

# case.sql:67: constant-expression folding shouldn't evaluate
# unreachable subexpressions.
query INT
SELECT CASE WHEN 1=0 THEN 1/0 WHEN 1=1 THEN 1 ELSE 2/0 END
----
1

# case.sql:68
query INT
SELECT CASE 1 WHEN 0 THEN 1/0 WHEN 1 THEN 1 ELSE 2/0 END
----
1

# case.sql:72: Postgres folds the reachable 1/0 and fails (division by
# zero).
skipif transformer div-zero-null # an integer divided by zero is NULL, and a CASE reads only the branch it takes, so every row is 0
statement error
SELECT CASE WHEN i > 100 THEN 1/0 ELSE 0 END FROM case_tbl

onlyif transformer div-zero-null
query INT rowsort
SELECT CASE WHEN i > 100 THEN 1/0 ELSE 0 END FROM case_tbl
----
0
0
0
0

# case.sql:75: untyped literals in the test expression.
query INT
SELECT CASE 'a' WHEN 'a' THEN 1 ELSE 2 END
----
1

# case.sql:81: examples of targets involving tables.
query INT rowsort
SELECT
  CASE
    WHEN i >= 3 THEN i
  END AS ">= 3 or Null"
  FROM CASE_TBL
----
3
4
NULL
NULL

# case.sql:87
query INT rowsort
SELECT
  CASE WHEN i >= 3 THEN (i + i)
       ELSE i
  END AS "Simplest Math"
  FROM CASE_TBL
----
1
2
6
8

# case.sql:93
query INT,STRING rowsort
SELECT i AS "Value",
  CASE WHEN (i < 0) THEN 'small'
       WHEN (i = 0) THEN 'zero'
       WHEN (i = 1) THEN 'one'
       WHEN (i = 2) THEN 'two'
       ELSE 'big'
  END AS "Category"
  FROM CASE_TBL
----
1	one
2	two
3	big
4	big

# case.sql:102
query STRING rowsort
SELECT
  CASE WHEN ((i < 0) or (i < 0)) THEN 'small'
       WHEN ((i = 0) or (i = 0)) THEN 'zero'
       WHEN ((i = 1) or (i = 1)) THEN 'one'
       WHEN ((i = 2) or (i = 2)) THEN 'two'
       ELSE 'big'
  END AS "Category"
  FROM CASE_TBL
----
big
big
one
two

# case.sql:121: NULLIF() and COALESCE().
query INT,DOUBLE rowsort
SELECT * FROM CASE_TBL WHERE COALESCE(f,i) = 4
----
4	NULL

# case.sql:123
query INT,DOUBLE rowsort
SELECT * FROM CASE_TBL WHERE NULLIF(f,i) = 2
----

# case.sql:125. Postgres prints the double precision 1 as 1; a DOUBLE
# prints 1.0.
query DOUBLE rowsort
SELECT COALESCE(a.f, b.i, b.j)
  FROM CASE_TBL a, CASE2_TBL b
