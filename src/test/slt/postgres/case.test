-30.3
-30.3
-30.3
-30.3
-30.3
-30.3
-6.0
1.0
1.0
10.1
10.1
10.1
10.1
10.1
10.1
2.0
2.0
20.2
20.2
20.2
20.2
20.2
20.2
3.0

# case.sql:128
query INT,DOUBLE,INT,INT rowsort
SELECT *
  FROM CASE_TBL a, CASE2_TBL b
  WHERE COALESCE(a.f, b.i, b.j) = 2
----
4	NULL	2	-2
4	NULL	2	-4

