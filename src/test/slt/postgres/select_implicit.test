4	4

# select_implicit.sql:83: one it does not name.
query BIGINT nosort
SELECT count(*) FROM test_missing_target x, test_missing_target y
	WHERE x.a = y.a
	GROUP BY x.b ORDER BY x.b
----
1
2
3
4

# select_implicit.sql:89: the same query made a table.
statement ok
CREATE TABLE test_missing_target2 AS
SELECT count(*)
FROM test_missing_target x, test_missing_target y
	WHERE x.a = y.a
	GROUP BY x.b ORDER BY x.b

# select_implicit.sql:94
query BIGINT rowsort
SELECT * FROM test_missing_target2
----
1
2
3
4

