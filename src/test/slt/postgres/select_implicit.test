#
# GROUP BY and ORDER BY on columns and expressions the SELECT list does not
# name, by reference number, and in a self-join, where a name both sides
# have is ambiguous unless it is qualified: an error in GROUP BY, ORDER BY or
# an aggregate, and none where two columns of the SELECT list are the same
# column or expression. All 44 of the file's statements are here, each
# record naming the line of select_implicit.sql it comes from, as Postgres
# wrote it, and the engine's answer is Postgres's in every one, the six
# errors each refused for Postgres's reason. test_missing_target's c char(8)
# and d char are STRING columns, as the runner reads CHAR(n), each value
# stored as written, unpadded: Postgres pads c to eight characters and
# compares, groups, sorts and lowers it without the pad, so no answer here
# depends on it, and psql's output does not show it. A result in no fixed
# order, a table's rows read back, is compared as rowsort.

# select_implicit.sql:10: load test data.
statement ok
CREATE TABLE test_missing_target (a int, b int, c char(8), d char)

# select_implicit.sql:11
statement ok
INSERT INTO test_missing_target VALUES (0, 1, 'XXXX', 'A')

# select_implicit.sql:12
statement ok
INSERT INTO test_missing_target VALUES (1, 2, 'ABAB', 'b')

# select_implicit.sql:13
statement ok
INSERT INTO test_missing_target VALUES (2, 2, 'ABAB', 'c')

# select_implicit.sql:14
statement ok
