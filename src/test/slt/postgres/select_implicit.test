# select_implicit.sql:15
statement ok
INSERT INTO test_missing_target VALUES (4, 3, 'BBBB', 'e')

# select_implicit.sql:16
statement ok
INSERT INTO test_missing_target VALUES (5, 3, 'bbbb', 'F')

# select_implicit.sql:17
statement ok
INSERT INTO test_missing_target VALUES (6, 4, 'cccc', 'g')

# select_implicit.sql:18
statement ok
INSERT INTO test_missing_target VALUES (7, 4, 'cccc', 'h')

# select_implicit.sql:19
statement ok
INSERT INTO test_missing_target VALUES (8, 4, 'CCCC', 'I')

# select_implicit.sql:20
statement ok
INSERT INTO test_missing_target VALUES (9, 4, 'CCCC', 'j')

# select_implicit.sql:24: with the GROUP BY target in the SELECT list.
query STRING,BIGINT nosort
SELECT c, count(*) FROM test_missing_target GROUP BY test_missing_target.c ORDER BY c
----
ABAB	2
BBBB	2
CCCC	2
XXXX	1
bbbb	1
cccc	2

# select_implicit.sql:27: without it, a relation name in the GROUP BY clause.
query BIGINT nosort
SELECT count(*) FROM test_missing_target GROUP BY test_missing_target.c ORDER BY c
----
2
2
2
1
1
2

# select_implicit.sql:31: without it, and ordered by another column: an error.
# Postgres: column "test_missing_target.b" must appear in the GROUP BY clause
# or be used in an aggregate function.
statement error
SELECT count(*) FROM test_missing_target GROUP BY a ORDER BY b

# select_implicit.sql:34: without it, ordered by the same column.
query BIGINT nosort
SELECT count(*) FROM test_missing_target GROUP BY b ORDER BY b
----
1
2
3
4

# select_implicit.sql:37: with it, a relation name in the SELECT list.
query INT,BIGINT nosort
SELECT test_missing_target.b, count(*)
  FROM test_missing_target GROUP BY b ORDER BY b
----
1	1
2	2
3	3
4	4

# select_implicit.sql:41: ordered by a column the SELECT list does not name.
query STRING nosort
SELECT c FROM test_missing_target ORDER BY a
