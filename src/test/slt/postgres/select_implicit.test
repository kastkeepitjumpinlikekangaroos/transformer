CCCC	2
XXXX	1
bbbb	1
cccc	2

# select_implicit.sql:54: grouped by a reference number out of range.
# Postgres: GROUP BY position 3 is not in select list.
statement error
SELECT c, count(*) FROM test_missing_target GROUP BY 3

# select_implicit.sql:58: grouped and ordered by a name both sides of a
# self-join have. Postgres: column reference "b" is ambiguous.
statement error
SELECT count(*) FROM test_missing_target x, test_missing_target y
	WHERE x.a = y.a
	GROUP BY b ORDER BY b

