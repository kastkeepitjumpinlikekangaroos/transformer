# select_implicit.sql:129: a self-join grouped and ordered by an expression of
# a name both sides have. Postgres: column reference "b" is ambiguous.
statement error
SELECT count(x.a) FROM test_missing_target x, test_missing_target y
	WHERE x.a = y.a
	GROUP BY b/2 ORDER BY b/2

# select_implicit.sql:134: grouped by an expression of a qualified name the
# SELECT list holds.
query INT,BIGINT nosort
SELECT x.b/2, count(x.b) FROM test_missing_target x, test_missing_target y
	WHERE x.a = y.a
	GROUP BY x.b/2 ORDER BY x.b/2
----
0	1
1	5
2	4

# select_implicit.sql:140: an aggregate of a name both sides have. Postgres:
# column reference "b" is ambiguous.
statement error
SELECT count(b) FROM test_missing_target x, test_missing_target y
	WHERE x.a = y.a
	GROUP BY x.b/2

# select_implicit.sql:146: the query of select_implicit.sql:134 without its
# first column, made a table.
statement ok
CREATE TABLE test_missing_target3 AS
SELECT count(x.b)
FROM test_missing_target x, test_missing_target y
	WHERE x.a = y.a
	GROUP BY x.b/2 ORDER BY x.b/2

# select_implicit.sql:151
query BIGINT rowsort
SELECT * FROM test_missing_target3
----
1
4
5

