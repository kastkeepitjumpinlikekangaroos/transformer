# boolean.sql:91: explicit casts to and from text, each :: written as a
# CAST.
query BOOLEAN,BOOLEAN
SELECT CAST(CAST('TrUe' AS text) AS boolean) AS "true", CAST(CAST('fAlse' AS text) AS boolean) AS "false"
----
true	false

# boolean.sql:92. Postgres trims the spaces.
skipif transformer bool-text # text casts to BOOLEAN from true and false alone, with no spaces around
query BOOLEAN,BOOLEAN
SELECT CAST(CAST('    true   ' AS text) AS boolean) AS "true",
       CAST(CAST('     FALSE' AS text) AS boolean) AS "false"
----
true	false

onlyif transformer bool-text
statement error
SELECT CAST(CAST('    true   ' AS text) AS boolean) AS "true",
       CAST(CAST('     FALSE' AS text) AS boolean) AS "false"
----
Cannot cast '    true   ' to boolean

# boolean.sql:94
query STRING,STRING
SELECT CAST(CAST(true AS boolean) AS text) AS "true", CAST(CAST(false AS boolean) AS text) AS "false"
----
true	false

