# boolean.sql:231: short-circuiting and NULL handling, from a table so
# that no constant is simplified. Postgres prints NULL as (null) here.
statement ok
CREATE TABLE booltbl4(isfalse bool, istrue bool, isnul bool)

statement ok
INSERT INTO booltbl4 VALUES (false, true, null)

# boolean.sql:237: AND needs to return null if there's any nulls and not
# all of the values are true.
query BOOLEAN
SELECT istrue AND isnul AND istrue FROM booltbl4
----
NULL

# boolean.sql:238
query BOOLEAN
SELECT istrue AND istrue AND isnul FROM booltbl4
----
NULL

# boolean.sql:239
query BOOLEAN
SELECT isnul AND istrue AND istrue FROM booltbl4
----
NULL

# boolean.sql:240
query BOOLEAN
SELECT isfalse AND isnul AND istrue FROM booltbl4
----
false

# boolean.sql:241
query BOOLEAN
SELECT istrue AND isfalse AND isnul FROM booltbl4
----
false

# boolean.sql:242
query BOOLEAN
SELECT isnul AND istrue AND isfalse FROM booltbl4
----
false

# boolean.sql:246: OR needs to return null if there's any nulls and none
# of the values is true.
query BOOLEAN
SELECT isfalse OR isnul OR isfalse FROM booltbl4
----
NULL

# boolean.sql:247
query BOOLEAN
SELECT isfalse OR isfalse OR isnul FROM booltbl4
----
NULL

# boolean.sql:248
query BOOLEAN
SELECT isnul OR isfalse OR isfalse FROM booltbl4
----
NULL

# boolean.sql:249
query BOOLEAN
SELECT isfalse OR isnul OR istrue FROM booltbl4
----
true

# boolean.sql:250
query BOOLEAN
SELECT istrue OR isfalse OR isnul FROM booltbl4
----
true

# boolean.sql:251
query BOOLEAN
SELECT isnul OR istrue OR isfalse FROM booltbl4
----
true

