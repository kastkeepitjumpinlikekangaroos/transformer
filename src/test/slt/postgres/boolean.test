# boolean.sql:72: and, or, not in qualifications. From here on bool 't'
# and bool 'f', which are the constants true and false, are written TRUE and
# FALSE.
query BOOLEAN
SELECT TRUE or FALSE AS "true"
----
true

# boolean.sql:74
query BOOLEAN
SELECT TRUE and FALSE AS "false"
----
false

# boolean.sql:76
query BOOLEAN
SELECT not FALSE AS "true"
----
true

