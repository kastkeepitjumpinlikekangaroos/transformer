# travels with every copy: it is COPYRIGHT beside this file.
#
# The boolean type and three-valued logic: AND is NULL when a NULL meets no
# FALSE and OR when a NULL meets no TRUE, whichever order the operands come
# in. 79 of the file's 99 statements are here, each record naming the line of
# boolean.sql it comes from. A statement is as Postgres wrote it but where a
# rewrite cannot change what it means, which its record says: x::type and
# bool '...' as the CASTs they are, bool 't' and bool 'f' as TRUE and FALSE
# where the test is of what is done with the value rather than of how it is
# spelled, and an alias named true or false in double quotes (the engine reads
# TRUE and FALSE as the literals wherever they are written). A result in no
# fixed order is compared as rowsort. `skipif transformer bool-text` marks
# the 12 records the engine answers otherwise by design, by that rule of the
# ledger in docs/gotchas.md: it casts text to BOOLEAN from true and false
# alone, in any case and with no spaces around them. After each, its twin,
# `onlyif transformer bool-text`, is the same statement with the engine's own
# answer, an error naming the text.
#
# Left out (20 statements), by what they need:
#   13  IS TRUE, IS NOT TRUE, IS FALSE, IS NOT FALSE, IS UNKNOWN and IS NOT
#       UNKNOWN, which the engine refuses (it does not implement them), with
#       the table only those read
#    3  pg_input_is_valid() and pg_input_error_info()
#    2  booleq() and boolne()
#    1  psql's \pset, which changes how NULL prints
#    1  dropping the table those tests read

# boolean.sql:8: sanity check.
query INT
SELECT 1 AS one
----
1

# boolean.sql:15: bool input syntax. The aliases true and false are
# quoted, as the engine reads TRUE and FALSE as the literals wherever they
# are written; the columns are named the same.
query BOOLEAN
SELECT true AS "true"
----
true

# boolean.sql:17
query BOOLEAN
SELECT false AS "false"
----
false

# boolean.sql:19: each bool '...' literal written as the CAST it is,
# CAST('...' AS BOOLEAN). The engine casts text to BOOLEAN from true or false
# alone, in any case and without spaces around it, so Postgres's other
# spellings (t, f, y, yes, n, no, on, off, of, 1, 0, and spaces) are errors
# there by design.
skipif transformer bool-text # text casts to BOOLEAN from true and false alone
query BOOLEAN
SELECT CAST('t' AS BOOLEAN) AS "true"
----
true

onlyif transformer bool-text
statement error
SELECT CAST('t' AS BOOLEAN) AS "true"
----
Cannot cast 't' to boolean

# boolean.sql:21
skipif transformer bool-text # text casts to BOOLEAN from true and false alone, with no spaces around
query BOOLEAN
SELECT CAST('   f           ' AS BOOLEAN) AS "false"
----
false

onlyif transformer bool-text
statement error
SELECT CAST('   f           ' AS BOOLEAN) AS "false"
----
Cannot cast '   f           ' to boolean

# boolean.sql:23
query BOOLEAN
SELECT CAST('true' AS BOOLEAN) AS "true"
----
true

