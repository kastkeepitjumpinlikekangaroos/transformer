# strings.sql:500: ILIKE, the case-insensitive LIKE, each test an ILIKE and
# NOT ILIKE pair.
query BOOLEAN nosort
SELECT 'hawkeye' ILIKE 'h%' AS "true"
----
true

# strings.sql:501
query BOOLEAN nosort
SELECT 'hawkeye' NOT ILIKE 'h%' AS "false"
----
false

