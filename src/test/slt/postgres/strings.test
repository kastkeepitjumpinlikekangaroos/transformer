# strings.sql:519: % and _ combined.
query BOOLEAN,BOOLEAN,BOOLEAN nosort
SELECT 'foo' LIKE '_%' as t, 'f' LIKE '_%' as t, '' LIKE '_%' as f
----
true	true	false

# strings.sql:520
query BOOLEAN,BOOLEAN,BOOLEAN nosort
SELECT 'foo' LIKE '%_' as t, 'f' LIKE '%_' as t, '' LIKE '%_' as f
----
true	true	false

# strings.sql:522
query BOOLEAN,BOOLEAN,BOOLEAN nosort
SELECT 'foo' LIKE '__%' as t, 'foo' LIKE '___%' as t, 'foo' LIKE '____%' as f
----
true	true	false

# strings.sql:523
query BOOLEAN,BOOLEAN,BOOLEAN nosort
SELECT 'foo' LIKE '%__' as t, 'foo' LIKE '%___' as t, 'foo' LIKE '%____' as f
----
true	true	false

# strings.sql:525
query BOOLEAN nosort
SELECT 'jack' LIKE '%____%' AS t
----
true

# strings.sql:532: LIKE over a table, which Postgres scans by its primary
# key's index; text written STRING.
statement ok
CREATE TABLE texttest (a STRING PRIMARY KEY, b int)

# strings.sql:533
query STRING,INT rowsort
SELECT * FROM texttest WHERE a LIKE '%1%'
----
