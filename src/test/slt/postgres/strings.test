# From PostgreSQL's regression suite (https://github.com/postgres/postgres):
# src/test/regress/sql/strings.sql at REL_18_6, commit
# 724edf9bde9d356724ad384a2e196edc3c9f80f7, with every answer from
# src/test/regress/expected/strings.out at that commit, never the engine's.
# Portions Copyright (c) 1996-2026, PostgreSQL Global Development Group;
# Portions Copyright (c) 1994, The Regents of the University of California.
# Distributed under the PostgreSQL License, a permissive license whose text
# travels with every copy: it is COPYRIGHT beside this file.
#
# The file's SUBSTRING, LIKE and ILIKE sections: SUBSTRING's start and length
# past the ends of the string and past INT, a negative length an error in
# both engines; LIKE and NOT LIKE pairs over % and _, with an ESCAPE character
# that is unused, used, and itself % or _; ILIKE and NOT ILIKE pairs; % and _
# combined; and LIKE over an empty table. 64 of the file's 507 statements are
# here, each record naming the line of strings.sql it comes from, and the
# engine's answer is Postgres's in each. A statement is as Postgres wrote it
# but where a rewrite cannot change what it means, which its record says:
# SUBSTRING(x FROM s FOR n) as SUBSTRING(x, s, n), one function in both
# engines, as the engine's refusal of the keyword form advises, and text as
# STRING.
#
# Left out (443 statements), by what they need:
#  146  the regular-expression forms: SIMILAR TO, SUBSTRING with SIMILAR or
#       FROM a pattern, regexp_*() and the ~ operators
#  109  bytea values, the functions over them and bytea_output
#   78  string literal syntax the engine does not read: U&'...' and UESCAPE,
#       E'...' escapes, unistr(), and the settings standard_conforming_strings
#       and escape_string_warning
#   54  string functions the engine lacks: OVERLAY, strpos(), replace(),
#       split_part(), to_bin(), to_oct(), to_hex(), initcap(), lpad(),
#       rpad(), ltrim() of given characters, translate(), ascii(), chr(),
#       repeat(), and TRIM's and POSITION's keyword forms
#   35  TOAST-ed values and their storage settings
#   14  the char(n), varchar and name types: casts between the text types,
#       and LIKE and ILIKE over a name
#    5  outside the sections ported: length() and four concatenations of
#       text, char(20) and untyped literals
#    2  psql's \pset, which changes how NULL prints

# strings.sql:140: E021-06 substring expression, SUBSTRING(x FROM s FOR n)
# written SUBSTRING(x, s, n), the same function in both engines, as the
# engine's refusal of the keyword form advises.
query BOOLEAN nosort
SELECT SUBSTRING('1234567890', 3) = '34567890' AS "34567890"
----
true

# strings.sql:142
query BOOLEAN nosort
SELECT SUBSTRING('1234567890', 4, 3) = '456' AS "456"
----
true

# strings.sql:145: overflow cases.
query STRING nosort
SELECT SUBSTRING('string', 2, 2147483646) AS "tring"
----
tring

# strings.sql:146
query STRING nosort
SELECT SUBSTRING('string', -10, 2147483646) AS "string"
----
string

# strings.sql:147: Postgres: negative substring length not allowed.
statement error
SELECT SUBSTRING('string', -10, -2147483646) AS "error"

# strings.sql:415: LIKE, each test a LIKE and NOT LIKE pair; the simplest
# examples (E061-04).
query BOOLEAN nosort
SELECT 'hawkeye' LIKE 'h%' AS "true"
----
true

# strings.sql:416
query BOOLEAN nosort
SELECT 'hawkeye' NOT LIKE 'h%' AS "false"
----
false

# strings.sql:418
query BOOLEAN nosort
SELECT 'hawkeye' LIKE 'H%' AS "false"
----
false

# strings.sql:419
query BOOLEAN nosort
SELECT 'hawkeye' NOT LIKE 'H%' AS "true"
----
true

# strings.sql:421
query BOOLEAN nosort
SELECT 'hawkeye' LIKE 'indio%' AS "false"
----
false

# strings.sql:422
query BOOLEAN nosort
SELECT 'hawkeye' NOT LIKE 'indio%' AS "true"
----
true

# strings.sql:424
query BOOLEAN nosort
SELECT 'hawkeye' LIKE 'h%eye' AS "true"
----
true

# strings.sql:425
query BOOLEAN nosort
SELECT 'hawkeye' NOT LIKE 'h%eye' AS "false"
----
false

