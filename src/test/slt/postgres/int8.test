-1.5	-2
-2.5	-3
0.0	0
0.5	1
1.5	2
2.5	3

onlyif transformer cast-truncates
query DECIMAL(2,1),BIGINT rowsort
SELECT x, CAST(x AS BIGINT) AS int8_value
FROM numeric_values t
----
