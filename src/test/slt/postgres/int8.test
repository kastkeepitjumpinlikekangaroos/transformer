# From PostgreSQL's regression suite (https://github.com/postgres/postgres):
# src/test/regress/sql/int8.sql at REL_18_6, commit
# 724edf9bde9d356724ad384a2e196edc3c9f80f7, with every answer from
# src/test/regress/expected/int8.out at that commit, never the engine's.
# Portions Copyright (c) 1996-2026, PostgreSQL Global Development Group;
# Portions Copyright (c) 1994, The Regents of the University of California.
# Distributed under the PostgreSQL License, a permissive license whose text
# travels with every copy: it is COPYRIGHT beside this file.
#
# The BIGINT, Postgres's int8, at its limits and beside an INT: text no BIGINT
# holds, comparisons and arithmetic each way between the two, arithmetic past
# the range (an error in both engines), INT64_MIN negated, made absolute,
# multiplied and divided by -1, casts to INT, FLOAT and DOUBLE and from DOUBLE
# and DECIMAL, and the text Postgres reads as an integer. 123 of the file's
# 174 statements are here, each record naming the line of int8.sql it comes
# from: 59 queries and 44 statements that must fail, answered as Postgres
# answers them, and 20 records the engine answers otherwise by design, below.
#
# A statement is as Postgres wrote it but where a rewrite cannot change what
# it means, which its record says: int8 as BIGINT, int4 as INT, float4 as
# FLOAT, float8 as DOUBLE, x::type, type 'x' and float8(x) as CAST(x AS type),
# and x::int2 as CAST(x AS INT) where no answer depends on SMALLINT's range
# (the engine has none); an alias named minus in double quotes, as JSqlParser
# reserves MINUS (Oracle's EXCEPT) and the query does not parse with it bare;
# a VALUES list in FROM as a table of its rows, made here; and a string an
# INSERT stores in INT8_TBL, which Postgres refuses, as CAST('...' AS BIGINT),
# the conversion Postgres makes of it, so the engine reads the text, not the
# runner. INT8_TBL is test_setup.sql's, each string it stores written as the
# number Postgres reads. An overflow's message is each engine's own, so those
# records are statement error with no text, and a result in no fixed order is
# compared as rowsort.
#
# `skipif transformer <id>` marks what the engine answers otherwise by
# design, the id naming the rule in the ledger in docs/gotchas.md and the
# comment the case: a division or remainder by zero is NULL, where Postgres
# refuses it (div-zero-null, 4); a CAST of a DOUBLE or a DECIMAL to BIGINT
# truncates toward zero, where Postgres rounds (cast-truncates, 2); and text
# casts to BIGINT by CSV's grammar, where Postgres reads 0x, 0o and 0b
# prefixes and _ between digits (int-text, 14). After each, its twin,
# `onlyif transformer <id>`, is the same statement with the engine's own
# answer.
#
# Left out (45 statements), by what they need:
#   24  to_char()
#    6  gcd() and lcm()
#    4  the bitwise operators &, |, #, ~, << and >>
#    4  pg_input_is_valid() and pg_input_error_info()
#    3  generate_series()
#    2  a CAST to SMALLINT, which tests that type's range
#    2  oid and pg_class
#
# Held out (6 statements), both engines refusing them for different reasons:
# int8.sql:277, 279, 281, 284, 286 and 288, the text of a number one past
# BIGINT's range in base 2, 8 or 16 (int8 '0x8000000000000000'), which
# Postgres refuses as out of range and the engine as no integer of its
# grammar (int-text).

# test_setup.sql:77-85: INT8_TBL, int8 written BIGINT, each string
# test_setup.sql stores written as the number Postgres reads it as ('  123   '
# as 123, '+4567890123456789' as 4567890123456789).
statement ok
CREATE TABLE INT8_TBL(q1 BIGINT, q2 BIGINT)

statement ok
INSERT INTO INT8_TBL VALUES (123, 456), (123, 4567890123456789), (4567890123456789, 123), (4567890123456789, 4567890123456789), (4567890123456789, -4567890123456789)

# int8.sql:9: bad values, each string written CAST('...' AS BIGINT), the
# conversion Postgres makes of it as it stores it, so the engine reads the
# text. Postgres: invalid input syntax for type bigint: "      ".
statement error
INSERT INTO INT8_TBL(q1) VALUES (CAST('      ' AS BIGINT))

# int8.sql:10: Postgres: invalid input syntax for type bigint: "xxx".
statement error
INSERT INTO INT8_TBL(q1) VALUES (CAST('xxx' AS BIGINT))

# int8.sql:11: Postgres: value "3908203590239580293850293850329485" is out of
# range for type bigint.
statement error
INSERT INTO INT8_TBL(q1) VALUES (CAST('3908203590239580293850293850329485' AS BIGINT))

# int8.sql:12: Postgres: value "-1204982019841029840928340329840934" is out of
# range for type bigint.
statement error
INSERT INTO INT8_TBL(q1) VALUES (CAST('-1204982019841029840928340329840934' AS BIGINT))

# int8.sql:13: Postgres: invalid input syntax for type bigint: "- 123".
statement error
INSERT INTO INT8_TBL(q1) VALUES (CAST('- 123' AS BIGINT))

# int8.sql:14: Postgres: invalid input syntax for type bigint: "  345     5".
statement error
