# For int8.sql:220: its VALUES list in FROM is the table float8_values of
# its rows, each x::float8 written as the DOUBLE it is.
statement ok
CREATE TABLE float8_values (x DOUBLE)

statement ok
INSERT INTO float8_values VALUES (-2.5), (-1.5), (-0.5), (0.0), (0.5), (1.5), (2.5)

# int8.sql:220: rounding when casting from float.
skipif transformer cast-truncates # a CAST of a DOUBLE to BIGINT truncates toward zero, where Postgres rounds half to even
query DOUBLE,BIGINT rowsort
SELECT x, CAST(x AS BIGINT) AS int8_value
FROM float8_values t
----
-0.5	0
-1.5	-2
-2.5	-2
0.0	0
0.5	0
1.5	2
2.5	2

onlyif transformer cast-truncates
query DOUBLE,BIGINT rowsort
SELECT x, CAST(x AS BIGINT) AS int8_value
FROM float8_values t
----
-0.5	0
-1.5	-1
-2.5	-2
0.0	0
0.5	0
1.5	1
2.5	2

# For int8.sql:230: its VALUES list is the table numeric_values of its rows,
# each x::numeric written as the DECIMAL(2,1) it is.
statement ok
CREATE TABLE numeric_values (x DECIMAL(2,1))

statement ok
INSERT INTO numeric_values VALUES (-2.5), (-1.5), (-0.5), (0.0), (0.5), (1.5), (2.5)

# int8.sql:230: rounding when casting from numeric.
skipif transformer cast-truncates # a CAST of a DECIMAL to BIGINT truncates toward zero, where Postgres rounds half away from zero
query DECIMAL(2,1),BIGINT rowsort
SELECT x, CAST(x AS BIGINT) AS int8_value
FROM numeric_values t
----
