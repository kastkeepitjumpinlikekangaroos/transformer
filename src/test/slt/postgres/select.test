# select.sql:197: cases with partial indexes, without the EXPLAINs of
# Postgres's plans for them.
query INT,INT,INT,INT,INT,INT,INT,INT,INT,INT,INT,INT,INT,STRING,STRING,STRING rowsort
select * from onek2 where unique2 = 11 and stringu1 = 'ATAAAA'
----
494	11	0	2	4	14	4	94	94	494	494	8	9	ATAAAA	LAAAAA	VVVVxx

# select.sql:203
query INT rowsort
select unique2 from onek2 where unique2 = 11 and stringu1 = 'ATAAAA'
----
11

# select.sql:207
query INT,INT,INT,INT,INT,INT,INT,INT,INT,INT,INT,INT,INT,STRING,STRING,STRING rowsort
select * from onek2 where unique2 = 11 and stringu1 < 'B'
----
494	11	0	2	4	14	4	94	94	494	494	8	9	ATAAAA	LAAAAA	VVVVxx

# select.sql:210
query INT rowsort
select unique2 from onek2 where unique2 = 11 and stringu1 < 'B'
----
11

# select.sql:218
query INT rowsort
select unique2 from onek2 where unique2 = 11 and stringu1 < 'C'
----
11

# select.sql:223
query INT rowsort
select unique2 from onek2 where unique2 = 11 and stringu1 < 'B'
----
11

# select.sql:229
query INT,INT rowsort
select unique1, unique2 from onek2
  where (unique2 = 11 or unique1 = 0) and stringu1 < 'B'
----
0	998
494	11

# select.sql:234
query INT,INT rowsort
select unique1, unique2 from onek2
  where (unique2 = 11 and stringu1 < 'B') or unique1 = 0
----
0	998
494	11

# select.sql:242: corner cases that have confused Postgres's planner: ORDER BY
# a constant.
query INT nosort
SELECT 1 AS x ORDER BY x
----
1

# For select.sql:255 and 256: their VALUES list in FROM, v(k), is the table
# v_k of its rows.
statement ok
CREATE TABLE v_k (k INT)

statement ok
INSERT INTO v_k VALUES (2), (NULL), (1)

# select.sql:255: X = X is X IS NOT NULL where = is strict; the VALUES list in
# FROM is the table v_k of its rows, made above.
query INT nosort
select * from v_k v where k = k order by k
----
1
2

# select.sql:256
query INT rowsort
select * from v_k v where k = k
----
1
2
