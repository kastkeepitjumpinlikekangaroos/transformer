# From PostgreSQL's regression suite (https://github.com/postgres/postgres):
# src/test/regress/sql/select.sql at REL_18_6, commit
# 724edf9bde9d356724ad384a2e196edc3c9f80f7, with every answer from
# src/test/regress/expected/select.out at that commit, never the engine's.
# Portions Copyright (c) 1996-2026, PostgreSQL Global Development Group;
# Portions Copyright (c) 1994, The Regents of the University of California.
# Distributed under the PostgreSQL License, a permissive license whose text
# travels with every copy: it is COPYRIGHT beside this file.
#
# SELECT over onek, Postgres's 1,000-row table: ORDER BY in each direction on
# one and two keys, a VALUES list joined in, VALUES as a query and in a UNION,
# where a NULL sorts with and without NULLS FIRST and NULLS LAST, the queries
# Postgres runs over its partial indexes, ORDER BY a constant, and X = X,
# which keeps no NULL. 48 of the file's 87 statements are here, each record
# naming the line of select.sql it comes from: 7 that make or fill a table or
# an index, 32 queries answered as Postgres answers them, and 9 the engine
# answers otherwise by design, below.
#
# A statement is as Postgres wrote it but where a rewrite cannot change what
# it means, which its record says: ORDER BY x USING > and USING < as DESC and
# ASC, the orders of those operators, which put NULLs where USING does (and no
# key they order is NULL); a VALUES list in FROM as a table of its rows, made
# here; VALUES as a query as the SELECTs of its rows joined by UNION ALL,
# which Postgres's documentation says it is equivalent to and the engine's
# refusal of VALUES advises; and TABLE t as SELECT * FROM t, which it means.
# A numeric Postgres makes of an integer and 77.7 is a DOUBLE in the engine,
# as 77.7 is; its values are written as the DOUBLE prints them. onek and
# INT8_TBL are test_setup.sql's, onek loaded with COPY from data/onek.data,
# Postgres's own file, as test_setup.sql loads it, and onek2 its copy; an
# index changes no answer, and the runner keeps only its name. A result in no
# fixed order is compared as rowsort.
#
# `skipif transformer nulls-sort-low` marks the 9 queries whose answer is
# where a NULL sorts: the engine sorts it as the smallest value, first under
# ASC and last under DESC, where Postgres sorts it last under ASC and first
# under DESC, by the rule of the ledger in docs/gotchas.md. After each, its
# twin, `onlyif transformer nulls-sort-low`, is the same query with the
# engine's own answer. With NULLS FIRST or NULLS LAST written, the engines
# agree.
#
# Left out (39 statements), by what they need:
#   11  EXPLAIN, whose answer is Postgres's plan
#   10  planner settings and ANALYZE, which change no answer
#    4  a set-returning SQL function
#    3  a whole-row reference to a subquery
#    3  a table of no columns, DEFAULT VALUES and LATERAL
#    3  a partitioned table
#    2  a subquery, as a value and in IN
#    2  a table's inheritance children (person*), over the point type
#    1  FOR UPDATE, a row lock the engine never takes

# test_setup.sql:118-142: onek as test_setup.sql creates it, int4 written INT
# and name STRING, loaded with COPY from data/onek.data, Postgres's file of
# its 1,000 rows, as test_setup.sql loads it, and onek2, its copy.
statement ok
CREATE TABLE onek (
    unique1     INT,
    unique2     INT,
    two         INT,
    four        INT,
    ten         INT,
    twenty      INT,
    hundred     INT,
    thousand    INT,
    twothousand INT,
    fivethous   INT,
    tenthous    INT,
    odd         INT,
    even        INT,
    stringu1    STRING,
    stringu2    STRING,
    string4     STRING
)

statement ok
COPY onek FROM 'data/onek.data'

statement ok
CREATE TABLE onek2 AS SELECT * FROM onek

# test_setup.sql:77-85: INT8_TBL, int8 written BIGINT, each string
# test_setup.sql stores written as the number Postgres reads it as.
statement ok
CREATE TABLE INT8_TBL(q1 BIGINT, q2 BIGINT)

statement ok
INSERT INTO INT8_TBL VALUES (123, 456), (123, 4567890123456789), (4567890123456789, 123), (4567890123456789, 4567890123456789), (4567890123456789, -4567890123456789)

# select.sql:8: btree index.
