4	833	0	0	4	4	4	4	4	4	4	8	9	EAAAAA	BGBAAA	HHHHxx
5	541	1	1	5	5	5	5	5	5	5	10	11	FAAAAA	VUAAAA	HHHHxx
6	978	0	2	6	6	6	6	6	6	6	12	13	GAAAAA	QLBAAA	OOOOxx
7	647	1	3	7	7	7	7	7	7	7	14	15	HAAAAA	XYAAAA	VVVVxx
