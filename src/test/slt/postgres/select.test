# For select.sql:121: its VALUES list in FROM, v (i, j), is the table v of
# its rows.
statement ok
CREATE TABLE v (i INT, j STRING)

statement ok
INSERT INTO v VALUES (147, 'RFAAAA'), (931, 'VJAAAA')

# select.sql:121
query INT,INT,INT,INT,INT,INT,INT,INT,INT,INT,INT,INT,INT,STRING,STRING,STRING,INT,STRING rowsort
select * from onek, v
    WHERE onek.unique1 = v.i and onek.stringu1 = v.j
----
147	0	1	3	7	7	7	47	147	147	147	14	15	RFAAAA	AAAAAA	AAAAxx	147	RFAAAA
931	1	1	3	1	11	1	31	131	431	931	2	3	VJAAAA	BAAAAA	HHHHxx	931	VJAAAA

# select.sql:138: VALUES as a query, written as the SELECTs of its rows joined
# by UNION ALL, which Postgres's documentation says it is equivalent to and
# the engine's refusal of VALUES advises. Its second column is a numeric in
# Postgres and a DOUBLE in the engine, as 77.7 is; the values are equal.
query INT,DOUBLE rowsort
SELECT 1 AS column1, 2 AS column2 UNION ALL SELECT 3, 4+4 UNION ALL SELECT 7, 77.7
----
1	2.0
3	8.0
7	77.7

# select.sql:140: the same, and TABLE int8_tbl written SELECT * FROM int8_tbl,
# which it means (the engine's parser does not read TABLE). The second column
# is a numeric in Postgres and a DOUBLE in the engine; every value of it is a
# double's.
query BIGINT,DOUBLE rowsort
SELECT 1 AS column1, 2 AS column2 UNION ALL SELECT 3, 4+4 UNION ALL SELECT 7, 77.7
UNION ALL
SELECT 2+2, 57
UNION ALL
SELECT * FROM int8_tbl
----
1	2.0
123	4.567890123456789E15
123	456.0
3	8.0
4	57.0
4567890123456789	-4.567890123456789E15
4567890123456789	123.0
4567890123456789	4.567890123456789E15
7	77.7

