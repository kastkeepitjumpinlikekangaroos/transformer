query FLOAT rowsort
SELECT f.* FROM FLOAT4_TBL f WHERE f.f1 <> '1004.3'
----
-34.84
0.0
1.2345679E-20
1.2345679E20

# float4.sql:67
query FLOAT rowsort
SELECT f.* FROM FLOAT4_TBL f WHERE f.f1 = '1004.3'
----
1004.3

# float4.sql:69
query FLOAT rowsort
SELECT f.* FROM FLOAT4_TBL f WHERE '1004.3' > f.f1
----
-34.84
0.0
1.2345679E-20

# float4.sql:71
query FLOAT rowsort
SELECT f.* FROM FLOAT4_TBL f WHERE  f.f1 < '1004.3'
----
-34.84
0.0
1.2345679E-20

# float4.sql:73
query FLOAT rowsort
SELECT f.* FROM FLOAT4_TBL f WHERE '1004.3' >= f.f1
----
-34.84
0.0
1.2345679E-20
1004.3

# float4.sql:75
query FLOAT rowsort
SELECT f.* FROM FLOAT4_TBL f WHERE  f.f1 <= '1004.3'
----
-34.84
0.0
1.2345679E-20
1004.3

# float4.sql:77
query FLOAT,FLOAT rowsort
SELECT f.f1, f.f1 * '-10' AS x FROM FLOAT4_TBL f
   WHERE f.f1 > '0.0'
----
1.2345679E-20	-1.2345678E-19
1.2345679E20	-1.2345678E21
1004.3	-10043.0

# float4.sql:80
query FLOAT,FLOAT rowsort
SELECT f.f1, f.f1 + '-10' AS x FROM FLOAT4_TBL f
   WHERE f.f1 > '0.0'
----
1.2345679E-20	-10.0
1.2345679E20	1.2345679E20
1004.3	994.3

# float4.sql:83
query FLOAT,FLOAT rowsort
SELECT f.f1, f.f1 / '-10' AS x FROM FLOAT4_TBL f
   WHERE f.f1 > '0.0'
----
1.2345679E-20	-1.2345679E-21
1.2345679E20	-1.2345679E19
1004.3	-100.43

# float4.sql:86
query FLOAT,FLOAT rowsort
SELECT f.f1, f.f1 - '-10' AS x FROM FLOAT4_TBL f
   WHERE f.f1 > '0.0'
----
1.2345679E-20	10.0
1.2345679E20	1.2345679E20
1004.3	1014.3

# float4.sql:90: divide by zero. Postgres: division by zero.
skipif transformer div-zero-null # a FLOAT divided by zero is NULL
statement error
SELECT f.f1 / '0.0' from FLOAT4_TBL f

onlyif transformer div-zero-null
query FLOAT rowsort
SELECT f.f1 / '0.0' from FLOAT4_TBL f
----
NULL
NULL
NULL
NULL
NULL

# float4.sql:92
query FLOAT rowsort
SELECT * FROM FLOAT4_TBL
----
-34.84
0.0
1.2345679E-20
1.2345679E20
1004.3

# float4.sql:95: the unary float4abs operator, @ x written ABS(x).
query FLOAT,FLOAT rowsort
SELECT f.f1, ABS(f.f1) AS abs_f1 FROM FLOAT4_TBL f
----
-34.84	34.84
0.0	0.0
1.2345679E-20	1.2345679E-20
1.2345679E20	1.2345679E20
1004.3	1004.3

# float4.sql:97
statement ok
UPDATE FLOAT4_TBL
   SET f1 = FLOAT4_TBL.f1 * '-1'
   WHERE FLOAT4_TBL.f1 > '0.0'

# float4.sql:101
query FLOAT nosort
SELECT * FROM FLOAT4_TBL ORDER BY 1
----
-1.2345679E20
-1004.3
-34.84
-1.2345679E-20
0.0

# float4.sql:108: edge-case coercions to integer, x::float4::int4 written
# CAST(CAST(x AS FLOAT) AS INT) and ::int8 as BIGINT.
query INT nosort
SELECT CAST(CAST('2147483520' AS FLOAT) AS INT)
----
2147483520

# float4.sql:109: Postgres: integer out of range.
statement error
SELECT CAST(CAST('2147483647' AS FLOAT) AS INT)

# float4.sql:110
query INT nosort
SELECT CAST(CAST('-2147483648.5' AS FLOAT) AS INT)
----
-2147483648

# float4.sql:111: Postgres: integer out of range.
statement error
SELECT CAST(CAST('-2147483900' AS FLOAT) AS INT)

# float4.sql:112
query BIGINT nosort
SELECT CAST(CAST('9223369837831520256' AS FLOAT) AS BIGINT)
----
9223369837831520256

# float4.sql:113: Postgres: bigint out of range.
statement error
SELECT CAST(CAST('9223372036854775807' AS FLOAT) AS BIGINT)

# float4.sql:114
query BIGINT nosort
SELECT CAST(CAST('-9223372036854775808.5' AS FLOAT) AS BIGINT)
----
-9223372036854775808

# float4.sql:115: Postgres: bigint out of range.
statement error
SELECT CAST(CAST('-9223380000000000000' AS FLOAT) AS BIGINT)
