# From Apache DataFusion's sqllogictest files (https://github.com/apache/datafusion):
# datafusion/sqllogictest/test_files/math.slt at commit
# 934691e9af8f11bf4b629f21bb17795abfb84d93, as it is there but for this header
# and the condition lines added before records, under the Apache License 2.0
# (LICENSE beside this file; NOTICE says whose they are).
# transformer: an unconstrained DECIMAL is DECIMAL(38,10)
#
# 238 records: 38 run as DataFusion answers them; 26 skipped by a rule of the
# ledger in docs/gotchas.md (div-zero-null 18, math-domain-null 5,
# refused-implicit-number 3), each skip whose rule is no refusal followed by
# its twin, the engine's own answer (23); 173 held for DataFusion, `onlyif
# datafusion # needs ...`, by what they need: a function the engine has not 67,
# a clause or construct the engine refuses 48, what a held statement makes 41,
# a statement the runner does not carry out 8, its own plan (EXPLAIN) 5, a type
# the engine has not 3, a value or type the dialect reads otherwise 1; 1 held
# as findings for the user (D1 1), listed in plans/testing/12.

# SPDX-License-Identifier: Apache-2.0
# SPDX-FileCopyrightText: See the NOTICE file distributed with this work for additional information regarding copyright ownership
# SPDX-FileContributor: Licensed to the Apache Software Foundation (ASF) under one or more contributor license agreements

##########
## Math expression Tests
##########

statement ok
CREATE external table aggregate_simple(c1 real, c2 double, c3 boolean) STORED as CSV LOCATION '../core/tests/data/aggregate_simple.csv' OPTIONS ('format.has_header' 'true');

