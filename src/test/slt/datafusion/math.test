# Null propagation for log
onlyif datafusion # needs DataFusion's own plan, an EXPLAIN
query TT
EXPLAIN SELECT log(NULL, c2) from aggregate_simple;
----
logical_plan
01)Projection: Float64(NULL) AS log(NULL,aggregate_simple.c2)
02)--TableScan: aggregate_simple projection=[]
physical_plan DataSourceExec: file_groups={1 group: [[WORKSPACE_ROOT/datafusion/core/tests/data/aggregate_simple.csv]]}, projection=[NULL as log(NULL,aggregate_simple.c2)], file_type=csv, has_header=true

# Simplification must preserve NULLs from nullable columns
onlyif datafusion # needs VALUES in FROM
query RRRRR rowsort
SELECT
  log(a, 1),
  log(a, a),
  log(a, power(a, b)),
  power(a, 0),
  power(a, log(a, b))
FROM (VALUES (NULL::double, 2.0::double), (2.0, 3.0)) AS t(a, b);
----
0 1 3 1 3
NULL NULL NULL NULL NULL

# Nullable bases must remain in the optimized plan so they can propagate NULL
onlyif datafusion # needs DataFusion's own plan, an EXPLAIN
query TT
EXPLAIN SELECT
  log(a, 1) AS l1,
  log(a, a) AS la,
  power(a, 0) AS p0,
  power(a, log(a, b)) AS pl
FROM (VALUES (NULL::double, 2.0::double), (2.0, 3.0)) AS t(a, b);
----
logical_plan
01)Projection: log(t.a, Float64(1)) AS l1, log(t.a, t.a) AS la, power(t.a, Float64(0)) AS p0, power(t.a, log(t.a, t.b)) AS pl
02)--SubqueryAlias: t
03)----Projection: column1 AS a, column2 AS b
04)------Values: (Float64(NULL) AS NULL, Float64(2)), (Float64(2), Float64(3))
physical_plan
01)ProjectionExec: expr=[log(column1@0, 1) as l1, log(column1@0, column1@0) as la, power(column1@0, 0) as p0, power(column1@0, log(column1@0, column2@1)) as pl]
02)--DataSourceExec: partitions=1, partition_sizes=[1]

# A column base is left alone even when it is not nullable, because its value is
# not known to be outside {0, 1, negative}. power(a, 0) does not depend on the
# base value, so it still folds.
onlyif datafusion # needs DataFusion's own plan, an EXPLAIN
query TT
EXPLAIN SELECT
  log(a, 1) AS l1,
  log(a, a) AS la,
  power(a, 0) AS p0,
  power(a, log(a, b)) AS pl
FROM (VALUES (2.0::double, 3.0::double)) AS t(a, b);
----
logical_plan
01)Projection: log(t.a, Float64(1)) AS l1, log(t.a, t.a) AS la, Float64(1) AS p0, power(t.a, log(t.a, t.b)) AS pl
02)--SubqueryAlias: t
03)----Projection: column1 AS a, column2 AS b
04)------Values: (Float64(2), Float64(3))
physical_plan
01)ProjectionExec: expr=[log(column1@0, 1) as l1, log(column1@0, column1@0) as la, 1 as p0, power(column1@0, log(column1@0, column2@1)) as pl]
02)--DataSourceExec: partitions=1, partition_sizes=[1]

onlyif datafusion # needs VALUES in FROM
query RR
SELECT power(2.0, log(2.0, a)), power(b, log(b, a))
FROM (VALUES (-3.0::double, 2.0::double)) t(a, b);
----
NaN NaN

onlyif datafusion # needs VALUES in FROM
query I
SELECT count(*) FROM (VALUES (-3.0::double)) t(a)
WHERE power(2.0, log(2.0, a)) = -3.0;
----
0

onlyif datafusion # needs VALUES in FROM
query R rowsort
SELECT power(2.0, log(2.0, a))
FROM (VALUES (4.0::double), (NULL::double)) t(a);
----
4
NULL

onlyif datafusion # needs VALUES in FROM
query RR
SELECT log(2.0, power(2.0, a)), ln(power(2.0, a)) / ln(2.0)
FROM (VALUES (2000.0::double), (-2000.0::double)) t(a);
----
Infinity Infinity
-Infinity -Infinity

# log(base, value) widens float arguments to the wider of the two, so a wider
# base is not narrowed to the value's type (#22581). Here base 2.5 is Float64.
onlyif datafusion # needs arrow_cast()
query RT
SELECT log(2.5, arrow_cast(10.9, 'Float16')), arrow_typeof(log(2.5, arrow_cast(10.9, 'Float16')));
----
2.606835742462 Float64

onlyif datafusion # needs arrow_typeof()
query RT
SELECT log(2.5, 10.9::float), arrow_typeof(log(2.5, 10.9::float));
----
2.606992159958 Float64

onlyif datafusion # needs arrow_typeof()
query RT
SELECT log(2.5, 10.9::double), arrow_typeof(log(2.5, 10.9::double));
----
2.606992198152 Float64

# Homogeneous float widths are preserved
onlyif datafusion # needs arrow_cast()
query RT
SELECT log(arrow_cast(2.5, 'Float16'), arrow_cast(10.9, 'Float16')), arrow_typeof(log(arrow_cast(2.5, 'Float16'), arrow_cast(10.9, 'Float16')));
----
2.6074219 Float16

# Unary Float16 log uses a Float16 default base.
onlyif datafusion # needs arrow_cast()
query RT
SELECT log(arrow_cast(100.0, 'Float16')), arrow_typeof(log(arrow_cast(100.0, 'Float16')));
----
2 Float16

onlyif datafusion # needs arrow_typeof()
query RT
SELECT log(2.5::float, 10.9::float), arrow_typeof(log(2.5::float, 10.9::float));
----
2.606992 Float32

# A Float16 base is widened to a Float32 value's type
onlyif datafusion # needs arrow_cast()
query RT
SELECT log(arrow_cast(2.5, 'Float16'), 10.9::float), arrow_typeof(log(arrow_cast(2.5, 'Float16'), 10.9::float));
----
2.606992 Float32

# #22581: a Float64 base must keep full precision against a Float32 value.
# 16777217 is not representable in Float32, so an f32 computation would round it.
onlyif datafusion # needs arrow_cast()
query RT
SELECT log(arrow_cast(16777217, 'Float64'), arrow_cast(2.0, 'Float32')), arrow_typeof(log(arrow_cast(16777217, 'Float64'), arrow_cast(2.0, 'Float32')));
----
0.041666666517 Float64

# NULL arguments keep their existing result types
onlyif datafusion # needs arrow_typeof()
query RT
SELECT log(2.5::float, NULL), arrow_typeof(log(2.5::float, NULL));
----
NULL Float64

onlyif datafusion # needs arrow_typeof()
query RT
SELECT log(NULL, 2.0::float), arrow_typeof(log(NULL, 2.0::float));
----
NULL Float32

onlyif datafusion # needs arrow_typeof()
query RT
SELECT log(NULL, NULL), arrow_typeof(log(NULL, NULL));
----
NULL Float64

# A Float16 base is widened to a wider value's type
onlyif datafusion # needs arrow_cast()
query RT
SELECT log(arrow_cast(2.5, 'Float16'), 1.0::double), arrow_typeof(log(arrow_cast(2.5, 'Float16'), 1.0::double));
----
0 Float64

onlyif datafusion # needs arrow_cast()
query RT
SELECT log(arrow_cast(2.5, 'Float16'), arrow_cast(1.0, 'Float16')), arrow_typeof(log(arrow_cast(2.5, 'Float16'), arrow_cast(1.0, 'Float16')));
----
0 Float16

