## pow/power

# pow() with integer base and negative float exponent (verifies type coercion)
query R
SELECT pow(2, -0.5)
----
0.707106781187

# pow() with negative integer base and negative float exponent (returns NaN)
skipif transformer math-domain-null
query R
SELECT pow(-2, -0.5)
----
NaN

onlyif transformer math-domain-null
query R
SELECT pow(-2, -0.5)
----
NULL

# pow() with zero base and negative exponent (PostgreSQL: domain error)
skipif transformer math-domain-null
query error DataFusion error: Arrow error: Compute error: zero raised to a negative power is undefined
SELECT pow(0, -0.5)

onlyif transformer math-domain-null
query R
SELECT pow(0, -0.5)
----
NULL

# power(0::float8, negative::float8) - issue #22272
onlyif datafusion # needs a CAST to FLOAT8
query error DataFusion error: Arrow error: Compute error: zero raised to a negative power is undefined
SELECT power(0.0::float8, -1.0::float8)

# zero base, negative exponent: exact Decimal+Int64 path (pow_decimal_int → pow_decimal_float)
skipif transformer math-domain-null
query error DataFusion error: Arrow error: Compute error: zero raised to a negative power is undefined
SELECT pow(0::decimal(38, 0), -2::bigint)

onlyif transformer math-domain-null
query R
SELECT pow(0::decimal(38, 0), -2::bigint)
----
NULL

# bigint operands (typically coerced to float); still must reject 0^(negative)
skipif transformer math-domain-null
query error DataFusion error: Arrow error: Compute error: zero raised to a negative power is undefined
SELECT pow(0::bigint, -2::bigint)

onlyif transformer math-domain-null
query R
SELECT pow(0::bigint, -2::bigint)
----
NULL

# decimal base + float scalar exponent (compute_pow_f64_result / pow_decimal_float fallback)
skipif transformer math-domain-null
query error DataFusion error: Arrow error: Compute error: zero raised to a negative power is undefined
SELECT pow(0.0::decimal(10,2), -1.0)

onlyif transformer math-domain-null
query R
SELECT pow(0.0::decimal(10,2), -1.0)
----
NULL

# decimal base + array exponent (pow_decimal_with_float_fallback)
onlyif datafusion # needs VALUES in FROM
query error DataFusion error: Arrow error: Compute error: zero raised to a negative power is undefined
SELECT power(base, exp) FROM (VALUES (0.0::decimal(10,2), -1.0::float8)) AS t(base, exp)

# pow() with integer base of 1 and negative exponent
query R
SELECT pow(1, -0.5)
----
1

# pow() with large integer base and small negative exponent
query R
SELECT pow(1000, -0.1)
----
0.501187233627

# pow() with integer base and negative integer exponent returns float (like PostgreSQL)
query R
SELECT pow(2, -2)
----
0.25

# power() with very large exponent returns infinity (Float64 behavior)
query R
select power(2107754225, 1221660777);
----
Infinity

onlyif datafusion # needs VALUES in FROM
query R rowsort
select power(base::double, exponent::double)
from values
  (2.0, 2.0),
  (5.0, 4.0),
  (2.0, 3.0),
  (3.0, 4.0) as t(base, exponent);
----
4
625
8
81

onlyif datafusion # needs VALUES in FROM
query R rowsort
select power(base::bigint, exponent::bigint)
from values
  (2, 2),
  (5, 4),
  (2, 3),
  (3, 4),
  (2, NULL) as t(base, exponent);
----
4
625
8
81
NULL

# There is no variant of `power` that accepts (Decimal, Decimal); type coercion
# casts both arguments to `Float64`, so the result is `Float64`.
onlyif datafusion # needs VALUES in FROM
query RT rowsort
select
  power(base::decimal(38, 0), exponent::decimal(38, 0)),
  arrow_typeof(power(base::decimal(38, 0), exponent::decimal(38, 0)))
from values
  (0, 4),
  (5, 0),
  (2, 2),
  (5, 4),
  (2, 3),
  (3, 4) as t(base, exponent);
----
0 Float64
1 Float64
4 Float64
625 Float64
8 Float64
81 Float64

onlyif datafusion # needs arrow_typeof()
query RT
select
  pow(2.5::decimal(2, 1), 4::bigint),
  arrow_typeof(pow(2.5::decimal(2, 1), 4::bigint));
----
39.0625 Float64

# factorial negative (PostgreSQL-compatible domain error)
onlyif datafusion # needs factorial()
query error DataFusion error: Execution error: factorial of a negative number is undefined
select factorial(-1);

# factorial overflow
onlyif datafusion # needs FACTORIAL()
query error DataFusion error: Execution error: Overflow happened on FACTORIAL\(350943270\)
select FACTORIAL(350943270);

