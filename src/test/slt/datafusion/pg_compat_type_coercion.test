query BB
select true and true, false and false;
----
true false


query BB
select true or true, false or false;
----
true false


query BB
select false and true, true and false;
----
false false


query BB
select false or true, true or false;
----
true true


query BB
select null and null, null or null;
----
NULL NULL


query BBBB
select true and null,
       false and null,
       null and true,
       null and false;
----
NULL false NULL false


query BBBB
select true or null,
       false or null,
       null or true,
       null or false;
----
true NULL true NULL
