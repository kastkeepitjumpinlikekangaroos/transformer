# What the engine does not do is refused with a message saying so, never run
# with a guessed meaning. Each record names text its message must contain.

statement ok
CREATE TABLE t (a INT, b INT)

statement ok
CREATE TABLE u (a INT, c INT)

statement ok
INSERT INTO t VALUES (1, 10), (2, 20)

statement ok
INSERT INTO u VALUES (1, 100), (3, 300)

# Subqueries of every kind, each refusal naming the WITH clause to write
# instead: the pins of the ledger's refused-subquery (docs/gotchas.md).
onlyif transformer refused-subquery
statement error
SELECT a FROM t WHERE a IN (SELECT a FROM u)
----
IN with a subquery is not supported; name the subquery in a WITH clause and JOIN it

onlyif transformer refused-subquery
statement error
SELECT a FROM t WHERE EXISTS (SELECT 1 FROM u WHERE u.a = t.a)
----
EXISTS is not supported; name the subquery in a WITH clause and JOIN it

onlyif transformer refused-subquery
statement error
SELECT (SELECT MAX(c) FROM u) FROM t
----
A subquery is not supported; name it in a WITH clause and select from it, or JOIN it

onlyif transformer refused-subquery
statement error
SELECT x.a FROM (SELECT a FROM t) x
----
A subquery in FROM is not supported; name it in a WITH clause and select from it, or JOIN it

# Set operations other than UNION.
onlyif transformer refused-except-intersect
statement error
SELECT a FROM t EXCEPT SELECT a FROM u
----
EXCEPT is not supported; only UNION and UNION ALL are supported

onlyif transformer refused-except-intersect
statement error
SELECT a FROM t INTERSECT SELECT a FROM u
----
INTERSECT is not supported; only UNION and UNION ALL are supported

# A join takes the condition its kind takes.
statement error
SELECT * FROM t JOIN u

statement error
SELECT * FROM t CROSS JOIN u ON t.a = u.a

statement error
SELECT * FROM t NATURAL JOIN u

# One statement per query.
statement error
SELECT a FROM t; SELECT a FROM u
----
Only one statement

statement error
SELECT a FROM t ORDER BY a ORDER BY b

# A FROM names each table once.
statement error
SELECT * FROM t JOIN t ON t.a = t.a

statement error
SELECT t.a, u.a FROM t x JOIN u x ON x.a = x.a
