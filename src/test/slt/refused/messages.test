# Each refusal the binder makes, with the words it says: a refusal is part of
# the engine's surface as much as an answer is, and its message is how a user
# learns what to write instead. One record per message no other test reads.

statement ok
CREATE TABLE t (a INT, b INT, s STRING, x BINARY)

statement ok
INSERT INTO t VALUES (1, 10, 'p', x'01'), (2, 20, 'q', x'02')

statement error
WITH RECURSIVE r AS (SELECT 1 AS n) SELECT n FROM r
----
Recursive CTEs (WITH RECURSIVE) are not supported

statement error
WITH c(p, q) AS (SELECT a FROM t) SELECT p FROM c
----
CTE 'c' declares 2 column alias(es) but its body

statement error
SELECT a FROM t ORDER BY a UNION ALL SELECT b FROM t
----
ORDER BY before the last arm of a UNION is not supported; put the arm in parentheses

statement error
SELECT a FROM t UNION ALL SELECT a, b FROM t
----
UNION arms have different column counts: 1 vs 2

statement error
SELECT a FROM t LIMIT 1, 1 OFFSET 1
----
OFFSET given twice

statement error
SELECT TOP 1 a FROM t OFFSET 1
----
TOP n with OFFSET is not supported; write LIMIT n OFFSET m

statement error
SELECT a FROM t LIMIT 1 FETCH FIRST 1 ROWS ONLY
----
both limit the rows; write one

statement error
SELECT a, b, COUNT(*) FROM t GROUP BY ROLLUP (a, b)
----
GROUP BY ROLLUP (...) is not supported

statement error
SELECT a, b, COUNT(*) FROM t GROUP BY CUBE (a, b)
----
GROUP BY CUBE (...) is not supported

statement error
SELECT * FROM t CROSS JOIN t u ON t.a = u.a
----
CROSS JOIN takes no ON

statement error
SELECT * FROM t, t u ON t.a = u.a
----
A table after a comma takes no ON

statement error
SELECT * FROM t JOIN t u
----
needs an ON condition; write CROSS JOIN to pair every row

statement error
SELECT * FROM t LEFT JOIN t u
----
needs an ON condition

# A time of day is no type the engine has, written either way.
statement error
SELECT TIME '10:00:00'
----
Unsupported CAST target type: TIME

statement error
SELECT {t '10:00:00'}
----
TIME literal not supported

statement error
SELECT a FROM t WHERE s LIKE 'p%' ESCAPE 'ab'
----
ESCAPE must be a single-character string literal

statement error
SELECT TRIM(LEADING 'x' FROM s) FROM t
----
Only the single-argument TRIM(x) is supported

statement error
SELECT a FROM t WHERE SUM(b) > 1
----
SUM

statement error
SELECT a FROM t WHERE ROW_NUMBER() OVER (ORDER BY a) > 1
----
ROW_NUMBER

statement error
SELECT SUM(a, b) FROM t
----
Unsupported aggregate: SUM(2 args)

statement error
SELECT NO_SUCH_FUNCTION(a) FROM t
----
NO_SUCH_FUNCTION

statement error
SELECT CAST(a AS INTERVAL) FROM t
----
INTERVAL

# A DECIMAL is named with its precision and scale, which the message says
# how to write.
statement error
SELECT CAST(a AS DECIMAL) FROM t
----
A CAST to DECIMAL names its precision and scale: write DECIMAL(p,s), with p digits in all (1 to 38) and s of them after the point (0 to p)

statement error
SELECT CAST(a AS NUMERIC(12)) FROM t
----
A CAST to NUMERIC names its precision and scale: write NUMERIC(p,s)

statement error
SELECT CAST(a AS DECIMAL(40,2)) FROM t
----
DECIMAL(40,2) is no DECIMAL: one has 1 to 38 digits in all, its precision, and 0 to that many after the point, its scale

# Text a CAST to DECIMAL cannot hold is refused before the query runs, as any
# other text a CAST cannot read is.
statement error
SELECT CAST('123.45' AS DECIMAL(4,2)) FROM t
----
Cannot cast '123.45' to decimal(4,2)

statement error
SELECT UPPER(x) FROM t
----
on BINARY is not supported; a byte array is not text

statement error
SELECT SUM(a) OVER (ORDER BY a ROWS BETWEEN a PRECEDING AND CURRENT ROW) FROM t

statement error
SELECT NTILE(2) OVER (ORDER BY a) FROM t

statement error
SELECT COUNT() FROM t
----
COUNT() needs an argument: COUNT(*) counts the rows, COUNT(x) the rows where x is not NULL

statement error
SELECT a, COUNT() OVER (ORDER BY a) FROM t
----
COUNT() needs an argument

statement error
SELECT LOG(b) FROM t
----
LOG(x) with one argument is not supported, as engines disagree on its base; write LN(x) for base e, LOG10(x) for base 10, or LOG(base, x)

statement error
SELECT SUM(a) OVER (ORDER BY a ROWS BETWEEN CURRENT ROW AND 9223372036854775808 FOLLOWING) FROM t
----
FOLLOWING offset 9223372036854775808 is larger than the largest BIGINT, 9223372036854775807

# The refusals the ledger's rules name (docs/gotchas.md, "Answers that differ
# from other engines by design"), each the pin of its rule.
onlyif transformer refused-text-arithmetic
statement error
SELECT s + 1 FROM t
----
Arithmetic on STRING is not supported; CAST it to a number, or use || to join text

onlyif transformer refused-empty-in
statement error
SELECT a FROM t WHERE a IN ()
----
IN needs at least one value in its list

onlyif transformer refused-empty-in
statement error
SELECT a FROM t WHERE a NOT IN ()
----
NOT IN needs at least one value in its list

onlyif transformer refused-hex-literal
statement error
SELECT x'303132' FROM t
----
A hexadecimal literal is not supported

onlyif transformer refused-parenthesized-join
statement error
SELECT l.a FROM (t AS l CROSS JOIN t AS r)
----
A parenthesized join in FROM is not supported; write the joins without the parentheses

onlyif transformer window-constant-key
statement error
SELECT a, RANK() OVER (ORDER BY 'b') FROM t
----
ORDER BY 'b' reads no column, so it orders nothing

onlyif transformer window-constant-key
statement error
SELECT a, SUM(b) OVER (PARTITION BY 1 + 0) FROM t
----
PARTITION BY 1 + 0 reads no column, so it partitions nothing
