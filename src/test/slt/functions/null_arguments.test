# A NULL argument makes every function's result NULL, in every position,
# the flow functions (COALESCE, IF, NULLIF, GREATEST, LEAST) aside, as
# DuckDB checks each function it declares NULL-propagating. Each argument is
# a typed NULL column, so the function binds as it would over data.

statement ok
CREATE TABLE n (s STRING, i INT, b BIGINT, d DOUBLE, m DECIMAL(9,2))

statement ok
INSERT INTO n VALUES (NULL, NULL, NULL, NULL, NULL)

query INT,INT,STRING,STRING,STRING
SELECT LENGTH(s), LEN(s), UPPER(s), LOWER(s), TRIM(s) FROM n
----
NULL	NULL	NULL	NULL	NULL

query STRING,STRING,STRING,STRING,STRING,STRING
SELECT SUBSTRING(s, 1), SUBSTRING('abc', i), SUBSTRING(s, 1, 2), SUBSTRING('abc', i, 2), SUBSTRING('abc', 1, i), SUBSTRING('abc', b, b) FROM n
----
NULL	NULL	NULL	NULL	NULL	NULL

query STRING,STRING,STRING
SELECT CONCAT(s, 'x'), CONCAT('x', s), s || 'x' FROM n
----
NULL	NULL	NULL

query INT,DOUBLE,DECIMAL(9,2),BIGINT
SELECT ABS(i), ABS(d), ABS(m), ABS(b) FROM n
----
NULL	NULL	NULL	NULL

query DOUBLE,DECIMAL(8,0),DOUBLE,DOUBLE,DECIMAL(9,1)
SELECT ROUND(d), ROUND(m), ROUND(d, 1), ROUND(1.5, i), ROUND(m, 1) FROM n
----
NULL	NULL	NULL	NULL	NULL

query DOUBLE,DOUBLE,DECIMAL(9,2),DOUBLE,DOUBLE
SELECT TRUNC(d), TRUNC(d, 1), TRUNCATE(m, 2), TRUNC(1.5, i), TRUNCATE(d) FROM n
----
NULL	NULL	NULL	NULL	NULL

query DOUBLE,DOUBLE,DOUBLE,INT,BIGINT
SELECT FLOOR(d), CEIL(d), CEILING(d), FLOOR(i), CEIL(b) FROM n
----
NULL	NULL	NULL	NULL	NULL

query DOUBLE,DOUBLE,DOUBLE,DOUBLE,DOUBLE,DOUBLE,DOUBLE
SELECT POW(d, 2), POW(2, d), POWER(d, 2), SQRT(d), CBRT(d), EXP(d), LN(d) FROM n
----
NULL	NULL	NULL	NULL	NULL	NULL	NULL

query DOUBLE,DOUBLE,DOUBLE,DOUBLE,DOUBLE
SELECT LOG(d), LOG(d, 2), LOG(2, d), LOG10(d), LOG2(d) FROM n
----
NULL	NULL	NULL	NULL	NULL

query DOUBLE,DOUBLE,DOUBLE,DOUBLE,DOUBLE,DOUBLE
SELECT SIN(d), COS(d), TAN(d), ASIN(d), ACOS(d), ATAN(d) FROM n
----
NULL	NULL	NULL	NULL	NULL	NULL

query DOUBLE,DOUBLE,DOUBLE,DOUBLE,DOUBLE,DOUBLE,DOUBLE
SELECT SINH(d), COSH(d), TANH(d), ATAN2(d, 1), ATAN2(1, d), DEGREES(d), RADIANS(d) FROM n
----
NULL	NULL	NULL	NULL	NULL	NULL	NULL

query INT,INT,INT,INT
SELECT SIGN(d), SIGN(i), MOD(i, 2), MOD(2, i) FROM n
----
NULL	NULL	NULL	NULL

query DOUBLE
SELECT RAND(i) FROM n
----
NULL

query INT,INT,BOOLEAN,BOOLEAN,BOOLEAN
SELECT i + 1, -i, i = 1, i < 1, s LIKE 'a%' FROM n
----
NULL	NULL	NULL	NULL	NULL

query DOUBLE,DATE,TIMESTAMP,STRING,INT
SELECT CAST(s AS DOUBLE), CAST(s AS DATE), CAST(s AS TIMESTAMP), CAST(i AS STRING), CAST(d AS INT) FROM n
----
NULL	NULL	NULL	NULL	NULL

# The flow functions decide on their own: the first non-NULL, the value of
# the branch taken, NULL only when every argument is.
query INT,INT,INT,INT,INT
SELECT COALESCE(i, 7), IF(i IS NULL, 1, 2), NULLIF(i, 1), GREATEST(i, 3), LEAST(i, 3) FROM n
----
7	1	NULL	3	3

# Over only NULLs, COUNT is 0 and every other aggregate NULL; COUNT(*)
# counts the row.
query BIGINT,BIGINT,BIGINT,DOUBLE,INT,INT,DECIMAL(38,2),DECIMAL(13,6)
SELECT COUNT(*), COUNT(i), SUM(i), AVG(i), MIN(i), MAX(i), SUM(m), AVG(m) FROM n
----
1	0	NULL	NULL	NULL	NULL	NULL	NULL

query DOUBLE,DOUBLE,DOUBLE,DOUBLE,BIGINT
SELECT STDDEV(d), VARIANCE(d), COVAR_SAMP(d, d), CORR(d, d), COUNT_IF(i > 0) FROM n
----
NULL	NULL	NULL	NULL	0

# Over no rows at all, the same.
query BIGINT,BIGINT,DOUBLE,INT,DOUBLE,BIGINT
SELECT COUNT(*), SUM(i), AVG(i), MAX(i), STDDEV(d), COUNT_IF(i > 0) FROM n WHERE i = 1
----
0	NULL	NULL	NULL	NULL	0
