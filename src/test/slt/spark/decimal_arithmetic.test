# describes; edit the converter, not this file.
#
# DECIMAL arithmetic: division and remainder by zero, two DECIMAL(38,18)
# columns under + - * / and beside an integer constant, constant expressions
# whose types the result-type rules give way on past 38 digits, and a UNION ALL
# of decimal casts. 26 of the file's 55 statements are here, 3 of them records
# the engine answers otherwise by a rule of the ledger in docs/gotchas.md,
# marked skipif transformer <id> and, for a rule that is no refusal, followed
# by its twin, onlyif transformer <id> with the engine's own answer.
#
# A statement is as Spark wrote it but where a rewrite cannot change what it
# means, which its record names: a temporary view of literals as a table of
# their types holding one row of them; USING parquet dropped; a decimal
# literal, a number with a point and no exponent or one with Spark's BD suffix,
# as the CAST of its text to the DECIMAL(p,s) Spark types it as (here a number
# with a point is a DOUBLE until it meets a DECIMAL). A column is the engine's
# type of the name Spark's schema gives it. A result is compared as rowsort
# unless its query ends in ORDER BY, as Spark sorts every result its plan does
# not. An error under ANSI is a statement error, Spark's error class in its
# comment and after ---- the engine's own words for the same reason.
#
# Skipped, by rule:
#      2  div-zero-null
#      1  double-literal
#
# Left out (29 statements), by what they need:
#     26  the half under spark.sql.decimalOperations.allowPrecisionLoss=false,
#         which gives a NULL or an error past 38 digits where this engine, as
#         Spark by default, gives way on the scale
#      2  Spark's function pmod()
#      1  Spark's operator div

# decimalArithmeticOperations.sql:18, the temporary view as a table of one row
statement ok
CREATE TABLE t (a DECIMAL(2,1), b DECIMAL(1,1))

statement ok
INSERT INTO t VALUES (1.0, 0.0)

# decimalArithmeticOperations.sql:21; Spark: DIVIDE_BY_ZERO
skipif transformer div-zero-null # a division or remainder by zero is NULL
statement error
select a / b from t

onlyif transformer div-zero-null
query DECIMAL(8,6) rowsort
select a / b from t
----
NULL

# decimalArithmeticOperations.sql:22; Spark: REMAINDER_BY_ZERO
skipif transformer div-zero-null # a division or remainder by zero is NULL
statement error
select a % b from t

onlyif transformer div-zero-null
query DECIMAL(1,1) rowsort
select a % b from t
----
NULL

# decimalArithmeticOperations.sql:26, USING parquet dropped
statement ok
create table decimals_test(id int, a decimal(38,18), b decimal(38,18))

# decimalArithmeticOperations.sql:28
statement ok
insert into decimals_test values(1, 100.0, 999.0), (2, 12345.123, 12345.123),
  (3, 0.1234567891011, 1234.1), (4, 123456789123456789.0, 1.123456789123456789)

# decimalArithmeticOperations.sql:32
query INT,DECIMAL(38,17),DECIMAL(38,17),DECIMAL(38,6),DECIMAL(38,6) nosort
select id, a+b, a-b, a*b, a/b from decimals_test order by id
----
1	1099.00000000000000000	-899.00000000000000000	99900.000000	0.100100
2	24690.24600000000000000	0.00000000000000000	152402061.885129	1.000000
3	1234.22345678910110000	-1233.97654321089890000	152.358023	0.000100
4	123456789123456790.12345678912345679	123456789123456787.87654321087654321	138698367904130467.515623	109890109097814272.043109

# decimalArithmeticOperations.sql:35
query INT,DECIMAL(38,15),DECIMAL(38,18) nosort
select id, a*10, b/10 from decimals_test order by id
----
1	1000.000000000000000	99.900000000000000000
2	123451.230000000000000	1234.512300000000000000
3	1.234567891011000	123.410000000000000000
4	1234567891234567890.000000000000000	0.112345678912345679

# decimalArithmeticOperations.sql:38; each decimal literal written as the CAST
# to Spark's DECIMAL type for it
query DECIMAL(6,2) rowsort
select CAST('10.3' AS DECIMAL(3,1)) * CAST('3.0' AS DECIMAL(2,1))
----
30.90

# decimalArithmeticOperations.sql:39; each decimal literal written as the CAST
# to Spark's DECIMAL type for it
query DECIMAL(9,5) rowsort
select CAST('10.3000' AS DECIMAL(6,4)) * CAST('3.0' AS DECIMAL(2,1))
----
30.90000

# decimalArithmeticOperations.sql:40; each decimal literal written as the CAST
# to Spark's DECIMAL type for it
query DECIMAL(11,6) rowsort
select CAST('10.30000' AS DECIMAL(7,5)) * CAST('30.0' AS DECIMAL(3,1))
----
309.000000

# decimalArithmeticOperations.sql:41; each decimal literal written as the CAST
# to Spark's DECIMAL type for it
query DECIMAL(38,34) rowsort
