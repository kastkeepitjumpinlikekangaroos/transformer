----
30.9000000000000000000000000000000000

# decimalArithmeticOperations.sql:43; each decimal literal written as the CAST
# to Spark's DECIMAL type for it
skipif transformer double-literal # a number written with an exponent beside a DECIMAL is the decimal it is written as
query DOUBLE rowsort
select 2.35E10 * CAST('1.0' AS DECIMAL(2,1))
----
2.35E10

onlyif transformer double-literal
query DECIMAL(14,1) rowsort
select 2.35E10 * CAST('1.0' AS DECIMAL(2,1))
----
23500000000.0

