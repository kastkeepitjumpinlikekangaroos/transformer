# describes; edit the converter, not this file.
#
# TRUE and FALSE compared with a value of each type. 37 of the file's 97
# statements are here, 4 of them records the engine answers otherwise by a rule
# of the ledger in docs/gotchas.md, marked skipif transformer <id> and, for a
# rule that is no refusal, followed by its twin, onlyif transformer <id> with
# the engine's own answer.
#
# A statement is as Spark wrote it but where a rewrite cannot change what it
# means, which its record names: a temporary view of literals as a table of
# their types holding one row of them; a timestamp's text cast to DATE as the
# DATE literal of its date (Spark's cast drops the time; this engine reads only
# an ISO date as a DATE, and a test of that cast is no test of its subject). A
# column is the engine's type of the name Spark's schema gives it. A result is
# compared as rowsort unless its query ends in ORDER BY, as Spark sorts every
# result its plan does not. An error under ANSI is a statement error, Spark's
# error class in its comment and after ---- the engine's own words for the same
# reason.
#
# Skipped, by rule:
#      4  refused-text-comparison
#
# Left out (60 statements), by what they need:
#     36  Spark's operator <=>
#      8  BINARY, and X'' literals
#      8  SMALLINT
#      8  TINYINT

# booleanEquality.sql:18, the temporary view as a table of one row
statement ok
CREATE TABLE t (c1 INT)

statement ok
INSERT INTO t VALUES (1)

# booleanEquality.sql:22; Spark: DATATYPE_MISMATCH.BINARY_OP_DIFF_TYPES
statement error
SELECT true = cast(1 as int) FROM t
----
Cannot compare BOOLEAN with INT

# booleanEquality.sql:23; Spark: DATATYPE_MISMATCH.BINARY_OP_DIFF_TYPES
statement error
SELECT true = cast(1 as bigint) FROM t
----
Cannot compare BOOLEAN with LONG

# booleanEquality.sql:24; Spark: DATATYPE_MISMATCH.BINARY_OP_DIFF_TYPES
statement error
SELECT true = cast(1 as float) FROM t
----
Cannot compare BOOLEAN with FLOAT

# booleanEquality.sql:25; Spark: DATATYPE_MISMATCH.BINARY_OP_DIFF_TYPES
statement error
SELECT true = cast(1 as double) FROM t
----
Cannot compare BOOLEAN with DOUBLE

# booleanEquality.sql:26; Spark: DATATYPE_MISMATCH.BINARY_OP_DIFF_TYPES
statement error
SELECT true = cast(1 as decimal(10, 0)) FROM t
----
Cannot compare BOOLEAN with DECIMAL(10,0)

# booleanEquality.sql:27
skipif transformer refused-text-comparison # text meets another type only as a string literal, which a DECIMAL reads none of
query BOOLEAN rowsort
SELECT true = cast(1 as string) FROM t
----
true

# booleanEquality.sql:29
query BOOLEAN rowsort
SELECT true = cast(1 as boolean) FROM t
----
true

