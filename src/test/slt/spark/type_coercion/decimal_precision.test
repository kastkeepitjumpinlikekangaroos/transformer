# From Apache Spark's SQL query tests (https://github.com/apache/spark):
# sql/core/src/test/resources/sql-tests/inputs/typeCoercion/native/decimalPrecision.sql
# at commit b98123545915a84403c7fa89e8d977ee0b2f5aed, with every answer from
# the golden file results/typeCoercion/native/decimalPrecision.sql.out at that
# commit, Spark's answer under ANSI mode, never the engine's. Licensed to the
# Apache Software Foundation under the Apache License, Version 2.0: LICENSE and
# NOTICE in src/test/slt/spark/ hold the license and Spark's notice. Written by
# //src/test/scala/com/transformer/slt:spark_import, which docs/extending.md
# describes; edit the converter, not this file.
#
# Every operator (+ - * / % = <> < <= > >=) of a value of each type beside a
# DECIMAL at four precisions. 673 of the file's 1145 statements are here, 151
# of them records the engine answers otherwise by a rule of the ledger in
# docs/gotchas.md, marked skipif transformer <id> and, for a rule that is no
# refusal, followed by its twin, onlyif transformer <id> with the engine's own
# answer.
#
# A statement is as Spark wrote it but where a rewrite cannot change what it
# means, which its record names: a temporary view of literals as a table of
# their types holding one row of them; a timestamp's text cast to DATE as the
# DATE literal of its date (Spark's cast drops the time; this engine reads only
# an ISO date as a DATE, and a test of that cast is no test of its subject). A
# column is the engine's type of the name Spark's schema gives it. A result is
# compared as rowsort unless its query ends in ORDER BY, as Spark sorts every
# result its plan does not. An error under ANSI is a statement error, Spark's
# error class in its comment and after ---- the engine's own words for the same
# reason.
#
# Skipped, by rule:
#     80  refused-decimal-beside-float
#     27  bigint-decimal
#     24  refused-text-comparison
#     20  refused-text-arithmetic
#
# Left out (472 statements), by what they need:
#    104  BINARY, and X'' literals
#    104  SMALLINT
#    104  TINYINT
#     64  Spark's function pmod()
#     64  Spark's operator <=>
#     32  both engines refuse it, for different reasons, which is no
#         agreement: each is held for the user (plans/testing/10)

# decimalPrecision.sql:18, the temporary view as a table of one row
statement ok
CREATE TABLE t (c1 INT)

statement ok
INSERT INTO t VALUES (1)

