# Runs under a Turkish locale, where "I".toLowerCase() is a dotless i: view,
# column, function, CAST-type and template-variable names, UPPER / LOWER, ILIKE
# and a directory job must behave as anywhere else; part file names and template
# values keep ASCII digits under a locale that prints others; and no compiled
# class of a module a job runs calls a default-locale conversion or format.
scala_junit_test(
    name = "locale_independence_test",
    srcs = ["LocaleIndependenceTest.scala"],
    jvm_flags = [
        "-Duser.language=tr",
        "-Duser.country=TR",
    ],
    suffixes = ["Test"],
    deps = [
        "//src/main/scala/com/transformer/cli",
        "//src/main/scala/com/transformer/core",
        "//src/main/scala/com/transformer/gui:session",
        "//src/main/scala/com/transformer/job",
        "//src/main/scala/com/transformer/read/csv",
        "//src/main/scala/com/transformer/read/parquet",
        "//src/main/scala/com/transformer/sql/exec",
        "//src/main/scala/com/transformer/sql/parse",
        "//src/main/scala/com/transformer/sql/plan",
        "//src/main/scala/com/transformer/temporal",
        "//src/main/scala/com/transformer/write/csv",
        "//src/main/scala/com/transformer/write/parquet",
        "@maven//:junit_junit",
    ],
)
