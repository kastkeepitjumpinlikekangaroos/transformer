load("@rules_scala//scala:scala.bzl", "scala_junit_test")

scala_junit_test(
    name = "data_job_test",
    srcs = [
        "DataJobTest.scala",
        # The job the fault matrices run, and the main a child JVM runs it through.
        "FaultJob.scala",
    ],
    suffixes = ["Test"],
    deps = [
        "//src/main/scala/com/transformer/core",
        "//src/main/scala/com/transformer/job",
        "//src/main/scala/com/transformer/sql/exec",
        "//src/main/scala/com/transformer/temporal",
        # A parquet input with no row groups, written by our own writer.
        "//src/main/scala/com/transformer/write/parquet",
        "@maven//:junit_junit",
    ],
)

# Under chaos, a job that reads, spills a sharded aggregate, writes and hands
# its output on passes every chaos point and answers as it does without them.
scala_junit_test(
    name = "chaos_job_test",
    srcs = ["ChaosJobTest.scala"],
    suffixes = ["Test"],
    jvm_flags = [
        "-Dtransformer.chaos=7",
        "-Dtransformer.scheduler.shard_min_size=1",
        "-Dtransformer.scheduler.broadcast_threshold=1",
        "-Dtransformer.scheduler.shard_count=4",
    ],
    deps = [
        "//src/main/scala/com/transformer/core",
        "//src/main/scala/com/transformer/job",
        "@maven//:junit_junit",
    ],
)

