load("@rules_scala//scala:scala.bzl", "scala_junit_test")

# The data viewer's model with no JavaFX on the classpath: it depends on
# `viewer:model` alone. Each test runs real jobs into a temporary folder
# (Fixtures.scala) and reads them back as the viewer does.
scala_junit_test(
    name = "model_test",
    srcs = glob(["*.scala"]),
    suffixes = ["Test"],
    deps = [
        "//src/main/scala/com/transformer/core",
        "//src/main/scala/com/transformer/job",
        "//src/main/scala/com/transformer/sql/exec",
        "//src/main/scala/com/transformer/temporal",
        "//src/main/scala/com/transformer/viewer:model",
        "@maven//:junit_junit",
    ],
)
