load("@rules_scala//scala:scala.bzl", "scala_junit_test", "scala_library")

scala_junit_test(
    name = "parquet_roundtrip_test",
    srcs = ["ParquetRoundtripTest.scala"],
    suffixes = ["Test"],
    deps = [
        "//src/main/scala/com/transformer/core",
        "//src/main/scala/com/transformer/job",
        "//src/main/scala/com/transformer/read/parquet",
        # sql/plan supplies Expr — needed to construct the predicate fed to
        # ParquetReader.withPushdownFilter in the pushdown test.
        "//src/main/scala/com/transformer/sql/plan",
        "//src/main/scala/com/transformer/write/parquet",
        "@maven//:junit_junit",
    ],
)

scala_junit_test(
    name = "parquet_filter_translator_test",
    srcs = ["ParquetFilterTranslatorTest.scala"],
    suffixes = ["Test"],
    deps = [
        "//src/main/scala/com/transformer/core",
        "//src/main/scala/com/transformer/read/parquet",
        "//src/main/scala/com/transformer/sql/plan",
        "//src/main/scala/com/transformer/write/parquet",
        # parquet-column exports FilterPredicate; the translator's public
        # return type leaks it to callers, so strict-deps wants it here even
        # though the test itself never names it.
        "@maven//:org_apache_parquet_parquet_column",
        "@maven//:junit_junit",
    ],
)

# Parquet written and read by parquet-mr's own example object model, never by
# transformer's writer or reader, so a test can hold either one against an
# implementation that is not ours. testonly, and public so other test packages
# can build external fixtures too.
scala_library(
    name = "external_parquet",
    testonly = True,
    srcs = ["ExternalParquet.scala"],
    visibility = ["//visibility:public"],
    deps = [
        "@maven//:org_apache_hadoop_hadoop_common",
        "@maven//:org_apache_parquet_parquet_column",
        "@maven//:org_apache_parquet_parquet_common",
        "@maven//:org_apache_parquet_parquet_hadoop",
    ],
    # A schema here is parquet-mr's MessageType, so every user needs it.
    exports = ["@maven//:org_apache_parquet_parquet_column"],
    # parquet-mr's reader reaches Hadoop's mapreduce classes (FileInputFormat)
    # at run time; read/parquet carries them too, but this library must work
    # in a test that never touches our reader.
    runtime_deps = [
        "@maven//:commons_collections_commons_collections",
        "@maven//:org_apache_hadoop_hadoop_mapreduce_client_core",
        "@maven//:org_slf4j_slf4j_nop",
    ],
)

scala_junit_test(
    name = "parquet_external_format_test",
    srcs = ["ParquetExternalFormatTest.scala"],
    suffixes = ["Test"],
    deps = [
        ":external_parquet",
        "//src/main/scala/com/transformer/core",
        "//src/main/scala/com/transformer/read/parquet",
        "//src/main/scala/com/transformer/sql/exec",
        # sql/plan supplies the Expr handed to ParquetReader.withPushdownFilter.
        "//src/main/scala/com/transformer/sql/plan",
        "//src/main/scala/com/transformer/write/parquet",
        "@maven//:org_apache_parquet_parquet_column",
        "@maven//:junit_junit",
    ],
)
