load("@rules_scala//scala:scala.bzl", "scala_junit_test", "scala_library")

# Shared property-based testing harness (Rng, Props, Shrinker, RowOracle) plus
# the generators (ExprGen, DataGen, QueryGen, MetaQueryGen, SqlTextGen,
# JobDagGen, ParquetGen) and the oracles. testonly so it never leaks into a
# production target. Throws plain AssertionError on failure, so it needs no
# JUnit dependency — only the code it generates over: the SQL exec module (the
# mode-differential oracle drives whole queries through SqlEngine.execute), the
# job module (the DAG-scheduler oracle builds and runs whole DataJobs), the
# GUI's session state (the hydration oracle reopens those runs in a JobSession;
# `gui:session` carries no JavaFX), and the parquet reader, held against files
# parquet-mr writes through the testonly external_parquet helper.
scala_library(
    name = "fuzz",
    testonly = True,
    srcs = glob(
        ["**/*.scala"],
        exclude = ["**/*Test.scala"],
    ),
    visibility = ["//visibility:public"],
    deps = [
        "//src/main/scala/com/transformer/core",
        "//src/main/scala/com/transformer/gui:session",
        "//src/main/scala/com/transformer/job",
        "//src/main/scala/com/transformer/read/csv",
        "//src/main/scala/com/transformer/read/parquet",
        "//src/main/scala/com/transformer/sql/exec",
        "//src/main/scala/com/transformer/sql/parse",
        "//src/main/scala/com/transformer/sql/plan",
        "//src/main/scala/com/transformer/temporal",
        "//src/test/scala/com/transformer/read/parquet:external_parquet",
        "//src/main/scala/com/transformer/write/csv",
    ],
)

