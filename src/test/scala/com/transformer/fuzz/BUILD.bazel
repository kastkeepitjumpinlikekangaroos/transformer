# The DAG-scheduler fuzzer with the shared pool deliberately STARVED: two worker
# threads for a job of up to ten tasks, each of which fans its own nested work
# (scan partitions, writer parts, shuffle shards) onto that same pool. Every
# await in the engine is a work-helping `ForkJoinTask.get()`, so this must still
# terminate; a wedge here is the pool-starvation deadlock the sharded exchange
# work has been chasing, and it fails with a thread dump rather than hanging.
# The sharding gates are on too, so task bodies also build exchanges.
scala_junit_test(
    name = "starved_dag_scheduler_fuzz_campaign",
    srcs = ["DagSchedulerFuzzTest.scala"],
    suffixes = ["Test"],
    jvm_flags = [
        "-Dtransformer.scheduler.parallelism=2",
        "-Dtransformer.scheduler.shard_min_size=1",
        "-Dtransformer.scheduler.broadcast_threshold=1",
        "-Dtransformer.scheduler.shard_count=4",
    ],
    tags = ["fuzz"],
    deps = [
        ":fuzz",
        "//src/main/scala/com/transformer/core",
        "//src/main/scala/com/transformer/job",
        "@maven//:junit_junit",
    ],
)

