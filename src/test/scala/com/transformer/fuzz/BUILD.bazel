load("@rules_scala//scala:scala.bzl", "scala_junit_test", "scala_library")

# Shared property-based testing harness (Rng, Props, Shrinker, RowOracle) plus
# the generators (ExprGen, DataGen, QueryGen, MetaQueryGen, JobDagGen) and the
# oracles. testonly so it never leaks into a production target. Throws plain
# AssertionError on failure, so it needs no JUnit dependency — only the code it
# generates over: the SQL exec module (the mode-differential oracle drives whole
# queries through SqlEngine.execute) and the job module (the DAG-scheduler oracle
# builds and runs whole DataJobs).
scala_library(
    name = "fuzz",
    testonly = True,
    srcs = glob(
        ["**/*.scala"],
        exclude = ["**/*Test.scala"],
    ),
    visibility = ["//visibility:public"],
    deps = [
        "//src/main/scala/com/transformer/core",
        "//src/main/scala/com/transformer/job",
        "//src/main/scala/com/transformer/sql/exec",
        "//src/main/scala/com/transformer/sql/plan",
    ],
)

# eval-vs-evalVec parity fuzzer. Default budget (Props.DefaultSeeds) — part of
# the normal `bazel test //...` run.
scala_junit_test(
    name = "expr_parity_fuzz_test",
    srcs = ["ExprParityFuzzTest.scala"],
    suffixes = ["Test"],
    deps = [
        ":fuzz",
        "//src/main/scala/com/transformer/core",
        "//src/main/scala/com/transformer/sql/plan",
        "@maven//:junit_junit",
    ],
)

# Mode-differential fuzzer: one (data, query) under spill on/off, metrics on/off,
# and several partition/batch layouts must agree on the result multiset. Default
# budget is small (the engine runs once per mode), part of `bazel test //...`.
scala_junit_test(
    name = "mode_differential_fuzz_test",
    srcs = ["ModeDifferentialFuzzTest.scala"],
    suffixes = ["Test"],
    deps = [
        ":fuzz",
        "//src/main/scala/com/transformer/core",
        "//src/main/scala/com/transformer/sql/plan",
        "@maven//:junit_junit",
    ],
)

# Metamorphic fuzzer: multi-relation SELECTs (joins of every kind, self-joins)
# checked against five relations decided by SQL semantics alone -- TLP, NoREC,
# multi-relation mode agreement, join commutativity (A JOIN B == B JOIN A with
# the kind flipped, the only one that varies the build side), and aggregate
# decomposition (one-shot == group-then-re-aggregate, which drives the
# partial/final merge and AggState spill serde). Finds SEMANTIC bugs (wrong
# answers every execution mode agrees on). Default budget is small (each case
# runs the engine several times), part of `bazel test //...`.
scala_junit_test(
    name = "metamorphic_fuzz_test",
    srcs = ["MetamorphicFuzzTest.scala"],
    suffixes = ["Test"],
    deps = [
        ":fuzz",
        "//src/main/scala/com/transformer/core",
        "//src/main/scala/com/transformer/sql/plan",
        "@maven//:junit_junit",
    ],
)

# The metamorphic gate re-run under SHARDED planning. The sharding gates
# (LogicalPlanCardinality.{MinShardableSize, BroadcastBuildThreshold}) are vals
# read at class load, so they need a separate JVM: jvm_flags set both to 1,
# forcing every query onto the shuffle-join + sharded-aggregate paths the
# default gate never exercises. Untagged, so it runs as part of
# `bazel test //...`.
scala_junit_test(
    name = "sharded_mode_fuzz_test",
    srcs = ["ShardedModeFuzzTest.scala"],
    suffixes = ["Test"],
    jvm_flags = [
        "-Dtransformer.scheduler.shard_min_size=1",
        "-Dtransformer.scheduler.broadcast_threshold=1",
        # K=4 pins a fixed multi-shard fan-out, so every breaker splits into four
        # shards and this target exercises real nested multi-shard plans (a breaker
        # over an exchange over a breaker ...), deterministically across hosts of
        # different core counts -- and the deterministic default seed budget keeps
        # this green in seconds. The K>1 campaign-volume hard-deadlock this
        # target used to hit (helpJoin inlining a consumer of an exchange
        # beneath that exchange's own materialization frames -- reproduced
        # 2026-07-23 at FUZZ_SEEDS=20000, plans/bugfixes/02e) is FIXED by
        # bottom-up exchange pre-materialization (plans/bugfixes/02f): the
        # 20000-seed campaign now completes. Still pass --test_timeout on long
        # campaigns as hygiene. A ForkJoinPool.managedBlock "compensation"
        # variant (02b) was tried and reverted: it wedged the pool even faster
        # (spare-thread storm under deep K-shard nesting). A fixed K rather
        # than the default (= Scheduler.parallelism) keeps CI wall time from
        # drifting with availableProcessors.
        "-Dtransformer.scheduler.shard_count=4",
    ],
    deps = [
        ":fuzz",
        "//src/main/scala/com/transformer/core",
        "//src/main/scala/com/transformer/sql/plan",
        "@maven//:junit_junit",
    ],
)

# DAG-scheduler fuzzer: a generated job (inputs + a task DAG, some rigged to
# fail) must schedule to the statuses, orderings and timestamps the DAG alone
# implies, and must terminate. Covers `DataJob.runUnifiedDag` — readiness
# counting, skip propagation, and pool liveness when many tasks each fan nested
# work onto the same shared Scheduler pool. Default budget is small (every case
# runs a whole job with real file I/O), part of `bazel test //...`.
scala_junit_test(
    name = "dag_scheduler_fuzz_test",
    srcs = ["DagSchedulerFuzzTest.scala"],
    suffixes = ["Test"],
    deps = [
        ":fuzz",
        "//src/main/scala/com/transformer/core",
        "//src/main/scala/com/transformer/job",
        "@maven//:junit_junit",
    ],
)

