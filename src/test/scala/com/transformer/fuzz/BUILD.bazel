load("@rules_scala//scala:scala.bzl", "scala_junit_test", "scala_library")

# Shared property-based testing harness (Rng, Props, Shrinker, RowOracle) plus
# the generators (ExprGen, DataGen, QueryGen) and the parity oracles. testonly so
# it never leaks into a production target. Throws plain AssertionError on failure,
# so it needs no JUnit dependency — only the engine it generates over. Depends on
# the SQL exec module because the mode-differential oracle drives whole queries
# through SqlEngine.execute.
scala_library(
    name = "fuzz",
    testonly = True,
    srcs = glob(
        ["**/*.scala"],
        exclude = ["**/*Test.scala"],
    ),
    visibility = ["//visibility:public"],
    deps = [
        "//src/main/scala/com/transformer/core",
        "//src/main/scala/com/transformer/sql/exec",
        "//src/main/scala/com/transformer/sql/plan",
    ],
)

# eval-vs-evalVec parity fuzzer. Default budget (Props.DefaultSeeds) — part of
# the normal `bazel test //...` run.
scala_junit_test(
    name = "expr_parity_fuzz_test",
    srcs = ["ExprParityFuzzTest.scala"],
    suffixes = ["Test"],
    deps = [
        ":fuzz",
        "//src/main/scala/com/transformer/core",
        "//src/main/scala/com/transformer/sql/plan",
        "@maven//:junit_junit",
    ],
)

# Mode-differential fuzzer: one (data, query) under spill on/off, metrics on/off,
# and several partition/batch layouts must agree on the result multiset. Default
# budget is small (the engine runs once per mode), part of `bazel test //...`.
scala_junit_test(
    name = "mode_differential_fuzz_test",
    srcs = ["ModeDifferentialFuzzTest.scala"],
    suffixes = ["Test"],
    deps = [
        ":fuzz",
        "//src/main/scala/com/transformer/core",
        "//src/main/scala/com/transformer/sql/plan",
        "@maven//:junit_junit",
    ],
)

# Metamorphic fuzzer: multi-relation SELECTs (joins of every kind, self-joins)
# checked against the TLP and NoREC metamorphic relations + multi-relation mode
# agreement. Finds SEMANTIC bugs (wrong answers every execution mode agrees on).
# Default budget is small (each case runs the engine several times), part of
# `bazel test //...`.
scala_junit_test(
    name = "metamorphic_fuzz_test",
    srcs = ["MetamorphicFuzzTest.scala"],
    suffixes = ["Test"],
    deps = [
        ":fuzz",
        "//src/main/scala/com/transformer/core",
        "//src/main/scala/com/transformer/sql/plan",
        "@maven//:junit_junit",
    ],
)

# The metamorphic gate re-run under SHARDED planning. The sharding gates
# (LogicalPlanCardinality.{MinShardableSize, BroadcastBuildThreshold}) are vals
# read at class load, so they need a separate JVM: jvm_flags set both to 1,
# forcing every query onto the shuffle-join + sharded-aggregate paths the
# default gate never exercises. Untagged, so it runs as part of
# `bazel test //...`.
scala_junit_test(
    name = "sharded_mode_fuzz_test",
    srcs = ["ShardedModeFuzzTest.scala"],
    suffixes = ["Test"],
    jvm_flags = [
        "-Dtransformer.scheduler.shard_min_size=1",
        "-Dtransformer.scheduler.broadcast_threshold=1",
        # K=4 pins a fixed multi-shard fan-out, so every breaker splits into four
        # shards and this target exercises real nested multi-shard plans (a breaker
        # over an exchange over a breaker ...), deterministically across hosts of
        # different core counts -- and the deterministic default seed budget keeps
        # this green in seconds. NOTE: sharded execution at K>1 CAN hard-deadlock
        # the shared Scheduler.pool at campaign volume (reproduced 2026-07-23 at
        # FUZZ_SEEDS=20000: an exchange's materializing winner awaits a shard task
        # on a worker under whose frame ForkJoinTask.get()'s helpJoin inlined a
        # consumer of that same exchange -- a cycle no monitor-vs-latch choice
        # avoids; see docs/gotchas.md and plans/bugfixes/02e). Long campaigns may
        # therefore wedge until non-blocking materialization (plan 02 Option D)
        # lands -- always pass --test_timeout. A ForkJoinPool.managedBlock
        # "compensation" variant (02b) was tried and reverted: it wedged the pool
        # even faster (spare-thread storm under deep K-shard nesting). A fixed K
        # rather than the default (= Scheduler.parallelism) keeps CI wall time
        # from drifting with availableProcessors.
        "-Dtransformer.scheduler.shard_count=4",
    ],
    deps = [
        ":fuzz",
        "//src/main/scala/com/transformer/core",
        "//src/main/scala/com/transformer/sql/plan",
        "@maven//:junit_junit",
    ],
)

# Long-campaign variants. Tagged `fuzz` so the default `bazel test //...`
# (--test_tag_filters=-perf,-fuzz) skips them; run on demand with a large budget,
# e.g.:
#   bazel test //src/test/scala/com/transformer/fuzz:mode_differential_fuzz_campaign \
#       --test_env=FUZZ_SEEDS=50000 --nocache_test_results --test_timeout=3600
# The env-var path reliably re-runs the action (a --jvmopt change can hit the
# cached result).
scala_junit_test(
    name = "expr_parity_fuzz_campaign",
    srcs = ["ExprParityFuzzTest.scala"],
    suffixes = ["Test"],
    tags = ["fuzz"],
    deps = [
        ":fuzz",
        "//src/main/scala/com/transformer/core",
        "//src/main/scala/com/transformer/sql/plan",
        "@maven//:junit_junit",
    ],
)

