load("@rules_scala//scala:scala.bzl", "scala_junit_test", "scala_library")

# Shared property-based testing harness (Rng, Props, Shrinker, RowOracle) plus
# the Expr generator and the eval-vs-evalVec parity oracle. testonly so it never
# leaks into a production target. Throws plain AssertionError on failure, so it
# needs no JUnit dependency — only the engine it generates over.
scala_library(
    name = "fuzz",
    testonly = True,
    srcs = glob(
        ["**/*.scala"],
        exclude = ["**/*Test.scala"],
    ),
    visibility = ["//visibility:public"],
    deps = [
        "//src/main/scala/com/transformer/core",
        "//src/main/scala/com/transformer/sql/plan",
    ],
)

scala_junit_test(
    name = "expr_parity_fuzz_test",
    srcs = ["ExprParityFuzzTest.scala"],
    suffixes = ["Test"],
    deps = [
        ":fuzz",
        "//src/main/scala/com/transformer/core",
        "//src/main/scala/com/transformer/sql/plan",
        "@maven//:junit_junit",
    ],
)
