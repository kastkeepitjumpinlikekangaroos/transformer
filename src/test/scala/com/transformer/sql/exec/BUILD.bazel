# Plan 09 Phase 8 stress test. Pushes each spill-capable operator through
# many spill rounds against a synthetic dataset and verifies output via
# closed-form analytical checks (no in-memory oracle). Stays under ~20s
# on a modest box so it runs as part of `bazel test //...`; for real
# above-heap pressure, scale the row counts up and run with `-Xmx` outside
# Bazel.
scala_junit_test(
    name = "spill_stress_test",
    srcs = ["SpillStressTest.scala"],
    suffixes = ["Test"],
    deps = [
        "//src/main/scala/com/transformer/core",
        "//src/main/scala/com/transformer/sql/exec",
        "//src/main/scala/com/transformer/sql/plan",
        "@maven//:junit_junit",
