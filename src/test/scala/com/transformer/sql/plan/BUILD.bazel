# The rejection pass's audit (UnsupportedClauses) checked against the two
# things it can drift from: the JSqlParser jar and LogicalBuilder's compiled
# bytecode, whose constant pool says which getters the binder actually reads.
# Every public getter / field of every audited class must be read, rejected or
# inert exactly once; every class the binder reaches (and every subclass of an
# audited class) must be audited; every rejection's example must reach that
# rejection; supported SQL must pass untouched; and every construct the binder
# refuses by name must have a name in SQL's words.
scala_junit_test(
    name = "unsupported_clauses_test",
    srcs = ["UnsupportedClausesTest.scala"],
    suffixes = ["Test"],
    deps = [
        "//src/main/scala/com/transformer/core",
        "//src/main/scala/com/transformer/sql/parse",
        "//src/main/scala/com/transformer/sql/plan",
        "@maven//:com_github_jsqlparser_jsqlparser",
        "@maven//:junit_junit",
    ],
)

# FunctionCatalog against what it must agree with: README.md's lists of
# functions and CAST types, both ways, read by their bold labels; the binder,
# which binds every entry at each declared arity and refuses every other with
# the catalog's message; the ledger in docs/gotchas.md, which has a row for
# every rule an entry cites; and Funcs.applyVec.
scala_junit_test(
    name = "function_catalog_test",
    srcs = ["FunctionCatalogTest.scala"],
    data = [
        "//:README.md",
        "//:docs/gotchas.md",
    ],
    suffixes = ["Test"],
    deps = [
        "//src/main/scala/com/transformer/core",
        "//src/main/scala/com/transformer/sql/plan",
        "//src/test/scala/com/transformer/fuzz",
        "//src/test/scala/com/transformer/slt",
        "@maven//:junit_junit",
    ],
)

# The engine's rules as tables (docs/testing.md, "Semantics tables"): the
# cast matrix, the coercion tables and the function sweep, each generated by
# SemanticsTables over one-column tables, on the row path and the vector path.
scala_library(
    name = "semantics",
    testonly = True,
    srcs = [
        "CastMatrix.scala",
        "Semantics.scala",
        "SemanticsTables.scala",
    ],
    deps = [
        "//src/main/scala/com/transformer/core",
        "//src/main/scala/com/transformer/sql/plan",
        "//src/test/scala/com/transformer/fuzz",
        "//src/test/scala/com/transformer/slt",
    ],
)

# `bazel run //src/test/scala/com/transformer/sql/plan:semantics_tables -- --update`
# rewrites src/test/semantics/*.txt in the workspace; without --update it
# prints each table's diff against its file.
scala_binary(
    name = "semantics_tables",
    testonly = True,
    main_class = "com.transformer.sql.plan.SemanticsTables",
    deps = [":semantics"],
)

# Each table is its file under src/test/semantics, line for line (a
# difference fails with its unified diff), the two evaluation paths agree on
# every cell, and every error a cell shows is clean by CleanRejection's rule.
scala_junit_test(
    name = "semantics_tables_test",
    srcs = ["SemanticsTablesTest.scala"],
    data = ["//src/test/semantics:tables"],
    suffixes = ["Test"],
    deps = [
        ":semantics",
        "//src/test/scala/com/transformer/fuzz",
        "@maven//:junit_junit",
    ],
)
