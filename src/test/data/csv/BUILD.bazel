# CSV files and cases other programs wrote (README.md: DuckDB's, PapaParse's
# and csv-spectrum's, each under its own licence), held by
# //src/test/scala/com/transformer/read/csv:csv_corpus_test to the lines of
# MANIFEST, which the ledger in docs/gotchas.md also cites.
filegroup(
    name = "files",
    srcs = glob(
        ["**"],
        exclude = ["BUILD.bazel"],
    ),
    visibility = ["//visibility:public"],
)

filegroup(
    name = "manifest",
    srcs = ["MANIFEST"],
    visibility = ["//visibility:public"],
)
