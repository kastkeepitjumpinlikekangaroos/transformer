load("@rules_scala//scala:scala.bzl", "scala_library")

scala_library(
    name = "parquet",
    srcs = glob(["**/*.scala"]),
    visibility = ["//visibility:public"],
    deps = [
        "//src/main/scala/com/transformer/core",
        "@maven//:org_apache_hadoop_hadoop_common",
        "@maven//:org_apache_parquet_parquet_column",
        "@maven//:org_apache_parquet_parquet_common",
        "@maven//:org_apache_parquet_parquet_hadoop",
    ],
    # What parquet-mr and Hadoop load as they run, which no source here names
    # and parquet-hadoop's own dependencies leave out: Hadoop's mapreduce
    # classes and commons-collections.
    runtime_deps = [
        "@maven//:commons_collections_commons_collections",
        "@maven//:org_apache_hadoop_hadoop_mapreduce_client_core",
    ],
)
