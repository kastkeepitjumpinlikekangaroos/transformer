load("@rules_scala//scala:scala.bzl", "scala_library")

# The `transformer` command line without the GUI: argument parsing, the
# headless `run` command, and `query` (SQL over files, one-off or in a JLine
# shell). No JavaFX, so a test drives it directly. gui:session is the GUI's
# toolkit-free job session, which `query --job` reads a job through as the
# GUI's SQL console does.
scala_library(
    name = "cli",
    srcs = [
        "Cli.scala",
        "QuerySession.scala",
        "ResultPrinter.scala",
        "Shell.scala",
        "SqlScript.scala",
    ],
    visibility = ["//visibility:public"],
    deps = [
        "//src/main/scala/com/transformer/core",
        "//src/main/scala/com/transformer/gui:session",
        "//src/main/scala/com/transformer/job",
        "//src/main/scala/com/transformer/read/csv",
        "//src/main/scala/com/transformer/sql/exec",
        "//src/main/scala/com/transformer/sql/parse",
        "//src/main/scala/com/transformer/sql/plan",
        "//src/main/scala/com/transformer/temporal",
        "//src/main/scala/com/transformer/write/csv",
        "//src/main/scala/com/transformer/write/parquet",
        "@maven//:org_jline_jline",
    ],
)

# The entry point of the single deploy jar (//:transformer): dispatches `gui`
# to JavaFX and every other command to :cli.
scala_library(
    name = "main",
    srcs = ["TransformerMain.scala"],
    visibility = ["//:__pkg__"],
    deps = [
        ":cli",
        "//src/main/scala/com/transformer/core",
        "//src/main/scala/com/transformer/gui",
        "//src/main/scala/com/transformer/sql/exec",
    ],
)
