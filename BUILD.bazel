# Root build file for transformer project.
load("@rules_scala//scala:scala.bzl", "scala_binary")

# The one jar a user needs: `bazel build //:transformer_deploy.jar`, then
# `java -jar bazel-bin/transformer_deploy.jar run <jobDir>` (headless) or
# `... gui [jobDir]` (desktop GUI). See README.md "Command line".
scala_binary(
    name = "transformer",
    main_class = "com.transformer.cli.TransformerMain",
    # Scale the heap to the machine, as the GUI launcher does. `java -jar
    # transformer_deploy.jar` bypasses this; pass -Xmx explicitly there.
    jvm_flags = ["-XX:MaxRAMPercentage=75.0"],
    deps = [
        "//src/main/scala/com/transformer/cli:main",
        # JavaFX classes live in the platform classifier jars; ship mac and
        # Windows so `gui` works on both, as //examples/gui_app does for mac.
        "@maven//:org_openjfx_javafx_base_mac_aarch64",
        "@maven//:org_openjfx_javafx_base_win",
        "@maven//:org_openjfx_javafx_controls_mac_aarch64",
        "@maven//:org_openjfx_javafx_controls_win",
        "@maven//:org_openjfx_javafx_graphics_mac_aarch64",
        "@maven//:org_openjfx_javafx_graphics_win",
    ],
)

# The data viewer, a jar of its own: `bazel build //:transformer_viewer_deploy.jar`,
# then `java -jar bazel-bin/transformer_viewer_deploy.jar [folder]` queries
# every job output in a folder in SQL and inspects each table: its rows, its
# columns, its run's record of it, and its lineage. See README.md "Data viewer".
scala_binary(
    name = "transformer_viewer",
    main_class = "com.transformer.viewer.ViewerMain",
    jvm_flags = ["-XX:MaxRAMPercentage=75.0"],
    deps = [
        "//src/main/scala/com/transformer/viewer",
        "@maven//:org_openjfx_javafx_base_mac_aarch64",
        "@maven//:org_openjfx_javafx_base_win",
        "@maven//:org_openjfx_javafx_controls_mac_aarch64",
        "@maven//:org_openjfx_javafx_controls_win",
        "@maven//:org_openjfx_javafx_graphics_mac_aarch64",
        "@maven//:org_openjfx_javafx_graphics_win",
    ],
)
