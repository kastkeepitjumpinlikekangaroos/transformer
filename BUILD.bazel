# Root build file for transformer project.
load("@rules_scala//scala:scala.bzl", "scala_binary")
load("@rules_scala//scala:scala_toolchain.bzl", "scala_toolchain")

# The one jar a user needs: `bazel build //:transformer_deploy.jar`, then
# `java -jar bazel-bin/transformer_deploy.jar run <jobDir>` (headless) or
# `... gui [jobDir]` (desktop GUI). See README.md "Command line".
scala_binary(
    name = "transformer",
    main_class = "com.transformer.cli.TransformerMain",
    # Scale the heap to the machine, as the GUI launcher does. `java -jar
    # transformer_deploy.jar` bypasses this; pass -Xmx explicitly there.
    jvm_flags = ["-XX:MaxRAMPercentage=75.0"],
    deps = [
        "//src/main/scala/com/transformer/cli:main",
        # JavaFX classes live in the platform classifier jars; ship mac and
        # Windows so `gui` works on both, as //examples/gui_app does for mac.
        "@maven//:org_openjfx_javafx_base_mac_aarch64",
        "@maven//:org_openjfx_javafx_base_win",
        "@maven//:org_openjfx_javafx_controls_mac_aarch64",
        "@maven//:org_openjfx_javafx_controls_win",
        "@maven//:org_openjfx_javafx_graphics_mac_aarch64",
        "@maven//:org_openjfx_javafx_graphics_win",
    ],
)

# The data viewer, a jar of its own: `bazel build //:transformer_viewer_deploy.jar`,
# then `java -jar bazel-bin/transformer_viewer_deploy.jar [folder]` queries
# every job output in a folder in SQL and inspects each table: its rows, its
# columns, its run's record of it, and its lineage. See README.md "Data viewer".
scala_binary(
    name = "transformer_viewer",
    main_class = "com.transformer.viewer.ViewerMain",
    jvm_flags = ["-XX:MaxRAMPercentage=75.0"],
    deps = [
        "//src/main/scala/com/transformer/viewer",
        "@maven//:org_openjfx_javafx_base_mac_aarch64",
        "@maven//:org_openjfx_javafx_base_win",
        "@maven//:org_openjfx_javafx_controls_mac_aarch64",
        "@maven//:org_openjfx_javafx_controls_win",
        "@maven//:org_openjfx_javafx_graphics_mac_aarch64",
        "@maven//:org_openjfx_javafx_graphics_win",
    ],
)

# The Scala toolchain every target compiles with, registered in MODULE.bazel
# ahead of rules_scala's default: the same Scala 2.13.16 jars, and the
# compiler's warnings as errors. A warning only prints when its target
# compiles, and a cached target never does, so a warning that did not fail the
# build would be seen once. docs/conventions.md lists the checks and how to
# silence one site with @nowarn.
SCALA_JARS = [
    "@rules_scala_toolchains//scala:scala_xml_provider",
    "@rules_scala_toolchains//scala:parser_combinators_provider",
    "@rules_scala_toolchains//scala:scala_compile_classpath_provider",
    "@rules_scala_toolchains//scala:scala_library_classpath_provider",
    "@rules_scala_toolchains//scala:scala_macro_classpath_provider",
]

scala_toolchain(
    name = "scala_toolchain_impl",
    dep_providers = SCALA_JARS,
    scalacopts = [
        # Each deprecation and feature in full, not as a count.
        "-deprecation",
        "-feature",
        # Imports, private members, locals, pattern variables and implicit
        # parameters nothing uses, and an @nowarn that silences nothing. Not
        # explicit parameters: an unused one is often part of a call shape.
        "-Wunused:imports,privates,locals,patvars,implicits,nowarn",
        # A match with no case for some value of a type that is not sealed
        # (the exhaustivity check covers sealed ones); a plain string holding
        # `$name` or `${...}`; a pattern variable named as a term in scope.
        "-Xlint:strict-unsealed-patmat,missing-interpolator,pattern-shadow",
        # A statement whose value nothing reads ("unused value of type ...").
        "-Wnonunit-statement",
        "-Wconf:" + ",".join([
            "cat=deprecation:e",
            "cat=feature:e",
            "cat=unused:e",
            "cat=other-match-analysis:e",
            "cat=lint-missing-interpolator:e",
            "cat=other-shadowing:e",
            "cat=other-pure-statement:e",
        ]),
        # Tests drop values on purpose (a fixture made for what making it
        # writes, a drained iterator, a JUnit call's result), so the unused
        # value check is main code's alone. The path is the source's real
        # one, a suffix of the workspace path, never the sandbox's.
        "-Wconf:src=src/test/scala/.*&cat=other-pure-statement&msg=^unused value:s",
        # rules_scala's own Scala sources (the test runner's discovery of
        # test classes, the unused-dependency checker's analyzer) compile
        # with this toolchain too; their warnings are not this repository's.
        "-Wconf:src=external/rules_scala[^/]*/.*:s",
        # Every other warning fails the build too. Later -Wconf rules win.
        "-Werror",
    ],
    # A BUILD dependency no source of the target uses fails its build: it
    # costs a rebuild whenever it changes. A jar needed only at run time is
    # a runtime_dep.
    unused_dependency_checker_mode = "error",
    use_argument_file_in_runner = True,
    visibility = ["//visibility:public"],
)

toolchain(
    name = "scala_toolchain",
    toolchain = ":scala_toolchain_impl",
    toolchain_type = "@rules_scala//scala:toolchain_type",
    visibility = ["//visibility:public"],
)

# Every warning scalac can give, each printed with its category and none
# fatal, and every BUILD dependency a target's sources do not use: for
# measuring what a stricter toolchain would refuse. Not registered; a build
# takes it with --extra_toolchains=//:scala_toolchain_all_warnings
# (docs/testing.md, "Build / test commands"), which recompiles every target.
scala_toolchain(
    name = "scala_toolchain_all_warnings_impl",
    dep_providers = SCALA_JARS,
    scalacopts = [
        "-deprecation",
        "-feature",
        "-unchecked",
        "-Xlint",
        "-Wdead-code",
        "-Wextra-implicit",
        "-Wnumeric-widen",
        "-Wvalue-discard",
        "-Wnonunit-statement",
        "-Wunused:_",
        "-Wtostring-interpolated",
        "-Wperformance",
        "-Wmultiarg-infix",
        "-Woctal-literal",
        "-Wconf:any:wv",
        "-Wconf:src=external/rules_scala[^/]*/.*:s",
        "-Xmaxwarns",
        "1000000",
    ],
    unused_dependency_checker_mode = "warn",
    use_argument_file_in_runner = True,
    visibility = ["//visibility:public"],
)

toolchain(
    name = "scala_toolchain_all_warnings",
    toolchain = ":scala_toolchain_all_warnings_impl",
    toolchain_type = "@rules_scala//scala:toolchain_type",
    visibility = ["//visibility:public"],
)
